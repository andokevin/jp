{
  "name": "jp",
  "private": true,
  "description": "JP — marketplace mode pour Madagascar",
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "verifier": "turbo run typecheck lint test && pnpm archi",
    "archi": "node scripts/check-architecture.mjs",
    "couverture": "node scripts/check-coverage.mjs",
    "format": "prettier --write .",
    "format:verifier": "prettier --check .",
    "issues:generer": "node scripts/gen-issues.mjs",
    "issues:publier": "node scripts/push-issues.mjs",
    "uml:generer": "node scripts/gen-xmi.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "@types/node": "^22.10.7",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "prettier": "^3.4.2",
    "turbo": "^2.3.3",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.21.0",
    "vitest": "^2.1.8"
  }
}
