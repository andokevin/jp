{
  "name": "jp",
  "private": true,
  "description": "JP — marketplace mode pour Madagascar",
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "verifier": "turbo run typecheck lint test && pnpm archi",
    "archi": "node scripts/check-architecture.mjs",
    "couverture": "node scripts/check-coverage.mjs",
    "format": "prettier --write .",
    "format:verifier": "prettier --check .",
    "issues:generer": "node scripts/gen-issues.mjs",
    "issues:publier": "node scripts/push-issues.mjs",
    "uml:generer": "node scripts/gen-xmi.mjs",
    "db:demarrer": "docker compose up -d --wait",
    "db:arreter": "docker compose down",
    "db:reset": "docker compose down -v && docker compose up -d --wait && prisma migrate deploy && pnpm db:role && pnpm db:seed",
    "db:role": "node scripts/db-role.mjs",
    "db:migrer": "prisma migrate dev",
    "db:seed": "tsx prisma/seed.mts",
    "db:studio": "prisma studio",
    "db:psql": "docker compose exec postgres psql -U postgres -d jp"
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "@testcontainers/postgresql": "^12.1.0",
    "@types/node": "^22.10.7",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "pg": "^8.23.0",
    "prettier": "^3.4.2",
    "prisma": "^7.9.1",
    "tsx": "^4.23.12",
    "turbo": "^2.3.3",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.21.0",
    "vitest": "^2.1.8"
  }
}
