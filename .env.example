# PROPRIÉTAIRE — joue les migrations, possède les tables.
# Utilisé uniquement par `prisma migrate` et l'administration.
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/jp?schema=public"

# RÔLE APPLICATIF RESTREINT — c'est avec CELUI-CI que l'API tourne.
#
# En PostgreSQL, le propriétaire d'une table contourne ses propres
# révocations, et un superutilisateur contourne tout. Une garantie
# « ajout seul » appliquée par une connexion propriétaire ne garantit
# rien : elle documente une intention, elle ne l'impose pas.
#
# Le rôle jp_app sera créé par la migration, à l'étape 2.
# Le mot de passe reel se met dans .env, jamais ici.
DATABASE_URL_APP="postgresql://jp_app:mot-de-passe-a-changer@localhost:5433/jp?schema=public"
# Redis — files BullMQ (S5) et temps reel (S6). JAMAIS autorite (D2).
REDIS_URL="redis://localhost:6380"
