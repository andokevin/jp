{
  "expo": {
    "name": "JP",
    "slug": "jp",
    "version": "0.0.1",
    "orientation": "portrait",
    "scheme": "jp",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "mg.jp.app"
    },
    "android": {
      "package": "mg.jp.app"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-status-bar",
      "expo-localization",
      "expo-system-ui"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
