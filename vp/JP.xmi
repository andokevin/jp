          <message xmi:type="uml:Message" xmi:id="msg_2060" name="[débit autorisé / code correct] crée l'utilisateur si l'adresse est inconnue" messageSort="synchCall" sendEvent="occ_2061" receiveEvent="occ_2062"/>
          <message xmi:type="uml:Message" xmi:id="msg_2063" name="[débit autorisé / code correct] crée la session (jeton long, R-C2)" messageSort="synchCall" sendEvent="occ_2064" receiveEvent="occ_2065"/>
          <message xmi:type="uml:Message" xmi:id="msg_2066" name="[débit autorisé / code correct] 200 {jeton, utilisateur, estNouveau}" messageSort="reply" sendEvent="occ_2067" receiveEvent="occ_2068"/>
          <message xmi:type="uml:Message" xmi:id="msg_2069" name="[débit autorisé / code correct] choix du prénom, puis le fil" messageSort="reply" sendEvent="occ_2070" receiveEvent="occ_2071"/>
