/// Facultatif sur l'article. En direct, la vendeuse essaie le vêtement devant
/// la caméra — l'image dit l'état mieux qu'un énuméré. Hors direct, l'acheteuse
/// n'a que la fiche : la règle « état requis » s'applique alors à la
/// publication, pas à la colonne.
enum ClothingCondition {
  new_with_tags
  excellent
  good
  fair

  @@map("clothing_condition")
}

enum VerificationStatus {
  unverified
  pending
  verified
  rejected

  @@map("verification_status")
}

/// **`cin_recto`, `cin_verso` et `selfie` forment le dossier attendu.**
/// `nif_stat` reste possible et n'est jamais exigé : beaucoup de vendeuses
/// réelles n'ont ni NIF ni carte statistique, et l'exiger fermerait la
/// plateforme à celles pour qui elle est faite.
enum IdentityDocumentType {
  cin_recto
  cin_verso
  selfie
  nif_stat

  @@map("identity_document_type")
}

enum UserStatus {
  active
  suspended
  deleted

  @@map("user_status")
}

/// Le type dit comment lire `parametre.valeur`, qui est toujours du texte.
/// `pour_mille` existe séparément d'`entier` parce que 25 y signifie 2,5 %
/// et qu'un affichage naïf tromperait le vendeur.
enum TypeParametre {
  entier
  texte
  booleen
  duree_s
  pour_mille

  @@map("type_parametre")
}

// ─────────────────────────────────────────────────────────────────────────
// User — R-C1, R-C15, RB6
// ─────────────────────────────────────────────────────────────────────────

model User {
  id String @id @default(uuid(7)) @db.Uuid

  /// L'identifiant du compte (R-C1). Unique, jamais réutilisable.
  email           String    @unique
  emailVerifiedAt DateTime? @map("email_verified_at") @db.Timestamptz(6)

  passwordHash String? @map("password_hash") // hashé jamais en clair

  /// Le téléphone n'est PLUS un identifiant : c'est un contact de
  /// livraison (R-C15). D'où le point d'interrogation — il peut être vide.
  phone           String?
  phoneVerifiedAt DateTime? @map("phone_verified_at") @db.Timestamptz(6)

  firstName String? @map("first_name")
  lastName  String? @map("last_name")
  photoUrl  String?  @map("photo_url")
  /// Français par défaut : c'est la language écrite courante à Madagascar.
  language  Language @default(fr)

  /// Oriente le fil de découverte. Jamais affiché publiquement, jamais
  /// obligatoire — une case imposée à l'inscription fait fuir.
  gender Gender? @map("gender")

  /// Requis pour publier une vidéo (RB6). Vide tant qu'on ne publie pas.
  birthDate DateTime? @map("birth_date") @db.Date

  /// **Empreinte Argon2id — jamais le mot de passe en clair** (R-C6).
  ///
  /// Nullable en base, et pourtant exigé à l'inscription : la colonne doit
  /// rester vide pour un compte ouvert par Google (`identite_externe`), qui
  /// n'a jamais choisi de mot de passe. `NOT NULL` rendrait cette voie
  /// impossible. La règle « tout compte a un mot de passe » se tient donc à
  /// l'inscription, pas dans le type de la colonne.
  passwordFingerprint String?   @map("password_fingerprint")
  passwordUpdatedAt   DateTime? @map("password_updated_at") @db.Timestamptz(6)

  status         UserStatus @default(active)
  publicRankings Boolean    @default(true) @map("public_rankings")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  /// `@default(now())` s'ajoute à `@updatedAt` : le second est tenu par le
  /// client Prisma, le premier par la base. Sans lui, un INSERT écrit à la main
  /// depuis psql échoue sur une colonne NOT NULL sans valeur par défaut.
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  buyerProfile            BuyerProfile?
  boutique                Boutique?
  paniers                 Panier[]
  questionsPosees         QuestionArticle[]
  alertesStock            AlerteStock[]
  abonnementsSuivis       Abonnement[]             @relation("suiveur")
  abonnes                 Abonnement[]             @relation("suivi")
  messagesDirect          MessageDirect[]
  evenementsPossedes      Evenement[]              @relation("proprietaire_evenement")
  participations          EvenementParticipation[] @relation("participant")
  participationsDecidees  EvenementParticipation[] @relation("decideur_participation")
  rappelsEvenement        EvenementRappel[]
  reservations            Reservation[]
  commandes               Commande[]               @relation("acheteur")
  commandesGenerees       Commande[]               @relation("createur_attribue")
  promotionsNominatives   PromotionBeneficiaire[]
  evenementsLivraison     EvenementLivraison[]
  contenus                Contenu[]
  interactions            Interaction[]
  signalementsCommande    SignalementCommande[]    @relation("ouvreur_signalement")
  messagesLitige          MessageLitige[]
  avisEcrits              Avis[]
  signalementsEmis        Signalement[]            @relation("signaleur")
  signalementsAffectes    Signalement[]            @relation("affecte_signalement")
  signalementsTraites     Signalement[]            @relation("traiteur_signalement")
  sanctionsSubies         Sanction[]               @relation("sanctionne")
  sanctionsAppliquees     Sanction[]               @relation("applicateur_sanction")
  blocagesEmis            Blocage[]                @relation("bloqueur")
  blocagesSubis           Blocage[]                @relation("bloque")
  motsBloques             MotBloquePersonnel[]
  clicsAffiliation        ClicAffiliation[]
  rangsClient             RangClient[]
  notesClient             NoteClient[]
  ventesConfirmees        VenteConfirmeeJournal[]
  cagnotte                Cagnotte?
  mouvementsCagnotte      MouvementCagnotte[]
  piecesDressing          PieceDressing[]
  looks                   Look[]
  paniersCadeauComposes   PanierCadeau[]           @relation("compositrice")
  notifications           Notification[]
  compteursNotification   NotificationCompteur[]
  preferencesNotification PreferenceNotification[]
  adhesionClub            AdhesionClub?
  liensPartage            LienPartage[]
  documentsIdentite       DocumentIdentite[]
  identitesExternes       IdentiteExterne[]
  creatorProfile          CreatorProfile?
  membresEquipe           MembreEquipe[]
  adresses                Adresse[]
  demandesVerification    DemandeVerification[]    @relation("demandeur")
  verificationsDecidees   DemandeVerification[]    @relation("decideur_verification")
  recuperationsCiblees    DemandeRecuperation[]    @relation("cible_recuperation")
  recuperationsDecidees   DemandeRecuperation[]    @relation("decideur_recuperation")
  demandesChangementEmail DemandeChangementEmail[]
  sessions                Session[]
  journauxAudit           JournalAudit[]
  parametresModifies      Parametre[]
  modificationsProposees  ParametreModification[]  @relation("propose")
  modificationsConfirmees ParametreModification[]  @relation("confirme")

  @@map("app_user")
}

/// Ce qui personnalise le fil. **Tout y est facultatif** — la table entière
/// peut ne pas exister pour un compte.
///
/// Sauter la question à l'inscription et répondre « aucune préférence » sont
/// deux faits différents : le premier ne crée pas de ligne, le second crée une
/// ligne au tableau vide.
model BuyerProfile {
  /// La clé primaire EST la clé étrangère : un compte, au plus un profil.
  /// La contrainte est structurelle — aucune ligne de code ne peut la violer.
  ///
  /// `Restrict` et non `Cascade` : on ne supprime jamais un compte
  /// physiquement, donc la cascade ne se déclencherait jamais. `Restrict`
  /// transforme un `DELETE` accidentel en erreur bruyante plutôt qu'en
  /// effacement silencieux.
  user   User   @relation(fields: [userId], references: [id], onDelete: Restrict)
  userId String @id @map("utilisateur_id") @db.Uuid

  /// Les types de vêtements préférés — `robe`, `jean`, `jupe`… Trois au plus,
  /// borné par un CHECK écrit à la main dans la migration.
  ///
  /// Du texte et non un énuméré : cette liste est une **taxonomie**, dont la
  /// place définitive est la table `categorie`. Figer un énuméré maintenant
  /// imposerait une migration à chaque catégorie ajoutée.
  clothingPreferences String[] @default([]) @map("clothing_preferences")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("buyer_profile")
}

// ─────────────────────────────────────────────────────────────────────────
// Boutique et pièces d'identité — DP-01, DP-07
// ─────────────────────────────────────────────────────────────────────────

/// La boutique. **C'est la table qui décide si un article peut être mis en
/// vente** — `statutVerification` en est le verrou (`DP-07`).
///
/// **Pas de `typeBoutique`** : il distinguait `boutique` de `particulier`, et
/// le vendeur particulier n'existe plus (`DP-01`). Un attribut supprimé est
/// plus sûr qu'un attribut dont une seule valeur reste utilisée.
model Boutique {
  id String @id @default(uuid(7)) @db.Uuid

  /// `@unique` : un compte, au plus une boutique (`DP-02`).
  user   User   @relation(fields: [userId], references: [id], onDelete: Restrict)
  userId String @unique @map("utilisateur_id") @db.Uuid

  nom  String
  /// Dans les URL publiques. Ne change pas sans redirection.
  slug String @unique

  /// **Le logo.** Facultatif : une boutique ouvre avant d'avoir une image, et
  /// bloquer l'ouverture sur un fichier manquant coûterait des vendeuses.
  /// L'affichage retombe sur l'initiale du nom.
  logoUrl String? @map("logo_url")

  statutVerification VerificationStatus @default(unverified) @map("statut_verification")

  /// Le numéro vérifié — **seule destination possible d'un crédit** (`DP-16`).
  msisdnMobileMoney String? @map("msisdn_mobile_money")

  /// La boutique accepte-t-elle les créatrices ? (R-N3)
  affiliationAutorisee   Boolean @default(false) @map("affiliation_autorisee")
  /// Le taux offert aux créatrices, **sur son prix** (`DP-09`, R-N4). Connu de
  /// la créatrice AVANT qu'elle attache l'article.
  tauxCommissionCreateur Int     @default(0) @map("taux_commission_createur")

  /// Gel automatique au-delà du seuil de signalements (R-T8). *(Anciennement
  /// `encaissement_gele` — il n'y a plus d'encaissement à geler, `DP-07`.)*
  venteGelee Boolean @default(false) @map("vente_gelee")

  /// **Dénormalisés**, remis à zéro au cycle. Portent les quotas de R-B4.
  ventesDuMois  Int @default(0) @map("ventes_du_mois")
  directsDuMois Int @default(0) @map("directs_du_mois")

  /// Public, calculé sur des faits. **Devenue la seule protection de
  /// l'acheteuse** (`DP-07`) — il n'y a plus ni séquestre ni arbitre.
  scoreConfiance       Decimal @default(0) @map("score_confiance") @db.Decimal(4, 2)
  tauxSignalement      Decimal @default(0) @map("taux_signalement") @db.Decimal(5, 4)
  /// **Dénormalisé**, tâche quotidienne — affiché AVANT achat (F5.9).
  delaiExpeditionMoyen Int?    @map("delai_expedition_moyen")
  /// **Dénormalisé** — abonnés au sens social, pas l'abonnement payant.
  nbAbonnes            Int     @default(0) @map("nb_abonnes")
  fideliteActivee      Boolean @default(false) @map("fidelite_activee")

  /// Suppression douce. `NULL` = vivante. Aucun `DELETE` n'est jamais émis :
  /// une boutique supprimée garde ses commandes, ses avis et ses litiges.
  supprimeeLe DateTime? @map("supprimee_le") @db.Timestamptz(6)

  creeLe DateTime @default(now()) @map("cree_le") @db.Timestamptz(6)
  majLe  DateTime @default(now()) @updatedAt @map("maj_le") @db.Timestamptz(6)

  articles         Article[]
  extraits         ExtraitBoutique[]
  membres          MembreEquipe[]
  directs          Direct[]
  paliers          PalierFidelite[]
  promotions       Promotion[]
  lignesVendues    LigneCommande[]
  tarifs           TarifLivraison[]
  expeditions      Expedition[]
  avis             Avis[]
  score            ScoreConfiance?
  rangsClient      RangClient[]
  notesClient      NoteClient[]
  ventesConfirmees VenteConfirmeeJournal[]
  abonnements      AbonnementBoutique[]
  misesEnAvant     MiseEnAvant[]
  agregats         AgregatBoutique[]

  @@index([statutVerification])
  @@map("boutique")
}

/// Les pièces du dossier de vérification.
///
/// `urlChiffree` est **chiffrée au repos** (R-V5) : ce sont des pièces
/// d'identité, et une fuite de cette table serait une fuite d'identités, pas
/// un incident technique.
model DocumentIdentite {
  id String @id @default(uuid(7)) @db.Uuid

  user   User   @relation(fields: [userId], references: [id], onDelete: Restrict)
  userId String @map("utilisateur_id") @db.Uuid

  type        IdentityDocumentType
  urlChiffree String               @map("url_chiffree")
  /// Empreinte SHA-256 du fichier : détecte le même document redéposé sous
  /// deux comptes.
  empreinte   String

  creeLe DateTime @default(now()) @map("cree_le") @db.Timestamptz(6)

  /// Une pièce de chaque type par personne. Redéposer remplace la ligne au
  /// lieu d'en empiler une seconde.
  @@unique([userId, type])
  @@map("document_identite")
}

// ─────────────────────────────────────────────────────────────────────────
// Paramètres — R-O1
// ─────────────────────────────────────────────────────────────────────────

/// Tous les réglages économiques : durée de réservation, taux de commission,
/// délais, plafonds. Modifiables sans déploiement — sinon aucun essai n'a
/// lieu pendant le pilote.
model Parametre {
  cle         String        @id
  valeur      String
  type        TypeParametre
  description String

  modifiePar   User?    @relation(fields: [modifieParId], references: [id], onDelete: SetNull)
  modifieParId String?  @map("modifie_par_id") @db.Uuid
  modifieLe    DateTime @default(now()) @map("modifie_le") @db.Timestamptz(6)

  modifications ParametreModification[]

  @@map("parametre")
}

/// Double validation : proposé par l'un, confirmé par l'autre.
/// Personne ne change seul un taux de commission.
model ParametreModification {
  id  String @id @default(uuid(7)) @db.Uuid
  cle String

  parametre      Parametre @relation(fields: [cle], references: [cle], onDelete: Cascade)
  ancienneValeur String    @map("ancienne_valeur")
  nouvelleValeur String    @map("nouvelle_valeur")
  motif          String

  proposePar   User     @relation("propose", fields: [proposeParId], references: [id])
  proposeParId String   @map("propose_par_id") @db.Uuid
  proposeLe    DateTime @default(now()) @map("propose_le") @db.Timestamptz(6)

  /// `Restrict` et non `SetNull` : on n'efface pas la trace de qui a validé un
  /// changement de taux de commission. Un compte se ferme par
  /// `statut = supprime`, jamais par DELETE.
  confirmePar   User?     @relation("confirme", fields: [confirmeParId], references: [id], onDelete: Restrict)
  confirmeParId String?   @map("confirme_par_id") @db.Uuid
  confirmeLe    DateTime? @map("confirme_le") @db.Timestamptz(6)

  @@index([cle, proposeLe])
  @@map("parametre_modification")
}

// ─────────────────────────────────────────────────────────────────────────
// Journal d'audit — D3, R-V5, N3.4
// ─────────────────────────────────────────────────────────────────────────

/// AJOUT SEUL. La garantie n'est pas ici — elle est dans la migration,
/// sous forme de REVOKE. Prisma ne sait pas l'exprimer.
model JournalAudit {
  id String @id @default(uuid(7)) @db.Uuid

  /// `Restrict` et non `SetNull` : voir l'explication sous ce bloc.
  acteur   User?   @relation(fields: [acteurId], references: [id], onDelete: Restrict)
  acteurId String? @map("acteur_id") @db.Uuid

  action    String
  cibleType String  @map("cible_type")
  cibleId   String? @map("cible_id")

  avant Json?
  apres Json?

  adresseIp  String?  @map("adresse_ip") @db.Inet
  horodatage DateTime @default(now()) @db.Timestamptz(6)

  @@index([cibleType, cibleId, horodatage])
  @@index([acteurId, horodatage])
  @@map("journal_audit")
}

// ─────────────────────────────────────────────────────────────────────────
// Plateforme — S3
// ─────────────────────────────────────────────────────────────────────────

/// Les clés d'idempotence — **RB10**.
///
/// Une écriture financière interrompue ne doit produire ni double
/// prélèvement, ni commande perdue. Le client fabrique une clé, la renvoie
/// s'il réessaie, et le serveur reconnaît le rejeu.
///
/// `empreinteRequete` garde contre le pire cas : la même clé réutilisée pour
/// une requête DIFFÉRENTE. Sans elle, un client bogué pourrait recevoir la
/// réponse d'une commande pour une autre.
model CleIdempotence {
  cle String @id

  userId           String? @map("utilisateur_id") @db.Uuid
  methode          String
  chemin           String
  /// Empreinte SHA-256 du corps de la requête.
  empreinteRequete String  @map("empreinte_requete")

  /// `NULL` tant que la requête est EN COURS. C'est ce qui permet de
  /// distinguer « rejeu d'une requête terminée » de « deux requêtes
  /// simultanées avec la même clé ».
  statut  Int?
  reponse Json?

  creeLe   DateTime @default(now()) @map("cree_le") @db.Timestamptz(6)
  expireLe DateTime @map("expire_le") @db.Timestamptz(6)

  @@index([expireLe])
  @@map("cle_idempotence")
}

/// Une session ouverte, sur un appareil.
///
/// Le jeton n'est **jamais** stocké en clair : seule son empreinte l'est. Une
/// fuite de la base ne donne donc pas de session utilisable.
///
/// `famille` porte la chaîne de rotation. Quand un jeton de rafraîchissement
/// déjà consommé réapparaît, c'est le signe d'un vol : on révoque **toute la
/// famille**, pas seulement le jeton présenté *(F0.2)*.
model Session {
  id String @id @default(uuid(7)) @db.Uuid

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String @map("utilisateur_id") @db.Uuid

  tokenHash String @unique @map("token_hash")
  family    String @db.Uuid

  device    String?
  ipAddress String? @map("ip_address") @db.Inet

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(6)

  @@index([userId, expiresAt])
  @@index([family])
  @@map("session")
}

// ─────────────────────────────────────────────────────────────────────────
// Les univers — JP Mode, JP Beauté, JP Tech
// ─────────────────────────────────────────────────────────────────────────

/// **Un univers n'est pas un filtre de catégorie, c'est un jeu de règles.**
///
/// Entre une robe et un téléphone, ce qui change n'est pas l'étagère : c'est la
/// fiche article, le mode de livraison, les motifs de litige recevables, le
/// taux de commission et la vérification exigée du vendeur.
///
/// Les règles vivent dans `packages/contracts/src/univers.ts` — le code, pas la
/// base. Cette table porte ce qui doit être **modifiable sans déploiement**
/// pendant le pilote : l'ouverture et le taux de commission.
///
/// **Trois univers, et pas d'autre.** Mode et Beauté ouverts, Tech déclaré avec
/// `ouvert = false`. C'est délibéré : l'abstraction est construite maintenant,
/// l'ouverture est un `UPDATE`.
///
/// Les trois partagent la même livraison — point relais et domicile. C'est ce
/// qui rend l'application identique dans les trois : ce qui varie n'est pas le
/// parcours, ce sont trois listes.
model Universe {
  /// Ne change JAMAIS : il est dans les URL et les lignes de commande.
  key String @id

  name      String
  signature String
  tab       String

  /// Un univers fermé garde ses règles et n'apparaît nulle part.
  isOpen Boolean @default(false) @map("is_open")

  /// En pour mille. 80 = 8 %. Modifiable sans déploiement — c'est le levier
  /// économique du pilote, et il diffère fortement d'un univers à l'autre.
  commissionPerMille Int @map("commission_per_mille")

  /// Ordre d'affichage des onglets.
  rank Int @default(0)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  articles Article[]

  @@index([isOpen, rank])
  @@map("universe")
}

// ─────────────────────────────────────────────────────────────────────────
// Catalogue — R-H4, F1.14, R-Y1
// ─────────────────────────────────────────────────────────────────────────

/// Ce qui est à vendre.
///
/// **Toutes les caractéristiques physiques sont facultatives en base.** En
/// direct, la vendeuse essaie le vêtement devant la caméra et l'image remplace
/// la fiche ; exiger les mesures fermerait le direct à celle qui ne les connaît
/// pas. L'exigence porte donc sur la **publication hors direct**, où
/// l'acheteuse n'a que la fiche pour décider — une règle applicative, pas un
/// `NOT NULL`.
model Article {
  id String @id @default(uuid(7)) @db.Uuid

  boutique   Boutique @relation(fields: [boutiqueId], references: [id], onDelete: Restrict)
  boutiqueId String   @map("boutique_id") @db.Uuid

  /// **Immuable** (R-Y1) : changer l'univers changerait les règles de litige et
  /// la commission APRÈS une commande.
  universe    Universe @relation(fields: [universeKey], references: [key], onDelete: Restrict)
  universeKey String   @map("universe_key")

  nom         String
  description String?

  /// **Entiers en Ariary, jamais de flottant** (D6).
  prixAriary      Int  @map("prix_ariary")
  prixBarreAriary Int? @map("prix_barre_ariary")

  statut    ArticleStatus @default(draft)
  typeVente SaleType      @default(stock) @map("type_vente")

  /// Un seul exemplaire (F1.14) : pas de sélecteur de quantité, une seule
  /// réservation possible. **Le moteur d'urgence naturel du direct** — et la
  /// rareté affichée doit être vraie (RB9).
  pieceUnique Boolean @default(false) @map("piece_unique")

  /// Facultatifs — voir le commentaire du modèle.
  etatVetement ClothingCondition? @map("etat_vetement")
  /// Épaules, poitrine, taille, longueur (R-H4). **Sans essayage, les mesures
  /// remplacent le fait de toucher le vêtement.**
  mesures      Json?
  /// Dénormalisé : sert le tri par pertinence, sans lire le JSON.
  aMesures     Boolean       @default(false) @map("a_mesures")

  category   Category? @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  categoryId String?   @map("category_id") @db.Uuid

  marque  String?
  matiere String?

  /// Les champs propres à l'univers — contenance et INCI pour Beauté, garantie
  /// et compatibilité pour Tech. Un `jsonb` plutôt que trente colonnes vides :
  /// la fiche varie par univers, la table non.
  attributs Json?

  /// JP Beauté. **Colonne ordinaire et non générée** : PostgreSQL sait la
  /// calculer, mais Prisma ne sait pas la déclarer, et une colonne ajoutée à la
  /// main ferait dériver le schéma à chaque migration suivante. Elle est donc
  /// tenue par l'application, et vérifiée **à la publication et à l'achat** —
  /// un article périme en stock (R-Y13).
  peremptionLe DateTime? @map("peremption_le") @db.Date

  epingle         Boolean @default(false)
  positionVitrine Int     @default(0) @map("position_vitrine")

  achatDirectActif Boolean @default(true) @map("achat_direct_actif")

  /// Suppression douce. Un article retiré reste lisible depuis les commandes
  /// passées : sans lui, une facture perdrait son libellé.
  supprimeLe DateTime? @map("supprime_le") @db.Timestamptz(6)

  creeLe DateTime @default(now()) @map("cree_le") @db.Timestamptz(6)
  majLe  DateTime @default(now()) @updatedAt @map("maj_le") @db.Timestamptz(6)

  variantes      Variant[]
  questions      QuestionArticle[]
  directs        DirectArticle[]
  contenus       ContenuArticle[]
  avis           Avis[]
  selections     SelectionArticle[]
  clics          ClicAffiliation[]
  precommande    Precommande?
  piecesDressing PieceDressing[]
  aLecranDans    Direct[]           @relation("article_a_lecran")

  @@index([boutiqueId, statut])
  @@index([peremptionLe])
  @@index([universeKey, statut])
  @@map("article")
}

/// La déclinaison vendable — c'est elle qui porte le stock, jamais l'article.
model Variant {
  id String @id @default(uuid(7)) @db.Uuid

  article   Article @relation(fields: [articleId], references: [id], onDelete: Restrict)
  articleId String  @map("article_id") @db.Uuid

  /// **`taille_unique` et non `NULL`.** La taille fait partie de la clé
  /// unique, et `NULL` n'est jamais égal à `NULL` en SQL : deux variantes sans
  /// taille passeraient toutes les deux la contrainte d'unicité et le stock se
  /// dédoublerait. « Non renseignée » est donc une valeur explicite.
  taille  String @default("taille_unique")
  couleur String @default("")

  sku String?

  /// **LA vérité** (D2). Aucune autre table ne dit ce qui reste.
  stockQuantity    Int @default(0) @map("stock_quantity")
  /// `CHECK (>= 0)` et `CHECK (<= stock_quantity)` — le dernier filet contre la
  /// survente, même en cas de bogue applicatif.
  reservedQuantity Int @default(0) @map("reserved_quantity")
  alertThreshold   Int @default(0) @map("alert_threshold")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  lignesPanier LignePanier[]

  mouvements     MouvementStock[]
  alertes        AlerteStock[]
  reservations   Reservation[]
  lignesCommande LigneCommande[]

  @@unique([articleId, taille, couleur])
  @@map("variant")
}

// ─────────────────────────────────────────────────────────────────────────
// Panier hors direct — D7 révisé
// ─────────────────────────────────────────────────────────────────────────

/// Le panier de la vente **hors direct**.
///
/// **Il ne détient AUCUNE vérité sur le stock.** `D7` interdisait une table
/// `panier` précisément pour ça : deux sources de vérité sur ce qui est
/// réservé, donc un risque de survente. L'interdit tient toujours — ce qui est
/// levé, c'est seulement l'idée que le panier ne pouvait pas exister du tout.
///
/// La règle : une ligne de panier est une **intention d'achat** qui ne tient
/// rien. Le stock n'est bloqué qu'au passage en caisse, par une `reservation`,
/// et c'est là seulement qu'un article peut manquer. En direct, rien ne change :
/// on réserve immédiatement, sans panier.
model Panier {
  id String @id @default(uuid(7)) @db.Uuid

  user   User   @relation(fields: [userId], references: [id], onDelete: Restrict)
  userId String @map("utilisateur_id") @db.Uuid

  statut StatutPanier @default(actif)

  creeLe DateTime @default(now()) @map("cree_le") @db.Timestamptz(6)
  majLe  DateTime @default(now()) @updatedAt @map("maj_le") @db.Timestamptz(6)

  lignes LignePanier[]

  @@index([userId, statut])
  @@map("panier")
}

/// Une intention d'achat. **Ne bloque rien.**
model LignePanier {
  id String @id @default(uuid(7)) @db.Uuid

  panier   Panier @relation(fields: [panierId], references: [id], onDelete: Restrict)
  panierId String @map("panier_id") @db.Uuid

  variant    Variant @relation(fields: [variantId], references: [id], onDelete: Restrict)
  variantId String   @map("variant_id") @db.Uuid

  quantite Int @default(1)

  ajouteLe DateTime @default(now()) @map("ajoute_le") @db.Timestamptz(6)

  /// Rajouter le même article augmente la quantité au lieu d'empiler une
  /// seconde ligne.
  @@unique([panierId, variantId])
  @@map("ligne_panier")
}

// ─────────────────────────────────────────────────────────────────────────
// Extraits et annonces avant le direct
// ─────────────────────────────────────────────────────────────────────────

/// La vidéo courte publiée avant un direct : montrer les articles, faire de la
/// publicité, annoncer une surprise.
///
/// Elle n'est **pas** rattachée à un direct : elle existe avant lui, et elle
/// survit s'il est annulé. Le lien vers `direct` viendra avec le domaine
/// Direct, en colonne facultative.
model ExtraitBoutique {
  id String @id @default(uuid(7)) @db.Uuid

  boutique   Boutique @relation(fields: [boutiqueId], references: [id], onDelete: Restrict)
  boutiqueId String   @map("boutique_id") @db.Uuid

  type    TypeExtrait @default(extrait)
  titre   String?
  legende String?

  videoUrl   String  @map("video_url")
  /// L'image fixe affichée avant lecture. Sur un réseau lent, c'est elle qu'on
  /// voit — souvent la seule chose qu'on verra.
  afficheUrl String? @map("affiche_url")
  dureeS     Int?    @map("duree_s")

  /// `NULL` = brouillon, jamais montré.
  /// Le direct annoncé, s'il y en a un. **Facultatif** : l'extrait existe
  /// avant lui, et il survit s'il est annulé.
  direct   Direct? @relation(fields: [directId], references: [id], onDelete: SetNull)
  directId String? @map("direct_id") @db.Uuid

  publieLe   DateTime? @map("publie_le") @db.Timestamptz(6)
  supprimeLe DateTime? @map("supprime_le") @db.Timestamptz(6)

  creeLe DateTime @default(now()) @map("cree_le") @db.Timestamptz(6)
  majLe  DateTime @default(now()) @updatedAt @map("maj_le") @db.Timestamptz(6)

  @@index([boutiqueId, publieLe])
  @@map("extrait_boutique")
}

// ─────────────────────────────────────────────────────────────────────────
// Identité — le reste du domaine (F0.1, F0.13, F0.4, F0.6)
// ─────────────────────────────────────────────────────────────────────────

/// Le code à 6 chiffres d'entrée. **S'ajoute au mot de passe, ne le remplace
/// plus.**
///
/// Pas de clé étrangère vers `utilisateur` : une demande de code est écrite
/// AVANT que le compte existe. C'est ce qui rend la réponse identique pour une
/// adresse connue et inconnue — sinon l'écran d'entrée devient un annuaire des
/// personnes inscrites (R-C9).
model OtpCode {
  id String @id @default(uuid(7)) @db.Uuid

  email    String
  /// **Haché** (R-C6). Une fuite de cette table ne doit pas être une fuite de
  /// comptes.
  codeHash String @map("code_hash")
  /// Compteur de saisie. **En base et non dans Redis** : il doit être
  /// transactionnel avec la vérification.
  attempts Int    @default(0)

  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(6)
  consumedAt DateTime? @map("consumed_at") @db.Timestamptz(6)
  ipAddress  String?   @map("ip_address") @db.Inet

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([email, expiresAt])
  @@map("otp_code")
}

/// Le rattachement à un compte Google (F0.13).
model IdentiteExterne {
  id String @id @default(uuid(7)) @db.Uuid

  user   User   @relation(fields: [userId], references: [id], onDelete: Restrict)
  userId String @map("utilisateur_id") @db.Uuid

  fournisseur  ExternalProvider
  /// L'identifiant **stable** du fournisseur (R-C12). Surtout pas l'adresse
  /// électronique : elle change, et le compte suivrait le mauvais sujet.
  sujetExterne String           @map("sujet_externe")
  emailVerifie Boolean          @default(false) @map("email_verifie")

  creeLe DateTime @default(now()) @map("cree_le") @db.Timestamptz(6)

  @@unique([fournisseur, sujetExterne])
  @@map("identite_externe")
}

/// La créatrice : audience, palier, ventes générées. **Vendre sans capital.**
model CreatorProfile {
  id String @id @default(uuid(7)) @db.Uuid

  user   User   @relation(fields: [userId], references: [id], onDelete: Restrict)
  userId String @unique @map("utilisateur_id") @db.Uuid

  publicName String @map("public_name")
  slug       String @unique
  reseaux    Json?

  verificationStatus VerificationStatus @default(unverified) @map("verification_status")
  palier             Int                @default(0)
  verifiedBadge      Boolean            @default(false) @map("verified_badge")

  /// **Dénormalisés.**
  followersCount      Int @default(0) @map("followers_count")
  generatedSalesCount Int @default(0) @map("generated_sales_count")

  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  selections   Selection[]
  clics        ClicAffiliation[]
  precommandes Precommande[]

  @@map("creator_profile")
}

/// Une boutique tenue à plusieurs mains.
model MembreEquipe {
  id String @id @default(uuid(7)) @db.Uuid

  boutique   Boutique @relation(fields: [boutiqueId], references: [id], onDelete: Restrict)
  boutiqueId String   @map("boutique_id") @db.Uuid

  user   User   @relation(fields: [userId], references: [id], onDelete: Restrict)
  userId String @map("utilisateur_id") @db.Uuid

  role TeamRole @default(fulfiller)

  creeLe DateTime @default(now()) @map("cree_le") @db.Timestamptz(6)

  @@unique([boutiqueId, userId])
  @@map("membre_equipe")
}

/// Le dossier de vérification d'une boutique — **le verrou de la mise en
/// vente** (`DP-07`).
model DemandeVerification {
  id String @id @default(uuid(7)) @db.Uuid

  demandeur   User   @relation("demandeur", fields: [demandeurId], references: [id], onDelete: Restrict)
  demandeurId String @map("demandeur_id") @db.Uuid

  statut        EtatDemande @default(en_attente)
  motifDecision String?     @map("motif_decision")

  /// `Restrict` : on n'efface pas la trace de qui a vérifié une identité.
  decidePar   User?     @relation("decideur_verification", fields: [decideParId], references: [id], onDelete: Restrict)
  decideParId String?   @map("decide_par_id") @db.Uuid
  decideLe    DateTime? @map("decide_le") @db.Timestamptz(6)

  creeLe DateTime @default(now()) @map("cree_le") @db.Timestamptz(6)

  @@index([statut, creeLe])
  @@map("demande_verification")
}

/// « J'ai perdu l'accès à mon adresse électronique. »
///
/// `numero` est **lisible et prononçable** : la personne le donne au support
/// par téléphone, souvent depuis un autre appareil que le sien.
model DemandeRecuperation {
  id     String @id @default(uuid(7)) @db.Uuid
  numero String @unique

  userTarget   User   @relation("cible_recuperation", fields: [userTargetId], references: [id], onDelete: Restrict)
  userTargetId String @map("utilisateur_cible_id") @db.Uuid

  emailAncien   String      @map("email_ancien")
  emailNouveau  String      @map("email_nouveau")
  statut        EtatDemande @default(en_attente)
  motifDecision String?     @map("motif_decision")

  decidePar   User?     @relation("decideur_recuperation", fields: [decideParId], references: [id], onDelete: Restrict)
  decideParId String?   @map("decide_par_id") @db.Uuid
  decideLe    DateTime? @map("decide_le") @db.Timestamptz(6)

  creeLe DateTime @default(now()) @map("cree_le") @db.Timestamptz(6)

  @@index([statut, creeLe])
  @@map("demande_recuperation")
}

/// Changer d'adresse en deux temps : l'ancienne confirme, puis la nouvelle.
/// Une seule étape suffirait à voler un compte dont la session est ouverte.
model DemandeChangementEmail {
  id String @id @default(uuid(7)) @db.Uuid

  user   User   @relation(fields: [userId], references: [id], onDelete: Restrict)
  userId String @map("utilisateur_id") @db.Uuid

  nouvelEmail String          @map("nouvel_email")
  etape       EmailChangeStep @default(old_verified)
  expireLe    DateTime        @map("expire_le") @db.Timestamptz(6)

  creeLe DateTime @default(now()) @map("cree_le") @db.Timestamptz(6)

  @@index([userId, expireLe])
  @@map("demande_changement_email")
}

/// Une adresse de livraison. **Pas de code postal** (R-L2) : il n'est pas
/// utilisé à Madagascar, et un champ obligatoire vide se remplit de « 000 ».
/// Ce sont `quartier` et `reperes` qui font arriver le colis.
model Adresse {
  id String @id @default(uuid(7)) @db.Uuid

  user   User   @relation(fields: [userId], references: [id], onDelete: Restrict)
  userId String @map("utilisateur_id") @db.Uuid

  libelle               String
  quartier              String
  reperes               String?
  /// Le téléphone du destinataire, qui n'est pas forcément le titulaire du
  /// compte (R-C15) — un foyer partage un numéro.
  telephoneDestinataire String? @map("telephone_destinataire")

  supprimeeLe DateTime? @map("supprimee_le") @db.Timestamptz(6)
  creeLe      DateTime  @default(now()) @map("cree_le") @db.Timestamptz(6)
  majLe       DateTime  @default(now()) @updatedAt @map("maj_le") @db.Timestamptz(6)

  commandes Commande[]

  @@index([userId])
  @@map("adresse")
}

// ─────────────────────────────────────────────────────────────────────────
// Catalogue — classement, traçabilité du stock, questions (F1.4, F1.1)
// ─────────────────────────────────────────────────────────────────────────

/// L'arborescence de classement. Récursive : une catégorie a un parent
/// facultatif, et le même modèle sert les trois univers.
model Category {
  id String @id @default(uuid(7)) @db.Uuid

  parent   Category?  @relation("arborescence", fields: [parentId], references: [id], onDelete: Restrict)
  parentId String?    @map("parent_id") @db.Uuid
  enfants  Category[] @relation("arborescence")

  nameFr   String @map("name_fr")
  nameEn   String @map("name_en")
  position Int    @default(0)

  articles Article[]

  @@index([parentId, position])
  @@map("category")
}

/// **Toute variation de `quantite_stock` produit un mouvement.** C'est la seule
/// façon d'expliquer un écart trois semaines plus tard — et sans elle, un stock
/// faux ne se distingue pas d'un stock volé.
model MouvementStock {
  id String @id @default(uuid(7)) @db.Uuid

  variant    Variant @relation(fields: [variantId], references: [id], onDelete: Restrict)
  variantId String   @map("variant_id") @db.Uuid

  type          StockMovementType
  /// Signé : négatif pour une vente, positif pour une entrée.
  quantiteDelta Int                @map("quantite_delta")
  reference     String?
  auteurId      String?            @map("auteur_id") @db.Uuid

  creeLe DateTime @default(now()) @map("cree_le") @db.Timestamptz(6)

  @@index([variantId, creeLe])
  @@map("mouvement_stock")
}

/// Les questions publiques sous une fiche. Publiques et non privées : la
/// réponse sert aussi aux suivantes.
model QuestionArticle {
  id String @id @default(uuid(7)) @db.Uuid

  article   Article @relation(fields: [articleId], references: [id], onDelete: Restrict)
  articleId String  @map("article_id") @db.Uuid

  auteur   User   @relation(fields: [auteurId], references: [id], onDelete: Restrict)
  auteurId String @map("auteur_id") @db.Uuid

  texte        String
  reponseTexte String?        @map("reponse_texte")
  statut       QuestionStatus @default(published)

  creeLe DateTime @default(now()) @map("cree_le") @db.Timestamptz(6)

  @@index([articleId, statut, creeLe])
  @@map("question_article")
}

/// « Prévenez-moi quand ça revient. » Clé primaire composite : une alerte par
/// personne et par variante, sans ligne en double possible.
model AlerteStock {
  variant    Variant @relation(fields: [variantId], references: [id], onDelete: Restrict)
  variantId String   @map("variant_id") @db.Uuid

  user   User   @relation(fields: [userId], references: [id], onDelete: Restrict)
  userId String @map("utilisateur_id") @db.Uuid

  notifieLe DateTime? @map("notifie_le") @db.Timestamptz(6)
  creeLe    DateTime  @default(now()) @map("cree_le") @db.Timestamptz(6)

  @@id([variantId, userId])
  @@map("alerte_stock")
}

// ─────────────────────────────────────────────────────────────────────────
// Couche sociale et direct (F7.1, F2.3)
// ─────────────────────────────────────────────────────────────────────────

/// Suivre une boutique ou une créatrice. Clé primaire composite : on ne peut
/// pas suivre deux fois la même personne, la base l'interdit.
model Abonnement {
  suiveur   User   @relation("suiveur", fields: [suiveurId], references: [id], onDelete: Restrict)
  suiveurId String @map("suiveur_id") @db.Uuid

  suivi   User   @relation("suivi", fields: [suiviId], references: [id], onDelete: Restrict)
  suiviId String @map("suivi_id") @db.Uuid

  type               TypeAbonnement
  /// Réglage **par boutique** et non global (R-Q6) : couper les promotions
  /// d'une boutique bavarde ne doit pas couper celles des autres.
  notificationsPromo Boolean        @default(true) @map("notifications_promo")

  creeLe DateTime @default(now()) @map("cree_le") @db.Timestamptz(6)

  @@id([suiveurId, suiviId])
  @@index([suiviId, creeLe])
  @@map("abonnement")
}

/// La diffusion en direct.
model Direct {
  id String @id @default(uuid(7)) @db.Uuid

  boutique   Boutique @relation(fields: [boutiqueId], references: [id], onDelete: Restrict)
  boutiqueId String   @map("boutique_id") @db.Uuid

  titre      String
  afficheUrl String?      @map("affiche_url")
  statut     StatutDirect @default(planifie)

  debutPrevuLe DateTime  @map("debut_prevu_le") @db.Timestamptz(6)
  debutLe      DateTime? @map("debut_le") @db.Timestamptz(6)
  finLe        DateTime? @map("fin_le") @db.Timestamptz(6)

  ingestRef         String? @map("ingest_ref")
  lectureUrl        String? @map("lecture_url")
  enregistrementUrl String? @map("enregistrement_url")

  /// L'article montré à l'instant. C'est lui qui pilote le « Je prends ».
  articleALecran   Article? @relation("article_a_lecran", fields: [articleALecranId], references: [id], onDelete: SetNull)
  articleALecranId String?  @map("article_a_lecran_id") @db.Uuid

  nbSpectateursPic    Int     @default(0) @map("nb_spectateurs_pic")
  rediffusionFacebook Boolean @default(false) @map("rediffusion_facebook")

  creeLe DateTime @default(now()) @map("cree_le") @db.Timestamptz(6)
  majLe  DateTime @default(now()) @updatedAt @map("maj_le") @db.Timestamptz(6)

  articles     DirectArticle[]
  messages     MessageDirect[]
  reservations Reservation[]
  commandes    Commande[]
  bilan        DirectBilan?
  extraits     ExtraitBoutique[]

  @@index([boutiqueId, debutPrevuLe])
  @@index([statut, debutPrevuLe])
  @@map("direct")
}

/// Les articles préparés pour un direct.
model DirectArticle {
  direct   Direct @relation(fields: [directId], references: [id], onDelete: Restrict)
  directId String @map("direct_id") @db.Uuid

  article   Article @relation(fields: [articleId], references: [id], onDelete: Restrict)
  articleId String  @map("article_id") @db.Uuid

  position  Int       @default(0)
  /// **Rend le replay achetable gratuit** (F2.16) : les marqueurs à la minute
  /// sont produits par l'usage, sans aucune saisie manuelle.
  aLecranLe DateTime? @map("a_lecran_le") @db.Timestamptz(6)

  @@id([directId, articleId])
  @@map("direct_article")
}

model MessageDirect {
  id String @id @default(uuid(7)) @db.Uuid

  direct   Direct @relation(fields: [directId], references: [id], onDelete: Restrict)
  directId String @map("direct_id") @db.Uuid

  auteur   User   @relation(fields: [auteurId], references: [id], onDelete: Restrict)
  auteurId String @map("auteur_id") @db.Uuid

  texte       String
  statut      StatutMessage @default(publie)
  epingle     Boolean       @default(false)
  /// Message posté par le système — « il reste 2 pièces » (F12.2).
  automatique Boolean       @default(false)

  creeLe DateTime @default(now()) @map("cree_le") @db.Timestamptz(6)

  @@index([directId, creeLe])
  @@map("message_direct")
}

/// Le bilan d'un direct. `articlesSansVente` est le signal le plus utile :
/// un article montré et jamais pris est presque toujours un prix trop haut.
model DirectBilan {
  direct   Direct @relation(fields: [directId], references: [id], onDelete: Restrict)
  directId String @id @map("direct_id") @db.Uuid

  dureeS             Int     @default(0) @map("duree_s")
  spectateursUniques Int     @default(0) @map("spectateurs_uniques")
  picAudience        Int     @default(0) @map("pic_audience")
  nbVendus           Int     @default(0) @map("nb_vendus")
  ca                 Int     @default(0)
  tauxConversion     Decimal @default(0) @map("taux_conversion") @db.Decimal(5, 4)
  nbExpirees         Int     @default(0) @map("nb_expirees")
  articlesSansVente  Json?   @map("articles_sans_vente")

  creeLe DateTime @default(now()) @map("cree_le") @db.Timestamptz(6)

  @@map("direct_bilan")
}

// ─────────────────────────────────────────────────────────────────────────
// Événements (F20.1)
// ─────────────────────────────────────────────────────────────────────────

model Evenement {
  id String @id @default(uuid(7)) @db.Uuid

  portee         PorteeEvenement @default(boutique)
  /// `NULL` quand la portée est `jp` : l'événement appartient à la plateforme.
  proprietaire   User?           @relation("proprietaire_evenement", fields: [proprietaireId], references: [id], onDelete: Restrict)
  proprietaireId String?         @map("proprietaire_id") @db.Uuid

  nom           String
  theme         String?
  slug          String  @unique
  visuelUrl     String? @map("visuel_url")
  couleurAccent String? @map("couleur_accent")
  hashtag       String?

  debutLe DateTime @map("debut_le") @db.Timestamptz(6)
  finLe   DateTime @map("fin_le") @db.Timestamptz(6)

  statut               StatutEvenement @default(brouillon)
  candidaturesOuvertes Boolean         @default(false) @map("candidatures_ouvertes")

  creeLe DateTime @default(now()) @map("cree_le") @db.Timestamptz(6)
  majLe  DateTime @default(now()) @updatedAt @map("maj_le") @db.Timestamptz(6)

  participations EvenementParticipation[]
  elements       EvenementElement[]
  commandes      Commande[]
  rappels        EvenementRappel[]
  bilans         EvenementBilan[]
  promotions     Promotion[]

  @@index([statut, debutLe])
  @@map("evenement")
}

model EvenementParticipation {
  id String @id @default(uuid(7)) @db.Uuid

  evenement   Evenement @relation(fields: [evenementId], references: [id], onDelete: Restrict)
  evenementId String    @map("evenement_id") @db.Uuid

  participant   User   @relation("participant", fields: [participantId], references: [id], onDelete: Restrict)
  participantId String @map("participant_id") @db.Uuid

  role       RoleParticipation
  statut     StatutParticipation @default(candidate)
  /// Un refus sans motif est un défaut, pas une simplification.
  motifRefus String?             @map("motif_refus")

  decidePar   User?   @relation("decideur_participation", fields: [decideParId], references: [id], onDelete: Restrict)
  decideParId String? @map("decide_par_id") @db.Uuid

  creeLe DateTime @default(now()) @map("cree_le") @db.Timestamptz(6)

  elements EvenementElement[]

  @@unique([evenementId, participantId])
  @@map("evenement_participation")
}

/// Ce qu'un participant expose dans un événement — un article, une promotion,
/// un contenu ou un direct.
///
/// **Polymorphe, et c'est assumé** : quatre types de cibles pour une même page.
/// L'intégrité référentielle est applicative. L'alternative — quatre tables de
/// liaison — donnerait l'intégrité en base mais quatre requêtes pour composer
/// la page, sur un réseau lent.
model EvenementElement {
  evenement   Evenement @relation(fields: [evenementId], references: [id], onDelete: Restrict)
  evenementId String    @map("evenement_id") @db.Uuid

  cibleType String @map("cible_type")
  cibleId   String @map("cible_id") @db.Uuid

  participation   EvenementParticipation? @relation(fields: [participationId], references: [id], onDelete: SetNull)
  participationId String?                 @map("participation_id") @db.Uuid

  position Int @default(0)

  @@id([evenementId, cibleType, cibleId])
  @@index([cibleType, cibleId])
  @@map("evenement_element")
}

/// « Prévenez-moi. » Le compteur porte le plafond de 3 notifications (R-W9) :
/// au-delà, le rappel devient du harcèlement et on perd la personne.
model EvenementRappel {
  evenement   Evenement @relation(fields: [evenementId], references: [id], onDelete: Restrict)
  evenementId String    @map("evenement_id") @db.Uuid

  user   User   @relation(fields: [userId], references: [id], onDelete: Restrict)
  userId String @map("utilisateur_id") @db.Uuid

  notificationsEnvoyees Int @default(0) @map("notifications_envoyees")

  @@id([evenementId, userId])
  @@map("evenement_rappel")
}

/// `participantId` à `NULL` = le bilan global de l'événement.
model EvenementBilan {
  id String @id @default(uuid(7)) @db.Uuid

  evenement   Evenement @relation(fields: [evenementId], references: [id], onDelete: Restrict)
  evenementId String    @map("evenement_id") @db.Uuid

  participantId String? @map("participant_id") @db.Uuid

  nbArticlesVendus  Int @default(0) @map("nb_articles_vendus")
  caAriary          Int @default(0) @map("ca_ariary")
  /// La période équivalente hors événement. Sans elle, un chiffre d'affaires
  /// ne dit pas si l'événement a servi à quelque chose.
  caReferenceAriary Int @default(0) @map("ca_reference_ariary")
  nouveauxAbonnes   Int @default(0) @map("nouveaux_abonnes")
  traficPage        Int @default(0) @map("trafic_page")

  calculeLe DateTime @default(now()) @map("calcule_le") @db.Timestamptz(6)

  @@unique([evenementId, participantId])
  @@map("evenement_bilan")
}

// ─────────────────────────────────────────────────────────────────────────
// Fidélité — les paliers, et les promotions (F7.6, F7.22)
// ─────────────────────────────────────────────────────────────────────────

model PalierFidelite {
  id String @id @default(uuid(7)) @db.Uuid

  boutique   Boutique @relation(fields: [boutiqueId], references: [id], onDelete: Restrict)
  boutiqueId String   @map("boutique_id") @db.Uuid

  nom       String
  rangOrdre Int    @map("rang_ordre")

  seuilMontant   Int @default(0) @map("seuil_montant")
  seuilCommandes Int @default(0) @map("seuil_commandes")

  avantageTexte String? @map("avantage_texte")

  creeLe DateTime @default(now()) @map("cree_le") @db.Timestamptz(6)

  promotionsReservees Promotion[]  @relation("palier_min")
  rangsClient         RangClient[]

  @@unique([boutiqueId, rangOrdre])
  @@map("palier_fidelite")
}

model Promotion {
  id String @id @default(uuid(7)) @db.Uuid

  boutique   Boutique @relation(fields: [boutiqueId], references: [id], onDelete: Restrict)
  boutiqueId String   @map("boutique_id") @db.Uuid

  evenement   Evenement? @relation(fields: [evenementId], references: [id], onDelete: SetNull)
  evenementId String?    @map("evenement_id") @db.Uuid

  type   TypePromotion
  /// `CHECK > 0`. Une remise de zéro n'est pas une remise.
  valeur Int

  perimetre   PerimetrePromotion @default(boutique)
  categoryId  String?            @map("category_id") @db.Uuid

  cible       CiblePromotion  @default(tous)
  palierMin   PalierFidelite? @relation("palier_min", fields: [palierMinId], references: [id], onDelete: SetNull)
  palierMinId String?         @map("palier_min_id") @db.Uuid

  code String? @unique

  plafondUtilisation Int? @map("plafond_utilisation")
  utilisations       Int  @default(0)

  debutLe DateTime @map("debut_le") @db.Timestamptz(6)
  finLe   DateTime @map("fin_le") @db.Timestamptz(6)

  statut          StatutPromotion @default(brouillon)
  notifierAbonnes Boolean         @default(false) @map("notifier_abonnes")
  /// **Un verrou d'idempotence, pas une donnée d'affichage** (R-U3). Après un
  /// incident du planificateur, la promotion démarre en retard mais **ne
  /// renotifie jamais**.
  notifieeLe      DateTime?       @map("notifiee_le") @db.Timestamptz(6)

  creeLe DateTime @default(now()) @map("cree_le") @db.Timestamptz(6)
  majLe  DateTime @default(now()) @updatedAt @map("maj_le") @db.Timestamptz(6)

  articles       PromotionArticle[]
  beneficiaires  PromotionBeneficiaire[]
  lignesRemisees LigneCommande[]

  @@index([boutiqueId, statut, debutLe])
  @@map("promotion")
}

model PromotionArticle {
  promotion   Promotion @relation(fields: [promotionId], references: [id], onDelete: Restrict)
  promotionId String    @map("promotion_id") @db.Uuid

  articleId String @map("article_id") @db.Uuid

  @@id([promotionId, articleId])
  @@map("promotion_article")
}

// ─────────────────────────────────────────────────────────────────────────
// Réservation — la table la plus sensible du schéma (RB1)
// ─────────────────────────────────────────────────────────────────────────

/// Tenir un article pendant que l'acheteuse paie.
///
/// **Trois éléments la protègent** : le verrou `FOR UPDATE` sur `variante` dans
/// la transaction, les `CHECK` de `variante`, et l'index partiel qui rend
/// l'expiration bon marché — sans lui, la tâche d'expiration balaierait toute
/// la table toutes les minutes.
model Reservation {
  id String @id @default(uuid(7)) @db.Uuid

  variant    Variant @relation(fields: [variantId], references: [id], onDelete: Restrict)
  variantId String   @map("variant_id") @db.Uuid

  /// `NULL` pour une session invitée : on peut réserver avant d'avoir un
  /// compte, sinon la création de compte s'intercale au pire moment.
  user             User?   @relation(fields: [userId], references: [id], onDelete: Restrict)
  userId           String? @map("utilisateur_id") @db.Uuid
  sessionInviteeId String? @map("session_invitee_id") @db.Uuid

  quantite Int @default(1)

  statut  ReservationStatus @default(active)
  origine SaleOrigin        @default(catalogue)

  direct   Direct? @relation(fields: [directId], references: [id], onDelete: SetNull)
  directId String? @map("direct_id") @db.Uuid

  /// Le rang dans la file d'attente (R-S7). Quand une réservation expire, c'est
  /// le suivant qui est prévenu — pas tout le monde en même temps.
  rang Int @default(0)

  expireLe       DateTime  @map("expire_le") @db.Timestamptz(6)
  /// Suspension pendant un incident réseau (R-S5) : le temps ne court plus.
  suspenduDepuis DateTime? @map("suspendu_depuis") @db.Timestamptz(6)

  creeLe DateTime @default(now()) @map("cree_le") @db.Timestamptz(6)
  majLe  DateTime @default(now()) @updatedAt @map("maj_le") @db.Timestamptz(6)

  @@index([variantId, statut])
  @@index([userId, statut])
  @@map("reservation")
}

// ─────────────────────────────────────────────────────────────────────────
// Livraison — zones et tarifs (F3.3). JP n'opère rien (DP-04)
// ─────────────────────────────────────────────────────────────────────────

model ZoneLivraison {
  id String @id @default(uuid(7)) @db.Uuid

  nom             String
  quartiers       Json
  delaiTransportJ Int    @default(1) @map("delai_transport_j")

  creeLe DateTime @default(now()) @map("cree_le") @db.Timestamptz(6)

  tarifs TarifLivraison[]

  @@map("zone_livraison")
}

/// **Le tarif est fixé par la boutique** (`DP-04`), pas par JP. Clé primaire
/// composite : un tarif par boutique et par zone, sans doublon possible.
model TarifLivraison {
  boutique   Boutique @relation(fields: [boutiqueId], references: [id], onDelete: Restrict)
  boutiqueId String   @map("boutique_id") @db.Uuid

  zone   ZoneLivraison @relation(fields: [zoneId], references: [id], onDelete: Restrict)
  zoneId String        @map("zone_id") @db.Uuid

  montant Int

  majLe DateTime @default(now()) @updatedAt @map("maj_le") @db.Timestamptz(6)

  @@id([boutiqueId, zoneId])
  @@map("tarif_livraison")
}

// ─────────────────────────────────────────────────────────────────────────
// Commande — l'engagement écrit, figé (F3.7)
// ─────────────────────────────────────────────────────────────────────────

/// **Tout y est figé.** Prix, taux de commission, part créatrice, code promo :
/// recopiés à la création, jamais relus depuis leur source. Un changement de
/// tarif ne réécrit pas une facture émise.
model Commande {
  id     String @id @default(uuid(7)) @db.Uuid
  /// Lisible et prononçable : on le donne au téléphone.
  numero String @unique

  acheteur   User   @relation("acheteur", fields: [acheteurId], references: [id], onDelete: Restrict)
  acheteurId String @map("acheteur_id") @db.Uuid

  /// L'attribution d'affiliation (R-N1), figée elle aussi.
  createur   User?   @relation("createur_attribue", fields: [createurId], references: [id], onDelete: Restrict)
  createurId String? @map("createur_id") @db.Uuid

  evenement   Evenement? @relation(fields: [evenementId], references: [id], onDelete: SetNull)
  evenementId String?    @map("evenement_id") @db.Uuid

  direct   Direct? @relation(fields: [directId], references: [id], onDelete: SetNull)
  directId String? @map("direct_id") @db.Uuid

  /// La commande cadeau (RB8). **Une référence, pas une clé étrangère** : le
  /// donateur ne doit jamais pouvoir remonter à l'adresse de livraison.
  donateurRef String? @map("donateur_ref")

  statut  StatutCommande @default(brouillon)
  /// **Une file de commandes unique** (R-H2) : deux files signifieraient deux
  /// logistiques, et la boutique en oublierait une.
  origine SaleOrigin     @default(catalogue)

  /// Figé (R-Y3) : changer l'univers changerait les règles de litige et la
  /// commission après coup.
  universeKey String @map("universe_key")

  modeLivraison ModeLivraison @default(domicile) @map("mode_livraison")
  adresse       Adresse?      @relation(fields: [adresseId], references: [id], onDelete: Restrict)
  adresseId     String?       @map("adresse_id") @db.Uuid

  /// Figé à la commande (R-U9) : le code, pas la promotion. Si elle est
  /// modifiée demain, la commande garde ce qui a été promis aujourd'hui.
  codePromo String? @map("code_promo")

  /// **Entiers en Ariary** (D6).
  sousTotal             Int @map("sous_total")
  fraisLivraison        Int @default(0) @map("frais_livraison")
  remise                Int @default(0)
  remiseLivraison       Int @default(0) @map("remise_livraison")
  creditCagnotteUtilise Int @default(0) @map("credit_cagnotte_utilise")
  total                 Int

  noteAcheteur String? @map("note_acheteur")

  creeLe DateTime @default(now()) @map("cree_le") @db.Timestamptz(6)
  majLe  DateTime @default(now()) @updatedAt @map("maj_le") @db.Timestamptz(6)

  lignes              LigneCommande[]
  paiements           Paiement[]
  facture             Facture?
  expedition          Expedition?
  filRemise           FilRemise?
  promotionsUtilisees PromotionBeneficiaire[]
  signalements        SignalementCommande[]
  avis                Avis?
  contenusUnboxing    Contenu[]
  venteConfirmee      VenteConfirmeeJournal?
  engagements         PrecommandeEngagement[]
  piecesDressing      PieceDressing[]
  panierCadeau        PanierCadeau?

  @@index([acheteurId, creeLe])
  @@index([origine, creeLe])
  @@index([statut, creeLe])
  @@map("commande")
}

model LigneCommande {
  id String @id @default(uuid(7)) @db.Uuid

  commande   Commande @relation(fields: [commandeId], references: [id], onDelete: Restrict)
  commandeId String   @map("commande_id") @db.Uuid

  variant    Variant @relation(fields: [variantId], references: [id], onDelete: Restrict)
  variantId String   @map("variant_id") @db.Uuid

  boutique   Boutique @relation(fields: [boutiqueId], references: [id], onDelete: Restrict)
  boutiqueId String   @map("boutique_id") @db.Uuid

  quantite     Int
  /// **FIGÉ à la commande.**
  prixUnitaire Int @map("prix_unitaire")
  /// `CHECK <= prix_unitaire * quantite`.
  remiseLigne  Int @default(0) @map("remise_ligne")

  /// **SCALAIRE, et c'est la décision de modélisation la plus importante du
  /// domaine commercial** (D4, R-U7) : une ligne porte AU PLUS une promotion.
  /// Le cumul devient impossible par la forme de la table, pas par un contrôle
  /// que quelqu'un oubliera d'écrire.
  promotion   Promotion? @relation(fields: [promotionId], references: [id], onDelete: Restrict)
  promotionId String?    @map("promotion_id") @db.Uuid

  /// Figées à la commande (`DP-09`, R-G3, `DP-15`, R-B5).
  partCreateur            Int              @default(0) @map("part_createur")
  tauxCommissionPourMille Int              @default(0) @map("taux_commission_pour_mille")
  modeRemuneration        ModeRemuneration @default(commission) @map("mode_remuneration")

  creeLe DateTime @default(now()) @map("cree_le") @db.Timestamptz(6)

  @@index([commandeId])
  @@index([boutiqueId, creeLe])
  @@map("ligne_commande")
}

/// Le code nominatif à usage unique (R-U6).
model PromotionBeneficiaire {
  promotion   Promotion @relation(fields: [promotionId], references: [id], onDelete: Restrict)
  promotionId String    @map("promotion_id") @db.Uuid

  user   User   @relation(fields: [userId], references: [id], onDelete: Restrict)
  userId String @map("utilisateur_id") @db.Uuid

  codePersonnel String    @unique @map("code_personnel")
  utiliseLe     DateTime? @map("utilise_le") @db.Timestamptz(6)

  commande   Commande? @relation(fields: [commandeId], references: [id], onDelete: SetNull)
  commandeId String?   @map("commande_id") @db.Uuid

  @@id([promotionId, userId])
  @@map("promotion_beneficiaire")
}

// ─────────────────────────────────────────────────────────────────────────
// Paiement et argent — JP ne détient aucun fonds (DP-07, DP-16)
// ─────────────────────────────────────────────────────────────────────────

/// Un crédit vers un bénéficiaire. **1 à 3 par commande** (`DP-16`) : la
/// boutique, la commission JP, la créatrice.
///
/// L'acheteuse ne voit rien de cet éclatement — un débit, une confirmation.
model Paiement {
  id String @id @default(uuid(7)) @db.Uuid

  commande   Commande @relation(fields: [commandeId], references: [id], onDelete: Restrict)
  commandeId String   @map("commande_id") @db.Uuid

  rang RangPaiement @default(pivot)

  beneficiaireType BeneficiaireType @map("beneficiaire_type")
  beneficiaireId   String?          @map("beneficiaire_id") @db.Uuid

  /// **Figé, jamais saisissable** (`DP-16`). Le numéro vient de la boutique
  /// vérifiée ; le laisser saisir à la volée serait la faille la plus simple à
  /// exploiter de tout le produit.
  msisdnDestination String @map("msisdn_destination")

  moyen   MoyenPaiement
  /// `CHECK > 0`.
  montant Int
  statut  StatutPaiement @default(initie)

  referenceExterne String? @map("reference_externe")
  /// Porte RB10 : un rejeu renvoie le résultat initial sans nouveau
  /// prélèvement (R-M2).
  cleIdempotence   String  @unique @map("cle_idempotence")
  motifEchec       String? @map("motif_echec")

  nbRejeux        Int       @default(0) @map("nb_rejeux")
  prochainRejeuLe DateTime? @map("prochain_rejeu_le") @db.Timestamptz(6)

  /// La diaspora paie depuis l'étranger : on garde ce qu'elle a réellement vu.
  payerUserId          String?  @map("payeur_utilisateur_id") @db.Uuid
  payeurPays           String?  @map("payeur_pays")
  montantDeviseOrigine Int?     @map("montant_devise_origine")
  deviseOrigine        String?  @map("devise_origine")
  tauxIndicatif        Decimal? @map("taux_indicatif") @db.Decimal(12, 6)

  creeLe DateTime @default(now()) @map("cree_le") @db.Timestamptz(6)
  majLe  DateTime @default(now()) @updatedAt @map("maj_le") @db.Timestamptz(6)

  ecritures EcritureFinanciere[]

  @@index([commandeId, rang])
  @@map("paiement")
}

/// **Le cœur de la conformité** (C4). AJOUT SEUL, garanti par `REVOKE` dans la
/// migration — Prisma ne sait pas l'exprimer.
///
/// JP ne détient aucun fonds (`DP-07`) : ce journal ne tient pas un solde, il
/// trace un mouvement qui a eu lieu ailleurs. C'est ce qu'on fournit quand le
/// recours est externe.
model EcritureFinanciere {
  id String @id @default(uuid(7)) @db.Uuid

  paiement   Paiement? @relation(fields: [paiementId], references: [id], onDelete: Restrict)
  paiementId String?   @map("paiement_id") @db.Uuid

  type      String
  reference String?
  montant   Int
  sens      SensEcriture
  compte    CompteEcriture

  titulaireId String? @map("titulaire_id") @db.Uuid

  creeLe DateTime @default(now()) @map("cree_le") @db.Timestamptz(6)

  @@index([titulaireId, compte, creeLe])
  @@map("ecriture_financiere")
}

/// `emiseLe` est **inaltérable** (R-F1). La numérotation est continue : un trou
/// dans une série de factures est un problème comptable, pas un détail.
model Facture {
  id String @id @default(uuid(7)) @db.Uuid

  commande   Commande @relation(fields: [commandeId], references: [id], onDelete: Restrict)
  commandeId String   @unique @map("commande_id") @db.Uuid

  numero  String   @unique
  urlPdf  String?  @map("url_pdf")
  emiseLe DateTime @default(now()) @map("emise_le") @db.Timestamptz(6)

  @@map("facture")
}

// ─────────────────────────────────────────────────────────────────────────
// Expédition — ce que la boutique déclare (DP-04, R-L9)
// ─────────────────────────────────────────────────────────────────────────

/// ⚠️ **`EXPEDIEE` est une déclaration que personne ne vérifie** (R-L9). Aucun
/// tiers neutre ne constate la remise : ni preuve, ni arbitre (`DP-05`), ni
/// argent retenu (`DP-07`). C'est un invariant que ce modèle **ne peut pas**
/// garantir, et qu'il ne faut donc pas supposer ailleurs.
model Expedition {
  id String @id @default(uuid(7)) @db.Uuid

  commande   Commande @relation(fields: [commandeId], references: [id], onDelete: Restrict)
  commandeId String   @unique @map("commande_id") @db.Uuid

  boutique   Boutique @relation(fields: [boutiqueId], references: [id], onDelete: Restrict)
  boutiqueId String   @map("boutique_id") @db.Uuid

  statut           StatutExpedition @default(en_preparation)
  /// `coursier`, `transporteur`, `main propre` — **non vérifié**.
  moyenDeclare     String?          @map("moyen_declare")
  /// Figé à la création : savoir après coup si le numéro était vérifié change
  /// la lecture d'un litige.
  telephoneVerifie Boolean          @default(false) @map("telephone_verifie")

  nbTentatives Int     @default(0) @map("nb_tentatives")
  motifEchec   String? @map("motif_echec")

  creeLe DateTime @default(now()) @map("cree_le") @db.Timestamptz(6)
  majLe  DateTime @default(now()) @updatedAt @map("maj_le") @db.Timestamptz(6)

  evenements EvenementLivraison[]

  @@index([boutiqueId, statut])
  @@map("expedition")
}

/// **Porte l'auteur de chaque transition.** L'arbitrage a disparu (`DP-05`) —
/// la trace reste, et c'est elle qu'on fournit quand le recours est externe.
model EvenementLivraison {
  id String @id @default(uuid(7)) @db.Uuid

  expedition   Expedition @relation(fields: [expeditionId], references: [id], onDelete: Restrict)
  expeditionId String     @map("expedition_id") @db.Uuid

  statut StatutExpedition

  auteur   User?   @relation(fields: [auteurId], references: [id], onDelete: Restrict)
  auteurId String? @map("auteur_id") @db.Uuid

  horodatage  DateTime @default(now()) @db.Timestamptz(6)
  commentaire String?

  @@index([expeditionId, horodatage])
  @@map("evenement_livraison")
}

/// La remise d'un cadeau se négocie **entre l'acheteuse ou la bénéficiaire et
/// la boutique — jamais le donateur** (RB8, `DP-10`).
///
/// Il fallait autrefois cacher activement l'adresse au donateur ; désormais il
/// ne la manipule jamais. La règle est devenue structurelle.
model FilRemise {
  id String @id @default(uuid(7)) @db.Uuid

  commande   Commande @relation(fields: [commandeId], references: [id], onDelete: Restrict)
  commandeId String   @unique @map("commande_id") @db.Uuid

  participants  Json
  pointConvenu  String?   @map("point_convenu")
  momentConvenu DateTime? @map("moment_convenu") @db.Timestamptz(6)
  /// Débloque le paiement du cadeau (`DP-10`).
  accordLe      DateTime? @map("accord_le") @db.Timestamptz(6)

  creeLe DateTime @default(now()) @map("cree_le") @db.Timestamptz(6)

  @@map("fil_remise")
}

// ─────────────────────────────────────────────────────────────────────────
// Contenu — la boutique dont le catalogue est fait de vidéos (F14.5)
// ─────────────────────────────────────────────────────────────────────────

/// **Un contenu publié DOIT porter au moins un article** (R-K1, RB5). C'est la
/// règle d'or du produit : sans elle, le fil devient un réseau social de plus,
/// et plus une boutique.
///
/// Appliquée par transaction **et** par déclencheur de contrainte **différé** —
/// ce qui permet d'insérer le contenu puis ses articles dans le même bloc.
model Contenu {
  id String @id @default(uuid(7)) @db.Uuid

  auteur   User   @relation(fields: [auteurId], references: [id], onDelete: Restrict)
  auteurId String @map("auteur_id") @db.Uuid

  type         TypeContenu
  mediaUrl     String      @map("media_url")
  miniatureUrl String?     @map("miniature_url")
  dureeS       Int?        @map("duree_s")

  statut StatutContenu @default(brouillon)

  /// Obligatoire si `type = unboxing` (R-K2) : un déballage sans commande est
  /// une publicité déguisée.
  commandeSource   Commande? @relation(fields: [commandeSourceId], references: [id], onDelete: Restrict)
  commandeSourceId String?   @map("commande_source_id") @db.Uuid

  commentairesOuverts CommentairesOuverts @default(tous) @map("commentaires_ouverts")

  publieLe DateTime? @map("publie_le") @db.Timestamptz(6)
  /// Une story : +24 h.
  expireLe DateTime? @map("expire_le") @db.Timestamptz(6)

  /// Détection de republication (R-X7).
  empreinteVideo String? @map("empreinte_video")

  /// **L'étiquette de sponsoring est CALCULÉE, jamais saisie** (F18.8) — donc
  /// non retirable par l'autrice. Les identifiants restent scalaires tant que
  /// les tables de monétisation ne sont pas posées.
  partenariatId     String? @map("partenariat_id") @db.Uuid
  campagneId        String? @map("campagne_id") @db.Uuid
  sponsoriseDeclare Boolean @default(false) @map("sponsorise_declare")

  /// Figé à la publication (RB6). Recalculer l'âge après coup changerait la
  /// légalité d'une publication passée.
  auteurMajeur Boolean @default(false) @map("auteur_majeur")

  supprimeLe DateTime? @map("supprime_le") @db.Timestamptz(6)
  creeLe     DateTime  @default(now()) @map("cree_le") @db.Timestamptz(6)
  majLe      DateTime  @default(now()) @updatedAt @map("maj_le") @db.Timestamptz(6)

  articles              ContenuArticle[]
  statistique           StatistiqueContenu?
  interactions          Interaction[]
  hashtags              ContenuHashtag[]
  avis                  Avis[]
  republications        RepublicationSuspectee[] @relation("contenu_suspecte")
  republicationsOrigine RepublicationSuspectee[] @relation("contenu_origine")

  @@index([auteurId, publieLe])
  @@index([statut, publieLe])
  @@map("contenu")
}

model ContenuArticle {
  contenu   Contenu @relation(fields: [contenuId], references: [id], onDelete: Restrict)
  contenuId String  @map("contenu_id") @db.Uuid

  article   Article @relation(fields: [articleId], references: [id], onDelete: Restrict)
  articleId String  @map("article_id") @db.Uuid

  /// Porte l'affiliation (R-N1) : c'est cette ligne qui dit quelle créatrice a
  /// amené la vente, et donc qui sera payée.
  createurId String? @map("createur_id") @db.Uuid

  position Int @default(0)

  @@id([contenuId, articleId])
  @@map("contenu_article")
}

/// `gains` est **le chiffre le plus important** (R-K15) : c'est le seul qui
/// répond à « est-ce que publier m'a rapporté quelque chose ».
model StatistiqueContenu {
  contenu   Contenu @relation(fields: [contenuId], references: [id], onDelete: Restrict)
  contenuId String  @id @map("contenu_id") @db.Uuid

  vues          Int @default(0)
  dureeMoyenneS Int @default(0) @map("duree_moyenne_s")
  clicsArticle  Int @default(0) @map("clics_article")
  jePrends      Int @default(0) @map("je_prends")
  ventes        Int @default(0)
  gains         Int @default(0)

  calculeLe DateTime @default(now()) @map("calcule_le") @db.Timestamptz(6)

  @@map("statistique_contenu")
}

model Interaction {
  id String @id @default(uuid(7)) @db.Uuid

  contenu   Contenu @relation(fields: [contenuId], references: [id], onDelete: Restrict)
  contenuId String  @map("contenu_id") @db.Uuid

  user   User   @relation(fields: [userId], references: [id], onDelete: Restrict)
  userId String @map("utilisateur_id") @db.Uuid

  type   TypeInteraction
  texte  String?
  statut StatutInteraction @default(publie)

  creeLe DateTime @default(now()) @map("cree_le") @db.Timestamptz(6)

  @@index([contenuId, type, creeLe])
  @@index([userId, type])
  @@map("interaction")
}

model Hashtag {
  id  String @id @default(uuid(7)) @db.Uuid
  mot String @unique

  nbContenus Int @default(0) @map("nb_contenus")

  creeLe DateTime @default(now()) @map("cree_le") @db.Timestamptz(6)

  contenus ContenuHashtag[]

  @@map("hashtag")
}

model ContenuHashtag {
  contenu   Contenu @relation(fields: [contenuId], references: [id], onDelete: Restrict)
  contenuId String  @map("contenu_id") @db.Uuid

  hashtag   Hashtag @relation(fields: [hashtagId], references: [id], onDelete: Restrict)
  hashtagId String  @map("hashtag_id") @db.Uuid

  @@id([contenuId, hashtagId])
  @@map("contenu_hashtag")
}

// ─────────────────────────────────────────────────────────────────────────
// Confiance — la SEULE protection de l'acheteuse depuis DP-07
// ─────────────────────────────────────────────────────────────────────────

/// Le signalement de commande — **anciennement `litige`** (`DP-05`).
///
/// Personne n'instruit, personne ne tranche, personne ne s'attribue de dossier :
/// `decision_texte`, `decide_par_id` et `affecte_a_id` ont disparu avec
/// l'arbitrage. Ce qui reste est un compteur public.
///
/// **`compteDansLeScore` est TOUTE la sanction du produit** (R-T8). Il n'y a
/// plus ni séquestre, ni arbitre, ni argent retenu (`DP-07`) : un signalement
/// ouvert pèse sur la réputation, et c'est le seul levier.
model SignalementCommande {
  id String @id @default(uuid(7)) @db.Uuid

  commande   Commande @relation(fields: [commandeId], references: [id], onDelete: Restrict)
  commandeId String   @map("commande_id") @db.Uuid

  ouvertPar   User   @relation("ouvreur_signalement", fields: [ouvertParId], references: [id], onDelete: Restrict)
  ouvertParId String @map("ouvert_par_id") @db.Uuid

  /// **Filtré par univers** : « pas ma taille » n'a aucun sens pour un
  /// téléphone, « batterie morte » aucun pour une robe. D'où l'univers figé ici
  /// plutôt qu'un motif universel qui ne parlerait à personne.
  universeKey String                    @map("universe_key")
  motif       MotifLitige
  statut      StatutSignalementCommande @default(ouvert)

  /// `CHECK (compte_dans_le_score = (statut <> 'resolu'))`. La résolution
  /// décrémente le compteur, et aucun code ne peut les désynchroniser.
  compteDansLeScore Boolean @default(true) @map("compte_dans_le_score")

  resoluLe DateTime? @map("resolu_le") @db.Timestamptz(6)

  creeLe DateTime @default(now()) @map("cree_le") @db.Timestamptz(6)
  majLe  DateTime @default(now()) @updatedAt @map("maj_le") @db.Timestamptz(6)

  messages MessageLitige[]

  @@index([commandeId])
  @@index([statut, creeLe])
  @@map("signalement_commande")
}

model MessageLitige {
  id String @id @default(uuid(7)) @db.Uuid

  signalement   SignalementCommande @relation(fields: [signalementId], references: [id], onDelete: Restrict)
  signalementId String              @map("signalement_id") @db.Uuid

  auteur   User   @relation(fields: [auteurId], references: [id], onDelete: Restrict)
  auteurId String @map("auteur_id") @db.Uuid

  texte         String
  piecesJointes Json?  @map("pieces_jointes")

  creeLe DateTime @default(now()) @map("cree_le") @db.Timestamptz(6)

  @@index([signalementId, creeLe])
  @@map("message_litige")
}

/// Un seul avis par commande. `morphologieAutrice` est **figée au moment de
/// l'avis** (F6.10) : sinon un changement de profil réécrirait le sens d'un
/// avis passé — « taille petit » ne veut rien dire sans savoir pour qui.
model Avis {
  id String @id @default(uuid(7)) @db.Uuid

  commande   Commande @relation(fields: [commandeId], references: [id], onDelete: Restrict)
  commandeId String   @unique @map("commande_id") @db.Uuid

  auteur   User   @relation(fields: [auteurId], references: [id], onDelete: Restrict)
  auteurId String @map("auteur_id") @db.Uuid

  boutique   Boutique @relation(fields: [boutiqueId], references: [id], onDelete: Restrict)
  boutiqueId String   @map("boutique_id") @db.Uuid

  article   Article? @relation(fields: [articleId], references: [id], onDelete: Restrict)
  articleId String?  @map("article_id") @db.Uuid

  /// `CHECK 1..5`.
  note     Int
  texte    String?
  photoUrl String? @map("photo_url")

  conformiteTaille   ConformiteTaille? @map("conformite_taille")
  morphologieAutrice Json?             @map("morphologie_autrice")

  /// L'avis né d'un déballage (R-T7).
  contenu   Contenu? @relation(fields: [contenuId], references: [id], onDelete: SetNull)
  contenuId String?  @map("contenu_id") @db.Uuid

  /// **Une seule fois** (F6.9) : le droit de réponse n'est pas un fil de
  /// discussion.
  reponseTexte String?   @map("reponse_texte")
  reponseLe    DateTime? @map("reponse_le") @db.Timestamptz(6)

  creeLe DateTime @default(now()) @map("cree_le") @db.Timestamptz(6)

  @@index([boutiqueId, creeLe])
  @@map("avis")
}

/// Public, calculé sur des faits. `decomposition` porte la contribution de
/// chaque composante (R-T10) : un score qu'on ne peut pas expliquer à la
/// boutique concernée est un score qu'elle contestera.
model ScoreConfiance {
  boutique   Boutique @relation(fields: [boutiqueId], references: [id], onDelete: Restrict)
  boutiqueId String   @id @map("boutique_id") @db.Uuid

  score                Decimal @default(0) @db.Decimal(4, 2)
  nbVentesHonorees     Int     @default(0) @map("nb_ventes_honorees")
  delaiExpeditionReelH Int?    @map("delai_expedition_reel_h")
  tauxAnnulation       Decimal @default(0) @map("taux_annulation") @db.Decimal(5, 4)
  tauxLitige           Decimal @default(0) @map("taux_litige") @db.Decimal(5, 4)
  decomposition        Json?

  calculeLe DateTime @default(now()) @map("calcule_le") @db.Timestamptz(6)

  @@map("score_confiance")
}

// ─────────────────────────────────────────────────────────────────────────
// Modération — la protection des personnes (F19.1)
// ─────────────────────────────────────────────────────────────────────────

model Signalement {
  id String @id @default(uuid(7)) @db.Uuid

  cibleType String @map("cible_type")
  cibleId   String @map("cible_id") @db.Uuid

  signalePar   User   @relation("signaleur", fields: [signaleParId], references: [id], onDelete: Restrict)
  signaleParId String @map("signale_par_id") @db.Uuid

  motif  String
  niveau NiveauSignalement @default(ordinaire)
  statut StatutSignalement @default(nouveau)

  affecteA   User?   @relation("affecte_signalement", fields: [affecteAId], references: [id], onDelete: Restrict)
  affecteAId String? @map("affecte_a_id") @db.Uuid

  traitePar   User?   @relation("traiteur_signalement", fields: [traiteParId], references: [id], onDelete: Restrict)
  traiteParId String? @map("traite_par_id") @db.Uuid
  decision    String?

  creeLe DateTime @default(now()) @map("cree_le") @db.Timestamptz(6)

  /// L'urgence en tête de file (R-X4). L'ordre des colonnes de l'index n'est
  /// pas décoratif : c'est lui qui met les menaces devant.
  @@index([niveau, statut, creeLe])
  @@index([cibleType, cibleId])
  @@map("signalement")
}

/// `resultatContestation` est **instruit par une autre personne** que celle qui
/// a sanctionné. Une contestation examinée par son propre auteur n'est pas une
/// contestation.
model Sanction {
  id String @id @default(uuid(7)) @db.Uuid

  user   User   @relation("sanctionne", fields: [userId], references: [id], onDelete: Restrict)
  userId String @map("utilisateur_id") @db.Uuid

  type       TypeSanction
  motifTexte String       @map("motif_texte")
  /// En jours. `NULL` = définitive.
  duree      Int?

  appliquePar   User   @relation("applicateur_sanction", fields: [appliqueParId], references: [id], onDelete: Restrict)
  appliqueParId String @map("applique_par_id") @db.Uuid

  conteste             Boolean @default(false)
  resultatContestation String? @map("resultat_contestation")
  instruitParId        String? @map("instruit_par_id") @db.Uuid

  creeLe DateTime @default(now()) @map("cree_le") @db.Timestamptz(6)

  @@index([userId, creeLe])
  @@map("sanction")
}

/// Bloquer quelqu'un. `IDX(bloque_id)` sert le sens inverse : « qui m'a
/// bloqué » doit être aussi rapide que « qui j'ai bloqué », sinon le filtrage
/// du fil coûte un balayage complet.
model Blocage {
  bloqueur   User   @relation("bloqueur", fields: [bloqueurId], references: [id], onDelete: Restrict)
  bloqueurId String @map("bloqueur_id") @db.Uuid

  bloque   User   @relation("bloque", fields: [bloqueId], references: [id], onDelete: Restrict)
  bloqueId String @map("bloque_id") @db.Uuid

  creeLe DateTime @default(now()) @map("cree_le") @db.Timestamptz(6)

  @@id([bloqueurId, bloqueId])
  @@index([bloqueId])
  @@map("blocage")
}

/// Les mots qu'une personne ne veut plus voir dans ses commentaires. Personnel
/// et non global : la liste noire de l'une n'est pas celle de l'autre.
model MotBloquePersonnel {
  user   User   @relation(fields: [userId], references: [id], onDelete: Restrict)
  userId String @map("utilisateur_id") @db.Uuid

  mot String

  @@id([userId, mot])
  @@map("mot_bloque_personnel")
}

model RepublicationSuspectee {
  id String @id @default(uuid(7)) @db.Uuid

  contenu   Contenu @relation("contenu_suspecte", fields: [contenuId], references: [id], onDelete: Restrict)
  contenuId String  @map("contenu_id") @db.Uuid

  contenuOrigine   Contenu @relation("contenu_origine", fields: [contenuOrigineId], references: [id], onDelete: Restrict)
  contenuOrigineId String  @map("contenu_origine_id") @db.Uuid

  proximite Decimal             @db.Decimal(5, 4)
  statut    StatutRepublication @default(a_examiner)

  creeLe DateTime @default(now()) @map("cree_le") @db.Timestamptz(6)

  @@index([statut, proximite])
  @@map("republication_suspectee")
}

// ─────────────────────────────────────────────────────────────────────────
// Créatrices — vendre sans capital (F15.4, F15.8)
// ─────────────────────────────────────────────────────────────────────────

/// Une sélection thématique composée par une créatrice à partir d'articles
/// qu'elle ne possède pas.
model Selection {
  id String @id @default(uuid(7)) @db.Uuid

  createur   CreatorProfile @relation(fields: [createurId], references: [id], onDelete: Restrict)
  createurId String         @map("createur_id") @db.Uuid

  nomTheme String @map("nom_theme")
  position Int    @default(0)

  creeLe DateTime @default(now()) @map("cree_le") @db.Timestamptz(6)

  articles SelectionArticle[]

  @@index([createurId, position])
  @@map("selection")
}

model SelectionArticle {
  selection   Selection @relation(fields: [selectionId], references: [id], onDelete: Restrict)
  selectionId String    @map("selection_id") @db.Uuid

  article   Article @relation(fields: [articleId], references: [id], onDelete: Restrict)
  articleId String  @map("article_id") @db.Uuid

  position Int @default(0)

  @@id([selectionId, articleId])
  @@map("selection_article")
}

/// La fenêtre d'attribution (R-N2). `expireLe` est ce qui décide si une vente
/// revient à la créatrice : sans date, l'attribution serait éternelle et la
/// boutique paierait une commission pour un clic d'il y a six mois.
model ClicAffiliation {
  id String @id @default(uuid(7)) @db.Uuid

  createur   CreatorProfile @relation(fields: [createurId], references: [id], onDelete: Restrict)
  createurId String         @map("createur_id") @db.Uuid

  article   Article @relation(fields: [articleId], references: [id], onDelete: Restrict)
  articleId String  @map("article_id") @db.Uuid

  user   User?   @relation(fields: [userId], references: [id], onDelete: Restrict)
  userId String? @map("utilisateur_id") @db.Uuid

  expireLe DateTime @map("expire_le") @db.Timestamptz(6)
  creeLe   DateTime @default(now()) @map("cree_le") @db.Timestamptz(6)

  @@index([userId, articleId, expireLe])
  @@map("clic_affiliation")
}

/// La précommande porte RB3 : on ne garde pas indéfiniment l'argent de gens qui
/// attendent. `dateExpeditionMax` est la promesse ; la dépasser rembourse.
model Precommande {
  id String @id @default(uuid(7)) @db.Uuid

  article   Article @relation(fields: [articleId], references: [id], onDelete: Restrict)
  articleId String  @unique @map("article_id") @db.Uuid

  organisateur   CreatorProfile @relation(fields: [organisateurId], references: [id], onDelete: Restrict)
  organisateurId String         @map("organisateur_id") @db.Uuid

  /// `CHECK > 0` — une précommande sans seuil est une vente ordinaire.
  seuil          Int
  dateLimite     DateTime @map("date_limite") @db.Timestamptz(6)
  compteurActuel Int      @default(0) @map("compteur_actuel")

  statut StatutPrecommande @default(ouverte)

  /// Paramétré (R-N9) : la part libérée avant livraison, pour que la créatrice
  /// puisse produire.
  avanceLiberee     Int      @default(0) @map("avance_liberee")
  dateExpeditionMax DateTime @map("date_expedition_max") @db.Timestamptz(6)

  creeLe DateTime @default(now()) @map("cree_le") @db.Timestamptz(6)
  majLe  DateTime @default(now()) @updatedAt @map("maj_le") @db.Timestamptz(6)

  engagements PrecommandeEngagement[]

  @@map("precommande")
}

model PrecommandeEngagement {
  id String @id @default(uuid(7)) @db.Uuid

  precommande   Precommande @relation(fields: [precommandeId], references: [id], onDelete: Restrict)
  precommandeId String      @map("precommande_id") @db.Uuid

  commande   Commande @relation(fields: [commandeId], references: [id], onDelete: Restrict)
  commandeId String   @unique @map("commande_id") @db.Uuid

  statut StatutEngagement @default(engage)

  creeLe DateTime @default(now()) @map("cree_le") @db.Timestamptz(6)

  @@index([precommandeId, statut])
  @@map("precommande_engagement")
}

// ─────────────────────────────────────────────────────────────────────────
// Fidélité, cagnotte et dressing (F7.18, F7.6)
// ─────────────────────────────────────────────────────────────────────────

/// **Doit exister dès la phase 1**, même si la fidélisation n'est activée qu'en
/// phase 2 (R-R11). Sans elle, il faudra reconstituer l'historique à la main —
/// ou effacer la fidélité des premières clientes, qui sont précisément les plus
/// fidèles.
///
/// `UNIQUE(commande_id)` rend le rattrapage **idempotent** : on peut rejouer le
/// journal sur tout l'historique sans compter deux fois.
model VenteConfirmeeJournal {
  id String @id @default(uuid(7)) @db.Uuid

  boutique   Boutique @relation(fields: [boutiqueId], references: [id], onDelete: Restrict)
  boutiqueId String   @map("boutique_id") @db.Uuid

  user   User   @relation(fields: [userId], references: [id], onDelete: Restrict)
  userId String @map("utilisateur_id") @db.Uuid

  commande   Commande @relation(fields: [commandeId], references: [id], onDelete: Restrict)
  commandeId String   @unique @map("commande_id") @db.Uuid

  montantConfirme Int      @map("montant_confirme")
  confirmeLe      DateTime @default(now()) @map("confirme_le") @db.Timestamptz(6)

  @@index([boutiqueId, userId])
  @@map("vente_confirmee_journal")
}

model RangClient {
  id String @id @default(uuid(7)) @db.Uuid

  boutique   Boutique @relation(fields: [boutiqueId], references: [id], onDelete: Restrict)
  boutiqueId String   @map("boutique_id") @db.Uuid

  user   User   @relation(fields: [userId], references: [id], onDelete: Restrict)
  userId String @map("utilisateur_id") @db.Uuid

  palier   PalierFidelite? @relation(fields: [palierId], references: [id], onDelete: SetNull)
  palierId String?         @map("palier_id") @db.Uuid

  score         Int @default(0)
  montantCumule Int @default(0) @map("montant_cumule")
  nbCommandes   Int @default(0) @map("nb_commandes")

  derniereCommandeLe DateTime? @map("derniere_commande_le") @db.Timestamptz(6)
  nbLitigesPerdus    Int       @default(0) @map("nb_litiges_perdus")
  nbAnnulations      Int       @default(0) @map("nb_annulations")

  calculeLe DateTime @default(now()) @map("calcule_le") @db.Timestamptz(6)

  @@unique([boutiqueId, userId])
  @@index([boutiqueId, score])
  @@index([boutiqueId, derniereCommandeLe])
  @@map("rang_client")
}

/// **Jamais visible du client.** C'est une note interne de boutique ; la rendre
/// visible transformerait un outil de suivi en insulte publique.
model NoteClient {
  boutique   Boutique @relation(fields: [boutiqueId], references: [id], onDelete: Restrict)
  boutiqueId String   @map("boutique_id") @db.Uuid

  user   User   @relation(fields: [userId], references: [id], onDelete: Restrict)
  userId String @map("utilisateur_id") @db.Uuid

  texte String

  majLe DateTime @default(now()) @updatedAt @map("maj_le") @db.Timestamptz(6)

  @@id([boutiqueId, userId])
  @@map("note_client")
}

/// `solde` est **dérivé** des mouvements. Il est stocké pour l'affichage, et un
/// test le recalcule par relecture du journal : un solde qu'on ne sait pas
/// reconstituer est un solde qu'on ne peut pas défendre.
model Cagnotte {
  user   User   @relation(fields: [userId], references: [id], onDelete: Restrict)
  userId String @id @map("utilisateur_id") @db.Uuid

  solde Int @default(0)

  majLe DateTime @default(now()) @updatedAt @map("maj_le") @db.Timestamptz(6)

  @@map("cagnotte")
}

model MouvementCagnotte {
  id String @id @default(uuid(7)) @db.Uuid

  user   User   @relation(fields: [userId], references: [id], onDelete: Restrict)
  userId String @map("utilisateur_id") @db.Uuid

  type      TypeMouvementCagnotte
  montant   Int
  /// Unique **partiellement** pour `credit_unboxing` : on ne crédite pas deux
  /// fois le même déballage, même si la tâche est rejouée.
  reference String?

  creeLe DateTime @default(now()) @map("cree_le") @db.Timestamptz(6)

  @@index([userId, creeLe])
  @@map("mouvement_cagnotte")
}

/// La garde-robe. `articleId` **rend la pièce achetable dans un look** : c'est
/// ce qui relie le dressing au catalogue au lieu d'en faire un album photo.
model PieceDressing {
  id String @id @default(uuid(7)) @db.Uuid

  user   User   @relation(fields: [userId], references: [id], onDelete: Restrict)
  userId String @map("utilisateur_id") @db.Uuid

  origine OriginePieceDressing @default(ajout_manuel)

  commande   Commande? @relation(fields: [commandeId], references: [id], onDelete: Restrict)
  commandeId String?   @map("commande_id") @db.Uuid

  article   Article? @relation(fields: [articleId], references: [id], onDelete: Restrict)
  articleId String?  @map("article_id") @db.Uuid

  photoUrl  String? @map("photo_url")
  categorie String?

  creeLe DateTime @default(now()) @map("cree_le") @db.Timestamptz(6)

  looks LookPiece[]

  @@index([userId, categorie])
  @@map("piece_dressing")
}

model Look {
  id String @id @default(uuid(7)) @db.Uuid

  user   User   @relation(fields: [userId], references: [id], onDelete: Restrict)
  userId String @map("utilisateur_id") @db.Uuid

  nom       String
  contenuId String? @map("contenu_id") @db.Uuid

  creeLe DateTime @default(now()) @map("cree_le") @db.Timestamptz(6)

  pieces LookPiece[]

  @@index([userId])
  @@map("look")
}

model LookPiece {
  look   Look   @relation(fields: [lookId], references: [id], onDelete: Restrict)
  lookId String @map("look_id") @db.Uuid

  piece   PieceDressing @relation(fields: [pieceId], references: [id], onDelete: Restrict)
  pieceId String        @map("piece_id") @db.Uuid

  /// La position dans la composition visuelle.
  position Json?

  @@id([lookId, pieceId])
  @@map("look_piece")
}

// ─────────────────────────────────────────────────────────────────────────
// Cadeau — le canal diaspora (F16.1)
// ─────────────────────────────────────────────────────────────────────────

/// Un panier composé par l'une, payé par un autre. **Le donateur ne voit jamais
/// l'adresse** (RB8) : elle se négocie dans `fil_remise`, dont il ne fait pas
/// partie.
model PanierCadeau {
  id String @id @default(uuid(7)) @db.Uuid

  compositrice   User   @relation("compositrice", fields: [compositriceId], references: [id], onDelete: Restrict)
  compositriceId String @map("compositrice_id") @db.Uuid

  commande   Commande? @relation(fields: [commandeId], references: [id], onDelete: Restrict)
  commandeId String?   @unique @map("commande_id") @db.Uuid

  lienPartage String             @unique @map("lien_partage")
  statut      StatutPanierCadeau @default(compose)
  message     String?

  expireLe DateTime @map("expire_le") @db.Timestamptz(6)
  creeLe   DateTime @default(now()) @map("cree_le") @db.Timestamptz(6)

  @@index([statut, expireLe])
  @@map("panier_cadeau")
}

// ─────────────────────────────────────────────────────────────────────────
// Monétisation — le modèle économique (F10.3, DP-08)
// ─────────────────────────────────────────────────────────────────────────

/// L'abonnement d'une boutique. Les quotas sont **dans la ligne**, pas dans le
/// code : c'est ce qui permet d'ajuster un palier pendant le pilote sans
/// déploiement, et de faire une exception nominative sans forker le code.
model AbonnementBoutique {
  id String @id @default(uuid(7)) @db.Uuid

  boutique   Boutique @relation(fields: [boutiqueId], references: [id], onDelete: Restrict)
  boutiqueId String   @map("boutique_id") @db.Uuid

  palier PalierAbonnement         @default(gratuit)
  statut StatutAbonnementBoutique @default(actif)

  /// Portent R-B4. `NULL` = illimité.
  quotaVentes  Int? @map("quota_ventes")
  quotaDirects Int? @map("quota_directs")

  /// **Entier en Ariary** (D6). Zéro pour le palier gratuit.
  montant Int @default(0)

  debutLe    DateTime  @default(now()) @map("debut_le") @db.Timestamptz(6)
  echeanceLe DateTime  @map("echeance_le") @db.Timestamptz(6)
  resilieLe  DateTime? @map("resilie_le") @db.Timestamptz(6)

  creeLe DateTime @default(now()) @map("cree_le") @db.Timestamptz(6)
  majLe  DateTime @default(now()) @updatedAt @map("maj_le") @db.Timestamptz(6)

  @@index([boutiqueId, statut])
  @@index([statut, echeanceLe])
  @@map("abonnement_boutique")
}

/// JP Club, côté acheteuse : livraison offerte au-dessus d'un seuil.
model AdhesionClub {
  user   User   @relation(fields: [userId], references: [id], onDelete: Restrict)
  userId String @id @map("utilisateur_id") @db.Uuid

  montant      Int
  seuilOffert  Int      @map("seuil_offert")
  debutLe      DateTime @default(now()) @map("debut_le") @db.Timestamptz(6)
  echeanceLe   DateTime @map("echeance_le") @db.Timestamptz(6)
  reconduction Boolean  @default(false)

  @@index([echeanceLe])
  @@map("adhesion_club")
}

/// Emplacements payés. **La mention « Sponsorisé » est obligatoire** — c'est
/// une règle de loyauté, pas une préférence d'affichage.
model MiseEnAvant {
  id String @id @default(uuid(7)) @db.Uuid

  boutique   Boutique @relation(fields: [boutiqueId], references: [id], onDelete: Restrict)
  boutiqueId String   @map("boutique_id") @db.Uuid

  type      TypeMiseEnAvant
  cibleType String          @map("cible_type")
  cibleId   String          @map("cible_id") @db.Uuid

  montant Int
  debutLe DateTime @map("debut_le") @db.Timestamptz(6)
  finLe   DateTime @map("fin_le") @db.Timestamptz(6)

  impressions Int @default(0)
  clics       Int @default(0)

  creeLe DateTime @default(now()) @map("cree_le") @db.Timestamptz(6)

  @@index([type, debutLe, finLe])
  @@map("mise_en_avant")
}

/// Liens courts et attribution — **le canal d'acquisition principal.** Un
/// partage WhatsApp qu'on ne sait pas attribuer est un budget qu'on ne sait pas
/// juger.
model LienPartage {
  id   String @id @default(uuid(7)) @db.Uuid
  code String @unique

  createur   User?   @relation(fields: [createurId], references: [id], onDelete: Restrict)
  createurId String? @map("createur_id") @db.Uuid

  cibleType String  @map("cible_type")
  cibleId   String  @map("cible_id") @db.Uuid
  canal     String?

  clics        Int @default(0)
  inscriptions Int @default(0)
  commandes    Int @default(0)

  creeLe DateTime @default(now()) @map("cree_le") @db.Timestamptz(6)

  @@index([cibleType, cibleId])
  @@map("lien_partage")
}

/// Conversion **indicative**. `constateLe` existe pour qu'aucun taux périmé ne
/// soit affiché sans mention : un taux sans date est une promesse implicite.
model TauxChange {
  id String @id @default(uuid(7)) @db.Uuid

  devise     String
  versAriary Decimal @map("vers_ariary") @db.Decimal(14, 6)

  constateLe DateTime @default(now()) @map("constate_le") @db.Timestamptz(6)

  @@index([devise, constateLe])
  @@map("taux_change")
}

// ─────────────────────────────────────────────────────────────────────────
// Exploitation — notifications, réconciliation, mesures
// ─────────────────────────────────────────────────────────────────────────

model Notification {
  id String @id @default(uuid(7)) @db.Uuid

  destinataire   User   @relation(fields: [destinataireId], references: [id], onDelete: Restrict)
  destinataireId String @map("destinataire_id") @db.Uuid

  type   String
  canal  CanalNotification
  statut StatutNotification @default(en_attente)

  titre   String
  corps   String
  donnees Json?

  emetteurId String? @map("emetteur_id") @db.Uuid

  envoyeeLe DateTime? @map("envoyee_le") @db.Timestamptz(6)
  lueLe     DateTime? @map("lue_le") @db.Timestamptz(6)
  creeLe    DateTime  @default(now()) @map("cree_le") @db.Timestamptz(6)

  @@index([destinataireId, creeLe])
  @@index([statut, creeLe])
  @@map("notification")
}

/// **Les plafonds** (R-U4, R-W9). La clé primaire porte le jour : le compteur
/// se remet à zéro par le simple fait de changer de date, sans tâche de purge
/// et sans fenêtre glissante à recalculer.
model NotificationCompteur {
  user   User   @relation(fields: [userId], references: [id], onDelete: Restrict)
  userId String @map("utilisateur_id") @db.Uuid

  emetteurId String   @map("emetteur_id") @db.Uuid
  type       String
  jour       DateTime @db.Date

  compte Int @default(0)

  @@id([userId, emetteurId, type, jour])
  @@map("notification_compteur")
}

/// Réglages par type. **Les notifications critiques ne sont pas
/// désactivables** — une commande payée, un litige ouvert : couper ces
/// messages-là nuirait à la personne qui les coupe.
model PreferenceNotification {
  user   User   @relation(fields: [userId], references: [id], onDelete: Restrict)
  userId String @map("utilisateur_id") @db.Uuid

  type  String
  canal CanalNotification

  actif Boolean @default(true)

  @@id([userId, type, canal])
  @@map("preference_notification")
}

/// Les SMS **et leur coût** : c'est une ligne de dépense à suivre, pas un
/// détail technique. Un produit qui notifie trop se ruine sans le voir.
model NotificationSms {
  id String @id @default(uuid(7)) @db.Uuid

  notificationId String? @map("notification_id") @db.Uuid
  msisdn         String
  operateur      String?

  statut     StatutNotification @default(en_attente)
  coutAriary Int                @default(0) @map("cout_ariary")
  reference  String?

  creeLe DateTime @default(now()) @map("cree_le") @db.Timestamptz(6)

  @@index([creeLe])
  @@map("notification_sms")
}

/// Rapprochement **encaissements opérateurs ↔ commandes** (R-O3).
model Reconciliation {
  id String @id @default(uuid(7)) @db.Uuid

  operateur String
  periodeLe DateTime @map("periode_le") @db.Date

  nbLignes         Int @default(0) @map("nb_lignes")
  montantOperateur Int @default(0) @map("montant_operateur")
  montantJp        Int @default(0) @map("montant_jp")

  closeLe DateTime? @map("close_le") @db.Timestamptz(6)
  creeLe  DateTime  @default(now()) @map("cree_le") @db.Timestamptz(6)

  ecarts Ecart[]

  @@unique([operateur, periodeLe])
  @@map("reconciliation")
}

/// Un écart se résout **par une écriture inverse**, jamais par une correction
/// de l'écriture d'origine : `ecriture_financiere` est en ajout seul.
model Ecart {
  id String @id @default(uuid(7)) @db.Uuid

  reconciliation   Reconciliation @relation(fields: [reconciliationId], references: [id], onDelete: Restrict)
  reconciliationId String         @map("reconciliation_id") @db.Uuid

  referenceExterne String? @map("reference_externe")
  paiementId       String? @map("paiement_id") @db.Uuid

  montantEcart Int         @map("montant_ecart")
  statut       StatutEcart @default(ouvert)
  commentaire  String?

  ecritureCorrectiveId String?   @map("ecriture_corrective_id") @db.Uuid
  resoluLe             DateTime? @map("resolu_le") @db.Timestamptz(6)

  creeLe DateTime @default(now()) @map("cree_le") @db.Timestamptz(6)

  @@index([statut, creeLe])
  @@map("ecart")
}

/// Événements d'usage bruts. **Rétention 90 jours**, puis agrégés : garder le
/// détail indéfiniment coûte cher et ne sert plus au bout d'un trimestre.
model EvenementUsage {
  id String @id @default(uuid(7)) @db.Uuid

  nom        String
  userId     String? @map("utilisateur_id") @db.Uuid
  sessionId  String? @map("session_id") @db.Uuid
  proprietes Json?

  horodatage DateTime @default(now()) @db.Timestamptz(6)

  @@index([nom, horodatage])
  @@index([horodatage])
  @@map("evenement_usage")
}

/// **Les quatre mesures fondatrices** (F11.7), précalculées. Une page de
/// pilotage qui recalcule tout à chaque ouverture n'est pas consultée.
model AgregatQuotidien {
  jour DateTime @id @db.Date

  visiteurs       Int @default(0)
  inscriptions    Int @default(0)
  commandesPayees Int @default(0) @map("commandes_payees")
  caAriary        Int @default(0) @map("ca_ariary")

  calculeLe DateTime @default(now()) @map("calcule_le") @db.Timestamptz(6)

  @@map("agregat_quotidien")
}

/// Statistiques de boutique par jour **et par origine** : sans l'origine, on ne
/// sait pas si c'est le direct ou le catalogue qui vend, donc où investir.
model AgregatBoutique {
  boutique   Boutique @relation(fields: [boutiqueId], references: [id], onDelete: Restrict)
  boutiqueId String   @map("boutique_id") @db.Uuid

  jour    DateTime     @db.Date
  origine SaleOrigin

  vues            Int @default(0)
  reservations    Int @default(0)
  commandesPayees Int @default(0) @map("commandes_payees")
  caAriary        Int @default(0) @map("ca_ariary")

  calculeLe DateTime @default(now()) @map("calcule_le") @db.Timestamptz(6)

  @@id([boutiqueId, jour, origine])
  @@map("agregat_boutique")
}

/// ♻️ **Rétablie** (`DP-15`). Le taux en pour mille, **historisé**.
///
/// Jamais d'`UPDATE` : une nouvelle version à chaque changement. C'est ce qui
/// permet à une commande de garder son taux (R-G3) — le barème dit ce qui
/// s'appliquait à une date, il ne dit pas ce qui s'applique aujourd'hui.
model BaremeCommission {
  id String @id @default(uuid(7)) @db.Uuid

  universeKey String           @map("universe_key")
  palier      PalierAbonnement @default(gratuit)

  /// En pour mille. 80 = 8 % (D6).
  tauxPourMille Int @map("taux_pour_mille")

  /// La version en vigueur est celle dont `finLe` est `NULL`.
  debutLe DateTime  @default(now()) @map("debut_le") @db.Timestamptz(6)
  finLe   DateTime? @map("fin_le") @db.Timestamptz(6)

