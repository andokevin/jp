generator client {
  provider = "prisma-client"
  output   = "../apps/api/src/genere/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────────────────────────────────────
// Énumérés
// ─────────────────────────────────────────────────────────────────────────

/// Anglais, français et malgache — la liste doit rester identique à `LANGUES`
/// de `@jp/i18n`, qui en est la source. Le français est le défaut : c'est la
/// langue écrite courante à Madagascar, et celle qui produit les libellés les
/// plus longs — donc celle qui contraint les maquettes.
enum Language {
  en
  fr
  // Le malgache. Retiré par `20260819182525_langues` à l'époque où `@jp/i18n`
  // n'en déclarait que deux ; réintroduit ici parce que le paquet en déclare
  // trois et que le parcours d'authentification est livré en malgache. Sans
  // cette valeur, l'inscription d'une malgachophone échoue à l'`INSERT` —
  // exactement la population visée.
  mg

  @@map("language")
}

/// Facultatif. `NULL` signifie « non renseigné », ce qui n'est PAS `autre` :
/// `autre` est un choix exprimé, `NULL` est l'absence de choix. Confondre les
/// deux ferait compter comme « autre » tous ceux qui ont sauté la question.
enum Gender {
  female
  male
  other

  @@map("gender")
}

/// Le verrou de la mise en vente (`DP-07`). Une boutique non vérifiée existe,
/// mais ne publie rien : l'argent partant directement à la boutique, vérifier
/// APRÈS la vente n'aurait plus aucun sens.
enum CartStatus {
  active
  checked_out
  abandoned

  @@map("cart_status")
}

/// Ce que la boutique publie AVANT le direct : un extrait des articles, une
/// publicité, ou une annonce (« il y aura une surprise »). Trois intentions
/// différentes, un même objet vidéo — d'où un énuméré plutôt que trois tables.
enum SnippetType {
  excerpt
  ad
  announcement

  @@map("snippet_type")
}

enum ExternalProvider {
  facebook
  google

  @@map("external_provider")
}

/// Le cycle d'une demande instruite par un humain du back-office.
enum RequestState {
  pending
  in_progress
  accepted
  rejected

  @@map("request_state")
}

enum EmailChangeStep {
  old_verified
  completed

  @@map("email_change_step")
}

/// Qui fait quoi dans une boutique à plusieurs mains.
enum TeamRole {
  owner
  manager
  fulfiller

  @@map("team_role")
}

/// **Un seul moteur de réservation pour tous les canaux** (R-H1). `origine`
/// change la valeur d'`expire_le` à la création (R-H3), et rien d'autre. Un
/// second chemin de réservation serait un défaut d'architecture.
/// **Le modèle économique** (`DP-08`). Le palier gratuit doit rester
/// fonctionnel (R-B3) : une boutique qui ne peut rien vendre sans payer ne
/// s'inscrit pas, et le pilote n'apprend rien.
/// ⚠️ Montants non arrêtés (`PO-6`).
enum SubscriptionTier {
  free
  essential
  pro
  premium

  @@map("subscription_tier")
}

enum ShopSubscriptionStatus {
  active
  overdue
  suspended
  cancelled

  @@map("shop_subscription_status")
}

enum NotificationChannel {
  push
  sms
  email
  in_app

  @@map("notification_channel")
}

enum NotificationStatus {
  pending
  sent
  failed
  read

  @@map("notification_status")
}

enum FeaturedType {
  feed
  search
  universe
  event

  @@map("featured_type")
}

enum DiscrepancyStatus {
  open
  resolved
  ignored

  @@map("discrepancy_status")
}

enum PreorderStatus {
  open
  threshold_reached
  expired
  refunded
  delivered

  @@map("preorder_status")
}

enum CommitmentStatus {
  committed
  converted
  cancelled
  refunded

  @@map("commitment_status")
}

enum WalletMovementType {
  credit_unboxing
  referral_credit
  spend
  reclaim

  @@map("wallet_movement_type")
}

enum WardrobeItemOrigin {
  jp_purchase
  manual

  @@map("wardrobe_item_origin")
}

enum GiftCartStatus {
  composed
  shared
  paid
  expired

  @@map("gift_cart_status")
}

enum ContentType {
  story
  clip
  photo
  unboxing

  @@map("content_type")
}

enum ContentStatus {
  draft
  published
  withdrawn

  @@map("content_status")
}

/// Le réglage par contenu, pas par compte (R-X2) : on n'ouvre pas les mêmes
/// commentaires sous une vente et sous un déballage.
enum CommentsOpen {
  everyone
  followers
  none

  @@map("comments_open")
}

enum InteractionType {
  view
  reaction
  comment
  share
  favorite

  @@map("interaction_type")
}

enum InteractionStatus {
  published
  auto_hidden
  author_hidden

  @@map("interaction_status")
}

enum DisputeReason {
  not_received
  damaged
  not_as_described
  wrong_size
  other

  @@map("dispute_reason")
}

enum OrderDisputeStatus {
  open
  discussing
  resolved

  @@map("order_dispute_status")
}

enum SizeFit {
  true_to_size
  runs_small
  runs_large

  @@map("size_fit")
}

/// Un signalement de menace traité comme le reste est un échec du produit, pas
/// un retard (R-X4).
enum ReportLevel {
  ordinary
  urgent

  @@map("report_level")
}

enum ReportStatus {
  new
  in_progress
  handled
  archived

  @@map("report_status")
}

enum SanctionType {
  warning
  removal
  restriction
  suspension
  ban

  @@map("sanction_type")
}

enum RepostStatus {
  to_review
  confirmed
  dismissed

  @@map("repost_status")
}

enum SaleOrigin {
  direct
  catalogue
  clip
  story
  event

  @@map("sale_origin")
}

enum ReservationStatus {
  active
  consumed
  expired
  cancelled
  queued

  @@map("reservation_status")
}

enum OrderStatus {
  draft
  awaiting_payment
  paid
  awaiting_threshold
  preparing
  shipped
  delivered
  confirmed
  cancelled
  refunded

  @@map("order_status")
}

enum DeliveryMode {
  home
  pickup_point

  @@map("delivery_mode")
}

/// Figé à la commande (R-B5) : changer de formule ne réécrit pas ce qui a
/// déjà été facturé.
enum PaymentTermsMode {
  subscription
  commission

  @@map("payment_terms_mode")
}

/// Un débit de l'acheteuse produit **1 à 3 crédits** (`DP-16`). `pivot` est
/// celui qui doit passer ; les `secondary` sont rejouables (R-M4, R-M5).
enum PaymentRank {
  pivot
  secondary

  @@map("payment_rank")
}

enum BeneficiaryType {
  shop
  jp
  creator

  @@map("beneficiary_type")
}

enum PaymentMethod {
  mvola
  orange
  airtel
  card

  @@map("payment_method")
}

enum PaymentStatus {
  initiated
  awaiting_operator
  confirmed
  failed
  expired
  refunded

  @@map("payment_status")
}

enum LedgerDirection {
  debit
  credit

  @@map("ledger_direction")
}

enum LedgerAccount {
  shop
  creator
  wallet
  jp_commission
  jp_subscription

  @@map("ledger_account")
}

/// **JP n'opère aucune logistique** (`DP-04`). Ces états sont ce que la
/// boutique déclare et ce que l'acheteur confirme — pas le trajet d'un colis.
enum ShipmentStatus {
  preparing
  shipped
  delivered
  confirmed

  @@map("shipment_status")
}

enum SubscriptionType {
  shop
  creator

  @@map("subscription_type")
}

enum LiveStatus {
  scheduled
  ongoing
  paused
  ended

  @@map("live_status")
}

enum MessageStatus {
  published
  hidden

  @@map("message_status")
}

/// Un événement JP rassemble plusieurs boutiques ; un événement de boutique
/// n'engage qu'elle (R-W8). La portée change qui peut y inscrire quoi.
enum EventScope {
  jp
  shop

  @@map("event_scope")
}

enum EventStatus {
  draft
  announced
  ongoing
  ended
  cancelled

  @@map("event_status")
}

enum ParticipationRole {
  shop
  creator

  @@map("participation_role")
}

enum ParticipationStatus {
  candidate
  accepted
  rejected
  auto_rejected

  @@map("participation_status")
}

enum PromotionType {
  percentage
  amount
  free_shipping

  @@map("promotion_type")
}

enum PromotionScope {
  shop
  category
  selection

  @@map("promotion_scope")
}

enum PromotionAudience {
  everyone
  followers
  loyalty_tier
  named_customers

  @@map("promotion_audience")
}

enum PromotionStatus {
  draft
  scheduled
  active
  ended
  cancelled

  @@map("promotion_status")
}

enum StockMovementType {
  intake
  sale
  return_movement
  adjustment
  expiration

  @@map("stock_movement_type")
}

enum QuestionStatus {
  published
  hidden

  @@map("question_status")
}

enum ArticleStatus {
  draft
  online
  hidden
  sold_out

  @@map("article_status")
}

enum SaleType {
  stock
  preorder

  @@map("sale_type")
}

/// Facultatif sur l'article. En direct, la vendeuse essaie le vêtement devant
/// la caméra — l'image dit l'état mieux qu'un énuméré. Hors direct, l'acheteuse
/// n'a que la fiche : la règle « état requis » s'applique alors à la
/// publication, pas à la colonne.
enum ClothingCondition {
  new_with_tags
  excellent
  good
  fair

  @@map("clothing_condition")
}

enum VerificationStatus {
  unverified
  pending
  verified
  rejected

  @@map("verification_status")
}

/// **`cin_recto`, `cin_verso` et `selfie` forment le dossier attendu.**
/// `nif_stat` reste possible et n'est jamais exigé : beaucoup de vendeuses
/// réelles n'ont ni NIF ni carte statistique, et l'exiger fermerait la
/// plateforme à celles pour qui elle est faite.
enum IdentityDocumentType {
  cin_recto
  cin_verso
  selfie
  nif_stat

  @@map("identity_document_type")
}

enum UserStatus {
  active
  suspended
  deleted

  @@map("user_status")
}

/// Le type dit comment lire `parametre.valeur`, qui est toujours du texte.
/// `pour_mille` existe séparément d'`entier` parce que 25 y signifie 2,5 %
/// et qu'un affichage naïf tromperait le vendeur.
enum SettingType {
  integer
  text
  boolean
  duration_s
  per_mille

  @@map("setting_type")
}

// ─────────────────────────────────────────────────────────────────────────
// User — R-C1, R-C15, RB6
// ─────────────────────────────────────────────────────────────────────────

model User {
  id String @id @default(uuid(7)) @db.Uuid

  /// L'identifiant du compte (R-C1). Unique, jamais réutilisable.
  email           String    @unique
  emailVerifiedAt DateTime? @map("email_verified_at") @db.Timestamptz(6)

  passwordHash String? @map("password_hash") // hashé jamais en clair

  /// Le téléphone n'est PLUS un identifiant : c'est un contact de
  /// livraison (R-C15). D'où le point d'interrogation — il peut être vide.
  phone           String?
  phoneVerifiedAt DateTime? @map("phone_verified_at") @db.Timestamptz(6)

  firstName String? @map("first_name")
  lastName  String? @map("last_name")
  photoUrl  String?  @map("photo_url")
  /// Français par défaut : c'est la language écrite courante à Madagascar.
  language  Language @default(fr)

  /// Oriente le fil de découverte. Jamais affiché publiquement, jamais
  /// obligatoire — une case imposée à l'inscription fait fuir.
  gender Gender? @map("gender")

  /// Requis pour publier une vidéo (RB6). Vide tant qu'on ne publie pas.
  birthDate DateTime? @map("birth_date") @db.Date

  /// **Empreinte Argon2id — jamais le mot de passe en clair** (R-C6).
  ///
  /// Nullable en base, et pourtant exigé à l'inscription : la colonne doit
  /// rester vide pour un compte ouvert par Google (`identite_externe`), qui
  /// n'a jamais choisi de mot de passe. `NOT NULL` rendrait cette voie
  /// impossible. La règle « tout compte a un mot de passe » se tient donc à
  /// l'inscription, pas dans le type de la colonne.
  passwordFingerprint String?   @map("password_fingerprint")
  passwordUpdatedAt   DateTime? @map("password_updated_at") @db.Timestamptz(6)

  status         UserStatus @default(active)
  publicRankings Boolean    @default(true) @map("public_rankings")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  /// `@default(now())` s'ajoute à `@updatedAt` : le second est tenu par le
  /// client Prisma, le premier par la base. Sans lui, un INSERT écrit à la main
  /// depuis psql échoue sur une colonne NOT NULL sans valeur par défaut.
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  buyerProfile            BuyerProfile?
  boutique                Shop?
  paniers                 Cart[]
  questionsPosees         ArticleQuestion[]
  alertesStock            StockAlert[]
  abonnementsSuivis       Follow[]             @relation("suiveur")
  abonnes                 Follow[]             @relation("suivi")
  messagesDirect          LiveStreamMessage[]
  evenementsPossedes      Event[]              @relation("proprietaire_evenement")
  participations          EventParticipation[] @relation("participant")
  participationsDecidees  EventParticipation[] @relation("decideur_participation")
  rappelsEvenement        EventReminder[]
  reservations            Reservation[]
  commandes               SalesOrder[]               @relation("acheteur")
  commandesGenerees       SalesOrder[]               @relation("createur_attribue")
  promotionsNominatives   PromotionBeneficiary[]
  evenementsLivraison     ShipmentEvent[]
  contenus                Content[]
  interactions            Interaction[]
  signalementsCommande    OrderDispute[]    @relation("ouvreur_signalement")
  messagesLitige          DisputeMessage[]
  avisEcrits              Review[]
  signalementsEmis        Report[]            @relation("signaleur")
  signalementsAffectes    Report[]            @relation("affecte_signalement")
  signalementsTraites     Report[]            @relation("traiteur_signalement")
  sanctionsSubies         Sanction[]               @relation("sanctionne")
  sanctionsAppliquees     Sanction[]               @relation("applicateur_sanction")
  blocagesEmis            UserBlock[]                @relation("bloqueur")
  blocagesSubis           UserBlock[]                @relation("bloque")
  motsBloques             BlockedWord[]
  clicsAffiliation        AffiliateClick[]
  rangsClient             CustomerRank[]
  notesClient             CustomerNote[]
  ventesConfirmees        ConfirmedSaleLog[]
  cagnotte                Wallet?
  mouvementsCagnotte      WalletMovement[]
  piecesDressing          WardrobeItem[]
  looks                   Look[]
  paniersCadeauComposes   GiftCart[]           @relation("compositrice")
  notifications           Notification[]
  compteursNotification   NotificationCounter[]
  preferencesNotification NotificationPreference[]
  adhesionClub            ClubMembership?
  liensPartage            ShareLink[]
  documentsIdentite       IdentityDocument[]
  identitesExternes       ExternalIdentity[]
  creatorProfile          CreatorProfile?
  membresEquipe           TeamMember[]
  adresses                Address[]
  demandesVerification    VerificationRequest[]    @relation("demandeur")
  verificationsDecidees   VerificationRequest[]    @relation("decideur_verification")
  recuperationsCiblees    PasswordRecoveryRequest[]    @relation("cible_recuperation")
  recuperationsDecidees   PasswordRecoveryRequest[]    @relation("decideur_recuperation")
  demandesChangementEmail EmailChangeRequest[]
  sessions                Session[]
  journauxAudit           AuditLog[]
  parametresModifies      Setting[]
  modificationsProposees  ParametreModification[]  @relation("propose")
  modificationsConfirmees ParametreModification[]  @relation("confirme")

  @@map("app_user")
}

/// Ce qui personnalise le fil. **Tout y est facultatif** — la table entière
/// peut ne pas exister pour un compte.
///
/// Sauter la question à l'inscription et répondre « aucune préférence » sont
/// deux faits différents : le premier ne crée pas de ligne, le second crée une
/// ligne au tableau vide.
model BuyerProfile {
  /// La clé primaire EST la clé étrangère : un compte, au plus un profil.
  /// La contrainte est structurelle — aucune ligne de code ne peut la violer.
  ///
  /// `Restrict` et non `Cascade` : on ne supprime jamais un compte
  /// physiquement, donc la cascade ne se déclencherait jamais. `Restrict`
  /// transforme un `DELETE` accidentel en erreur bruyante plutôt qu'en
  /// effacement silencieux.
  user   User   @relation(fields: [userId], references: [id], onDelete: Restrict)
  userId String @id @map("user_id") @db.Uuid

  /// Les types de vêtements préférés — `robe`, `jean`, `jupe`… Trois au plus,
  /// borné par un CHECK écrit à la main dans la migration.
  ///
  /// Du texte et non un énuméré : cette liste est une **taxonomie**, dont la
  /// place définitive est la table `categorie`. Figer un énuméré maintenant
  /// imposerait une migration à chaque catégorie ajoutée.
  clothingPreferences String[] @default([]) @map("clothing_preferences")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("buyer_profile")
}

// ─────────────────────────────────────────────────────────────────────────
// Shop et pièces d'identité — DP-01, DP-07
// ─────────────────────────────────────────────────────────────────────────

/// La boutique. **C'est la table qui décide si un article peut être mis en
/// vente** — `statutVerification` en est le verrou (`DP-07`).
///
/// **Pas de `typeBoutique`** : il distinguait `boutique` de `particulier`, et
/// le vendeur particulier n'existe plus (`DP-01`). Un attribut supprimé est
/// plus sûr qu'un attribut dont une seule valeur reste utilisée.
model Shop {
  id String @id @default(uuid(7)) @db.Uuid

  /// `@unique` : un compte, au plus une boutique (`DP-02`).
  user   User   @relation(fields: [userId], references: [id], onDelete: Restrict)
  userId String @unique @map("user_id") @db.Uuid

  name String
  /// Dans les URL publiques. Ne change pas sans redirection.
  slug String @unique

  /// **Le logo.** Facultatif : une boutique ouvre avant d'avoir une image, et
  /// bloquer l'ouverture sur un fichier manquant coûterait des vendeuses.
  /// L'affichage retombe sur l'initiale du nom.
  logoUrl String? @map("logo_url")

  verificationStatus VerificationStatus @default(unverified) @map("verification_status")

  /// Le numéro vérifié — **seule destination possible d'un crédit** (`DP-16`).
  mobileMoneyMsisdn String? @map("mobile_money_msisdn")

  /// La boutique accepte-t-elle les créatrices ? (R-N3)
  affiliationAllowed    Boolean @default(false) @map("affiliation_allowed")
  /// Le taux offert aux créatrices, **sur son prix** (`DP-09`, R-N4). Connu de
  /// la créatrice AVANT qu'elle attache l'article.
  creatorCommissionRate Int     @default(0) @map("creator_commission_rate")

  /// Gel automatique au-delà du seuil de signalements (R-T8). *(Anciennement
  /// `encaissement_gele` — il n'y a plus d'encaissement à geler, `DP-07`.)*
  salesFrozen Boolean @default(false) @map("sales_frozen")

  /// **Dénormalisés**, remis à zéro au cycle. Portent les quotas de R-B4.
  monthlySales       Int @default(0) @map("monthly_sales")
  monthlyLiveStreams Int @default(0) @map("monthly_live_streams")

  /// Public, calculé sur des faits. **Devenue la seule protection de
  /// l'acheteuse** (`DP-07`) — il n'y a plus ni séquestre ni arbitre.
  trustScore           Decimal @default(0) @map("trust_score") @db.Decimal(4, 2)
  reportRate           Decimal @default(0) @map("report_rate") @db.Decimal(5, 4)
  /// **Dénormalisé**, tâche quotidienne — affiché AVANT achat (F5.9).
  averageShippingDelay Int?    @map("average_shipping_delay")
  /// **Dénormalisé** — abonnés au sens social, pas l'abonnement payant.
  followersCount       Int     @default(0) @map("followers_count")
  loyaltyEnabled       Boolean @default(false) @map("loyalty_enabled")

  /// Suppression douce. `NULL` = vivante. Aucun `DELETE` n'est jamais émis :
  /// une boutique supprimée garde ses commandes, ses avis et ses litiges.
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  articles         Article[]
  extraits         ShopSnippet[]
  membres          TeamMember[]
  directs          LiveStream[]
  paliers          LoyaltyTier[]
  promotions       Promotion[]
  lignesVendues    OrderLine[]
  tarifs           DeliveryRate[]
  expeditions      Shipment[]
  avis             Review[]
  score            TrustScore?
  rangsClient      CustomerRank[]
  notesClient      CustomerNote[]
  ventesConfirmees ConfirmedSaleLog[]
  abonnements      ShopSubscription[]
  misesEnAvant     Featured[]
  agregats         ShopAggregate[]

  @@index([verificationStatus])
  @@map("shop")
}

/// Les pièces du dossier de vérification.
///
/// `urlChiffree` est **chiffrée au repos** (R-V5) : ce sont des pièces
/// d'identité, et une fuite de cette table serait une fuite d'identités, pas
/// un incident technique.
model IdentityDocument {
  id String @id @default(uuid(7)) @db.Uuid

  user   User   @relation(fields: [userId], references: [id], onDelete: Restrict)
  userId String @map("user_id") @db.Uuid

  type        IdentityDocumentType
  urlChiffree String               @map("url_chiffree")
  /// Empreinte SHA-256 du fichier : détecte le même document redéposé sous
  /// deux comptes.
  empreinte   String

  creeLe DateTime @default(now()) @map("cree_le") @db.Timestamptz(6)

  /// Une pièce de chaque type par personne. Redéposer remplace la ligne au
  /// lieu d'en empiler une seconde.
  @@unique([userId, type])
  @@map("identity_document")
}

// ─────────────────────────────────────────────────────────────────────────
// Paramètres — R-O1
// ─────────────────────────────────────────────────────────────────────────

/// Tous les réglages économiques : durée de réservation, taux de commission,
/// délais, plafonds. Modifiables sans déploiement — sinon aucun essai n'a
/// lieu pendant le pilote.
model Setting {
  cle         String        @id
  valeur      String
  type        SettingType
  description String

  modifiePar   User?    @relation(fields: [modifieParId], references: [id], onDelete: SetNull)
  modifieParId String?  @map("modifie_par_id") @db.Uuid
  modifieLe    DateTime @default(now()) @map("modifie_le") @db.Timestamptz(6)

  modifications ParametreModification[]

  @@map("setting")
}

/// Double validation : proposé par l'un, confirmé par l'autre.
/// Personne ne change seul un taux de commission.
model ParametreModification {
  id  String @id @default(uuid(7)) @db.Uuid
  cle String

  parametre      Setting @relation(fields: [cle], references: [cle], onDelete: Cascade)
  ancienneValeur String    @map("ancienne_valeur")
  nouvelleValeur String    @map("nouvelle_valeur")
  motif          String

  proposePar   User     @relation("propose", fields: [proposeParId], references: [id])
  proposeParId String   @map("propose_par_id") @db.Uuid
  proposeLe    DateTime @default(now()) @map("propose_le") @db.Timestamptz(6)

  /// `Restrict` et non `SetNull` : on n'efface pas la trace de qui a validé un
  /// changement de taux de commission. Un compte se ferme par
  /// `statut = supprime`, jamais par DELETE.
  confirmePar   User?     @relation("confirme", fields: [confirmeParId], references: [id], onDelete: Restrict)
  confirmeParId String?   @map("confirme_par_id") @db.Uuid
  confirmeLe    DateTime? @map("confirme_le") @db.Timestamptz(6)

  @@index([cle, proposeLe])
  @@map("setting_change")
}

// ─────────────────────────────────────────────────────────────────────────
// Journal d'audit — D3, R-V5, N3.4
// ─────────────────────────────────────────────────────────────────────────

/// AJOUT SEUL. La garantie n'est pas ici — elle est dans la migration,
/// sous forme de REVOKE. Prisma ne sait pas l'exprimer.
model AuditLog {
  id String @id @default(uuid(7)) @db.Uuid

  /// `Restrict` et non `SetNull` : voir l'explication sous ce bloc.
  actor   User?   @relation(fields: [actorId], references: [id], onDelete: Restrict)
  actorId String? @map("actor_id") @db.Uuid

  action     String
  targetType String  @map("target_type")
  targetId   String? @map("target_id")

  before Json?
  after  Json?

  ipAddress  String?  @map("ip_address") @db.Inet
  occurredAt DateTime @default(now()) @map("occurred_at") @db.Timestamptz(6)

  @@index([targetType, targetId, occurredAt])
  @@index([actorId, occurredAt])
  @@map("audit_log")
}

// ─────────────────────────────────────────────────────────────────────────
// Plateforme — S3
// ─────────────────────────────────────────────────────────────────────────

/// Les clés d'idempotence — **RB10**.
///
/// Une écriture financière interrompue ne doit produire ni double
/// prélèvement, ni commande perdue. Le client fabrique une clé, la renvoie
/// s'il réessaie, et le serveur reconnaît le rejeu.
///
/// `empreinteRequete` garde contre le pire cas : la même clé réutilisée pour
/// une requête DIFFÉRENTE. Sans elle, un client bogué pourrait recevoir la
/// réponse d'une commande pour une autre.
model IdempotencyKey {
  key String @id

  userId             String? @map("user_id") @db.Uuid
  method             String  @map("method")
  path               String
  /// Empreinte SHA-256 du corps de la requête.
  requestFingerprint String  @map("request_fingerprint")

  /// `NULL` tant que la requête est EN COURS. C'est ce qui permet de
  /// distinguer « rejeu d'une requête terminée » de « deux requêtes
  /// simultanées avec la même clé ».
  status   Int?
  response Json?

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  expiresAt DateTime @map("expires_at") @db.Timestamptz(6)

  @@index([expiresAt])
  @@map("idempotency_key")
}

/// Une session ouverte, sur un appareil.
///
/// Le jeton n'est **jamais** stocké en clair : seule son empreinte l'est. Une
/// fuite de la base ne donne donc pas de session utilisable.
///
/// `famille` porte la chaîne de rotation. Quand un jeton de rafraîchissement
/// déjà consommé réapparaît, c'est le signe d'un vol : on révoque **toute la
/// famille**, pas seulement le jeton présenté *(F0.2)*.
model Session {
  id String @id @default(uuid(7)) @db.Uuid

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String @map("user_id") @db.Uuid

  tokenHash String @unique @map("token_hash")
  family    String @db.Uuid

  device    String?
  ipAddress String? @map("ip_address") @db.Inet

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(6)

  @@index([userId, expiresAt])
  @@index([family])
  @@map("session")
}

// ─────────────────────────────────────────────────────────────────────────
// Les univers — JP Mode, JP Beauté, JP Tech
// ─────────────────────────────────────────────────────────────────────────

/// **Un univers n'est pas un filtre de catégorie, c'est un jeu de règles.**
///
/// Entre une robe et un téléphone, ce qui change n'est pas l'étagère : c'est la
/// fiche article, le mode de livraison, les motifs de litige recevables, le
/// taux de commission et la vérification exigée du vendeur.
///
/// Les règles vivent dans `packages/contracts/src/univers.ts` — le code, pas la
/// base. Cette table porte ce qui doit être **modifiable sans déploiement**
/// pendant le pilote : l'ouverture et le taux de commission.
///
/// **Trois univers, et pas d'autre.** Mode et Beauté ouverts, Tech déclaré avec
/// `ouvert = false`. C'est délibéré : l'abstraction est construite maintenant,
/// l'ouverture est un `UPDATE`.
///
/// Les trois partagent la même livraison — point relais et domicile. C'est ce
/// qui rend l'application identique dans les trois : ce qui varie n'est pas le
/// parcours, ce sont trois listes.
model Universe {
  /// Ne change JAMAIS : il est dans les URL et les lignes de commande.
  key String @id

  name      String
  signature String
  tab       String

  /// Un univers fermé garde ses règles et n'apparaît nulle part.
  isOpen Boolean @default(false) @map("is_open")

  /// En pour mille. 80 = 8 %. Modifiable sans déploiement — c'est le levier
  /// économique du pilote, et il diffère fortement d'un univers à l'autre.
  commissionPerMille Int @map("commission_per_mille")

  /// Ordre d'affichage des onglets.
  rank Int @default(0)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  articles Article[]

  @@index([isOpen, rank])
  @@map("universe")
}

// ─────────────────────────────────────────────────────────────────────────
// Catalogue — R-H4, F1.14, R-Y1
// ─────────────────────────────────────────────────────────────────────────

/// Ce qui est à vendre.
///
/// **Toutes les caractéristiques physiques sont facultatives en base.** En
/// direct, la vendeuse essaie le vêtement devant la caméra et l'image remplace
/// la fiche ; exiger les mesures fermerait le direct à celle qui ne les connaît
/// pas. L'exigence porte donc sur la **publication hors direct**, où
/// l'acheteuse n'a que la fiche pour décider — une règle applicative, pas un
/// `NOT NULL`.
model Article {
  id String @id @default(uuid(7)) @db.Uuid

  shop       Shop @relation(fields: [shopId], references: [id], onDelete: Restrict)
  shopId String   @map("shop_id") @db.Uuid

  /// **Immuable** (R-Y1) : changer l'univers changerait les règles de litige et
  /// la commission APRÈS une commande.
  universe    Universe @relation(fields: [universeKey], references: [key], onDelete: Restrict)
  universeKey String   @map("universe_key")

  name        String
  description String?

  /// **Entiers en Ariary, jamais de flottant** (D6).
  priceAriary         Int  @map("price_ariary")
  originalPriceAriary Int? @map("original_price_ariary")

  status   ArticleStatus @default(draft)
  saleType SaleType      @default(stock) @map("sale_type")

  /// Un seul exemplaire (F1.14) : pas de sélecteur de quantité, une seule
  /// réservation possible. **Le moteur d'urgence naturel du direct** — et la
  /// rareté affichée doit être vraie (RB9).
  oneOfAKind Boolean @default(false) @map("one_of_a_kind")

  /// Facultatifs — voir le commentaire du modèle.
  clothingCondition ClothingCondition? @map("clothing_condition")
  /// Épaules, poitrine, taille, longueur (R-H4). **Sans essayage, les mesures
  /// remplacent le fait de toucher le vêtement.**
  measurements    Json?              @map("measurements")
  /// Dénormalisé : sert le tri par pertinence, sans lire le JSON.
  hasMeasurements Boolean            @default(false) @map("has_measurements")

  category   Category? @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  categoryId String?   @map("category_id") @db.Uuid

  brand    String?
  material String?

  /// Les champs propres à l'univers — contenance et INCI pour Beauté, garantie
  /// et compatibilité pour Tech. Un `jsonb` plutôt que trente colonnes vides :
  /// la fiche varie par univers, la table non.
  attributes Json?

  /// JP Beauté. **Colonne ordinaire et non générée** : PostgreSQL sait la
  /// calculer, mais Prisma ne sait pas la déclarer, et une colonne ajoutée à la
  /// main ferait dériver le schéma à chaque migration suivante. Elle est donc
  /// tenue par l'application, et vérifiée **à la publication et à l'achat** —
  /// un article périme en stock (R-Y13).
  expiryDate DateTime? @map("expiry_date") @db.Date

  pinned           Boolean @default(false)
  showcasePosition Int     @default(0) @map("showcase_position")

  livePurchaseEnabled Boolean @default(true) @map("live_purchase_enabled")

  /// Suppression douce. Un article retiré reste lisible depuis les commandes
  /// passées : sans lui, une facture perdrait son libellé.
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  variantes      Variant[]
  questions      ArticleQuestion[]
  directs        LiveStreamArticle[]
  contenus       ContentArticle[]
  avis           Review[]
  selections     SelectionArticle[]
  clics          AffiliateClick[]
  precommande    Preorder?
  piecesDressing WardrobeItem[]
  aLecranDans    LiveStream[]           @relation("article_a_lecran")

  @@index([shopId, status])
  @@index([expiryDate])
  @@index([universeKey, status])
  @@map("article")
}

/// La déclinaison vendable — c'est elle qui porte le stock, jamais l'article.
model Variant {
  id String @id @default(uuid(7)) @db.Uuid

  article   Article @relation(fields: [articleId], references: [id], onDelete: Restrict)
  articleId String  @map("article_id") @db.Uuid

  /// **`taille_unique` et non `NULL`.** La taille fait partie de la clé
  /// unique, et `NULL` n'est jamais égal à `NULL` en SQL : deux variantes sans
  /// taille passeraient toutes les deux la contrainte d'unicité et le stock se
  /// dédoublerait. « Non renseignée » est donc une valeur explicite.
  taille  String @default("taille_unique")
  couleur String @default("")

  sku String?

  /// **LA vérité** (D2). Aucune autre table ne dit ce qui reste.
  stockQuantity    Int @default(0) @map("stock_quantity")
  /// `CHECK (>= 0)` et `CHECK (<= stock_quantity)` — le dernier filet contre la
  /// survente, même en cas de bogue applicatif.
  reservedQuantity Int @default(0) @map("reserved_quantity")
  alertThreshold   Int @default(0) @map("alert_threshold")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  lignesPanier CartLine[]

  mouvements     StockMovement[]
  alertes        StockAlert[]
  reservations   Reservation[]
  lignesCommande OrderLine[]

  @@unique([articleId, taille, couleur])
  @@map("variant")
}

// ─────────────────────────────────────────────────────────────────────────
// Cart hors direct — D7 révisé
// ─────────────────────────────────────────────────────────────────────────

/// Le panier de la vente **hors direct**.
///
/// **Il ne détient AUCUNE vérité sur le stock.** `D7` interdisait une table
/// `panier` précisément pour ça : deux sources de vérité sur ce qui est
/// réservé, donc un risque de survente. L'interdit tient toujours — ce qui est
/// levé, c'est seulement l'idée que le panier ne pouvait pas exister du tout.
///
/// La règle : une ligne de panier est une **intention d'achat** qui ne tient
/// rien. Le stock n'est bloqué qu'au passage en caisse, par une `reservation`,
/// et c'est là seulement qu'un article peut manquer. En direct, rien ne change :
/// on réserve immédiatement, sans panier.
model Cart {
  id String @id @default(uuid(7)) @db.Uuid

  user   User   @relation(fields: [userId], references: [id], onDelete: Restrict)
  userId String @map("user_id") @db.Uuid

  status CartStatus @default(active)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  lignes CartLine[]

  @@index([userId, status])
  @@map("cart")
}

/// Une intention d'achat. **Ne bloque rien.**
model CartLine {
  id String @id @default(uuid(7)) @db.Uuid

  cart   Cart   @relation(fields: [cartId], references: [id], onDelete: Restrict)
  cartId String @map("cart_id") @db.Uuid

  variant   Variant @relation(fields: [variantId], references: [id], onDelete: Restrict)
  variantId String  @map("variant_id") @db.Uuid

  quantity Int @default(1)

  addedAt DateTime @default(now()) @map("added_at") @db.Timestamptz(6)

  /// Rajouter le même article augmente la quantité au lieu d'empiler une
  /// seconde ligne.
  @@unique([cartId, variantId])
  @@map("cart_line")
}

// ─────────────────────────────────────────────────────────────────────────
// Extraits et annonces avant le direct
// ─────────────────────────────────────────────────────────────────────────

/// La vidéo courte publiée avant un direct : montrer les articles, faire de la
/// publicité, annoncer une surprise.
///
/// Elle n'est **pas** rattachée à un direct : elle existe avant lui, et elle
/// survit s'il est annulé. Le lien vers `direct` viendra avec le domaine
/// LiveStream, en colonne facultative.
model ShopSnippet {
  id String @id @default(uuid(7)) @db.Uuid

  shop       Shop @relation(fields: [shopId], references: [id], onDelete: Restrict)
  shopId String   @map("shop_id") @db.Uuid

  type    SnippetType @default(excerpt)
  titre   String?
  legende String?

  videoUrl   String  @map("video_url")
  /// L'image fixe affichée avant lecture. Sur un réseau lent, c'est elle qu'on
  /// voit — souvent la seule chose qu'on verra.
  afficheUrl String? @map("affiche_url")
  dureeS     Int?    @map("duree_s")

  /// `NULL` = brouillon, jamais montré.
  /// Le direct annoncé, s'il y en a un. **Facultatif** : l'extrait existe
  /// avant lui, et il survit s'il est annulé.
  direct   LiveStream? @relation(fields: [directId], references: [id], onDelete: SetNull)
  directId String? @map("live_stream_id") @db.Uuid

  publieLe   DateTime? @map("publie_le") @db.Timestamptz(6)
  supprimeLe DateTime? @map("supprime_le") @db.Timestamptz(6)

  creeLe DateTime @default(now()) @map("cree_le") @db.Timestamptz(6)
  majLe  DateTime @default(now()) @updatedAt @map("maj_le") @db.Timestamptz(6)

  @@index([shopId, publieLe])
  @@map("shop_snippet")
}

// ─────────────────────────────────────────────────────────────────────────
// Identité — le reste du domaine (F0.1, F0.13, F0.4, F0.6)
// ─────────────────────────────────────────────────────────────────────────

/// Le code à 6 chiffres d'entrée. **S'ajoute au mot de passe, ne le remplace
/// plus.**
///
/// Pas de clé étrangère vers `utilisateur` : une demande de code est écrite
/// AVANT que le compte existe. C'est ce qui rend la réponse identique pour une
/// adresse connue et inconnue — sinon l'écran d'entrée devient un annuaire des
/// personnes inscrites (R-C9).
model OtpCode {
  id String @id @default(uuid(7)) @db.Uuid

  email    String
  /// **Haché** (R-C6). Une fuite de cette table ne doit pas être une fuite de
  /// comptes.
  codeHash String @map("code_hash")
  /// Compteur de saisie. **En base et non dans Redis** : il doit être
  /// transactionnel avec la vérification.
  attempts Int    @default(0)

  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(6)
  consumedAt DateTime? @map("consumed_at") @db.Timestamptz(6)
  ipAddress  String?   @map("ip_address") @db.Inet

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([email, expiresAt])
  @@map("otp_code")
}

/// Le rattachement à un compte Google (F0.13).
model ExternalIdentity {
  id String @id @default(uuid(7)) @db.Uuid

  user   User   @relation(fields: [userId], references: [id], onDelete: Restrict)
  userId String @map("user_id") @db.Uuid

  fournisseur  ExternalProvider
  /// L'identifiant **stable** du fournisseur (R-C12). Surtout pas l'adresse
  /// électronique : elle change, et le compte suivrait le mauvais sujet.
  sujetExterne String           @map("sujet_externe")
  emailVerifie Boolean          @default(false) @map("email_verifie")

  creeLe DateTime @default(now()) @map("cree_le") @db.Timestamptz(6)

  @@unique([fournisseur, sujetExterne])
  @@map("external_identity")
}

/// La créatrice : audience, palier, ventes générées. **Vendre sans capital.**
model CreatorProfile {
  id String @id @default(uuid(7)) @db.Uuid

  user   User   @relation(fields: [userId], references: [id], onDelete: Restrict)
  userId String @unique @map("user_id") @db.Uuid

  publicName String @map("public_name")
  slug       String @unique
  reseaux    Json?

  verificationStatus VerificationStatus @default(unverified) @map("verification_status")
  palier             Int                @default(0)
  verifiedBadge      Boolean            @default(false) @map("verified_badge")

  /// **Dénormalisés.**
  followersCount      Int @default(0) @map("followers_count")
  generatedSalesCount Int @default(0) @map("generated_sales_count")

  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  selections   Selection[]
  clics        AffiliateClick[]
  precommandes Preorder[]

  @@map("creator_profile")
}

/// Une boutique tenue à plusieurs mains.
model TeamMember {
  id String @id @default(uuid(7)) @db.Uuid

  shop       Shop @relation(fields: [shopId], references: [id], onDelete: Restrict)
  shopId String   @map("shop_id") @db.Uuid

  user   User   @relation(fields: [userId], references: [id], onDelete: Restrict)
  userId String @map("user_id") @db.Uuid

  role TeamRole @default(fulfiller)

  creeLe DateTime @default(now()) @map("cree_le") @db.Timestamptz(6)

  @@unique([shopId, userId])
  @@map("team_member")
}

/// Le dossier de vérification d'une boutique — **le verrou de la mise en
/// vente** (`DP-07`).
model VerificationRequest {
  id String @id @default(uuid(7)) @db.Uuid

  demandeur   User   @relation("demandeur", fields: [demandeurId], references: [id], onDelete: Restrict)
  demandeurId String @map("demandeur_id") @db.Uuid

  statut        RequestState @default(pending)
  motifDecision String?     @map("motif_decision")

  /// `Restrict` : on n'efface pas la trace de qui a vérifié une identité.
  decidePar   User?     @relation("decideur_verification", fields: [decideParId], references: [id], onDelete: Restrict)
  decideParId String?   @map("decide_par_id") @db.Uuid
  decideLe    DateTime? @map("decide_le") @db.Timestamptz(6)

  creeLe DateTime @default(now()) @map("cree_le") @db.Timestamptz(6)

  @@index([statut, creeLe])
  @@map("verification_request")
}

/// « J'ai perdu l'accès à mon adresse électronique. »
///
/// `numero` est **lisible et prononçable** : la personne le donne au support
/// par téléphone, souvent depuis un autre appareil que le sien.
model PasswordRecoveryRequest {
  id     String @id @default(uuid(7)) @db.Uuid
  numero String @unique

  userTarget   User   @relation("cible_recuperation", fields: [userTargetId], references: [id], onDelete: Restrict)
  userTargetId String @map("utilisateur_cible_id") @db.Uuid

  emailAncien   String      @map("email_ancien")
  emailNouveau  String      @map("email_nouveau")
  statut        RequestState @default(pending)
  motifDecision String?     @map("motif_decision")

  decidePar   User?     @relation("decideur_recuperation", fields: [decideParId], references: [id], onDelete: Restrict)
  decideParId String?   @map("decide_par_id") @db.Uuid
  decideLe    DateTime? @map("decide_le") @db.Timestamptz(6)

  creeLe DateTime @default(now()) @map("cree_le") @db.Timestamptz(6)

  @@index([statut, creeLe])
  @@map("password_recovery_request")
}

/// Changer d'adresse en deux temps : l'ancienne confirme, puis la nouvelle.
/// Une seule étape suffirait à voler un compte dont la session est ouverte.
model EmailChangeRequest {
  id String @id @default(uuid(7)) @db.Uuid

  user   User   @relation(fields: [userId], references: [id], onDelete: Restrict)
  userId String @map("user_id") @db.Uuid

  nouvelEmail String          @map("nouvel_email")
  etape       EmailChangeStep @default(old_verified)
  expireLe    DateTime        @map("expire_le") @db.Timestamptz(6)

  creeLe DateTime @default(now()) @map("cree_le") @db.Timestamptz(6)

  @@index([userId, expireLe])
  @@map("email_change_request")
}

/// Une adresse de livraison. **Pas de code postal** (R-L2) : il n'est pas
/// utilisé à Madagascar, et un champ obligatoire vide se remplit de « 000 ».
/// Ce sont `quartier` et `reperes` qui font arriver le colis.
model Address {
  id String @id @default(uuid(7)) @db.Uuid

  user   User   @relation(fields: [userId], references: [id], onDelete: Restrict)
  userId String @map("user_id") @db.Uuid

  libelle               String
  quartier              String
  reperes               String?
  /// Le téléphone du destinataire, qui n'est pas forcément le titulaire du
  /// compte (R-C15) — un foyer partage un numéro.
  telephoneDestinataire String? @map("telephone_destinataire")

  supprimeeLe DateTime? @map("supprimee_le") @db.Timestamptz(6)
  creeLe      DateTime  @default(now()) @map("cree_le") @db.Timestamptz(6)
  majLe       DateTime  @default(now()) @updatedAt @map("maj_le") @db.Timestamptz(6)

  commandes SalesOrder[]

  @@index([userId])
  @@map("address")
}

// ─────────────────────────────────────────────────────────────────────────
// Catalogue — classement, traçabilité du stock, questions (F1.4, F1.1)
// ─────────────────────────────────────────────────────────────────────────

/// L'arborescence de classement. Récursive : une catégorie a un parent
/// facultatif, et le même modèle sert les trois univers.
model Category {
  id String @id @default(uuid(7)) @db.Uuid

  parent   Category?  @relation("arborescence", fields: [parentId], references: [id], onDelete: Restrict)
  parentId String?    @map("parent_id") @db.Uuid
  enfants  Category[] @relation("arborescence")

  nameFr   String @map("name_fr")
  nameEn   String @map("name_en")
  position Int    @default(0)

  articles Article[]

  @@index([parentId, position])
  @@map("category")
}

/// **Toute variation de `quantite_stock` produit un mouvement.** C'est la seule
/// façon d'expliquer un écart trois semaines plus tard — et sans elle, un stock
/// faux ne se distingue pas d'un stock volé.
model StockMovement {
  id String @id @default(uuid(7)) @db.Uuid

  variant   Variant @relation(fields: [variantId], references: [id], onDelete: Restrict)
  variantId String  @map("variant_id") @db.Uuid

  type          StockMovementType
  /// Signé : négatif pour une vente, positif pour une entrée.
  quantityDelta Int                @map("quantity_delta")
  reference     String?
  authorId      String?            @map("author_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([variantId, createdAt])
  @@map("mouvement_stock")
}

/// Les questions publiques sous une fiche. Publiques et non privées : la
/// réponse sert aussi aux suivantes.
model ArticleQuestion {
  id String @id @default(uuid(7)) @db.Uuid

  article   Article @relation(fields: [articleId], references: [id], onDelete: Restrict)
  articleId String  @map("article_id") @db.Uuid

  author   User   @relation(fields: [authorId], references: [id], onDelete: Restrict)
  authorId String @map("author_id") @db.Uuid

  text      String
  replyText String?        @map("reply_text")
  status    QuestionStatus @default(published)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([articleId, status, createdAt])
  @@map("article_question")
}

/// « Prévenez-moi quand ça revient. » Clé primaire composite : une alerte par
/// personne et par variante, sans ligne en double possible.
model StockAlert {
  variant   Variant @relation(fields: [variantId], references: [id], onDelete: Restrict)
  variantId String  @map("variant_id") @db.Uuid

  user   User   @relation(fields: [userId], references: [id], onDelete: Restrict)
  userId String @map("user_id") @db.Uuid

  notifiedAt DateTime? @map("notified_at") @db.Timestamptz(6)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@id([variantId, userId])
  @@map("stock_alert")
}

// ─────────────────────────────────────────────────────────────────────────
// Couche sociale et direct (F7.1, F2.3)
// ─────────────────────────────────────────────────────────────────────────

/// Suivre une boutique ou une créatrice. Clé primaire composite : on ne peut
/// pas suivre deux fois la même personne, la base l'interdit.
model Follow {
  follower   User   @relation("suiveur", fields: [followerId], references: [id], onDelete: Restrict)
  followerId String @map("follower_id") @db.Uuid

  followed   User   @relation("suivi", fields: [followedId], references: [id], onDelete: Restrict)
  followedId String @map("followed_id") @db.Uuid

  type               SubscriptionType
  /// Réglage **par boutique** et non global (R-Q6) : couper les promotions
  /// d'une boutique bavarde ne doit pas couper celles des autres.
  promoNotifications Boolean @default(true) @map("promo_notifications")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@id([followerId, followedId])
  @@index([followedId, createdAt])
  @@map("follow")
}

/// La diffusion en direct.
model LiveStream {
  id String @id @default(uuid(7)) @db.Uuid

  shop       Shop @relation(fields: [shopId], references: [id], onDelete: Restrict)
  shopId String   @map("shop_id") @db.Uuid

  title     String
  posterUrl String?    @map("poster_url")
  status    LiveStatus @default(scheduled)

  scheduledStartAt DateTime  @map("scheduled_start_at") @db.Timestamptz(6)
  startedAt        DateTime? @map("started_at") @db.Timestamptz(6)
  endedAt          DateTime? @map("ended_at") @db.Timestamptz(6)

  ingestRef    String? @map("ingest_ref")
  playbackUrl  String? @map("playback_url")
  recordingUrl String? @map("recording_url")

  /// L'article montré à l'instant. C'est lui qui pilote le « Je prends ».
  onscreenArticle   Article? @relation("article_a_lecran", fields: [onscreenArticleId], references: [id], onDelete: SetNull)
  onscreenArticleId String?  @map("onscreen_article_id") @db.Uuid

  peakViewerCount     Int     @default(0) @map("peak_viewer_count")
  facebookRebroadcast Boolean @default(false) @map("facebook_rebroadcast")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  articles     LiveStreamArticle[]
  messages     LiveStreamMessage[]
  reservations Reservation[]
  commandes    SalesOrder[]
  bilan        LiveStreamReport?
  extraits     ShopSnippet[]

  @@index([shopId, scheduledStartAt])
  @@index([status, scheduledStartAt])
  @@map("live_stream")
}

/// Les articles préparés pour un direct.
model LiveStreamArticle {
  liveStream   LiveStream @relation(fields: [liveStreamId], references: [id], onDelete: Restrict)
  liveStreamId String     @map("live_stream_id") @db.Uuid

  article   Article @relation(fields: [articleId], references: [id], onDelete: Restrict)
  articleId String  @map("article_id") @db.Uuid

  position   Int       @default(0)
  /// **Rend le replay achetable gratuit** (F2.16) : les marqueurs à la minute
  /// sont produits par l'usage, sans aucune saisie manuelle.
  onscreenAt DateTime? @map("onscreen_at") @db.Timestamptz(6)

  @@id([liveStreamId, articleId])
  @@map("live_stream_article")
}

model LiveStreamMessage {
  id String @id @default(uuid(7)) @db.Uuid

  liveStream   LiveStream @relation(fields: [liveStreamId], references: [id], onDelete: Restrict)
  liveStreamId String     @map("live_stream_id") @db.Uuid

  author   User   @relation(fields: [authorId], references: [id], onDelete: Restrict)
  authorId String @map("author_id") @db.Uuid

  text      String
  status    MessageStatus @default(published)
  pinned    Boolean       @default(false)
  /// Message posté par le système — « il reste 2 pièces » (F12.2).
  automated Boolean       @default(false)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([liveStreamId, createdAt])
  @@map("live_stream_message")
}

/// Le bilan d'un direct. `unsoldArticles` est le signal le plus utile :
/// un article montré et jamais pris est presque toujours un prix trop haut.
model LiveStreamReport {
  liveStream   LiveStream @relation(fields: [liveStreamId], references: [id], onDelete: Restrict)
  liveStreamId String     @id @map("live_stream_id") @db.Uuid

  durationS       Int     @default(0) @map("duration_s")
  uniqueViewers   Int     @default(0) @map("unique_viewers")
  peakAudience    Int     @default(0) @map("peak_audience")
  soldCount       Int     @default(0) @map("sold_count")
  revenue         Int     @default(0)
  conversionRate  Decimal @default(0) @map("conversion_rate") @db.Decimal(5, 4)
  expiredCount    Int     @default(0) @map("expired_count")
  unsoldArticles  Json?   @map("unsold_articles")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("live_stream_report")
}

// ─────────────────────────────────────────────────────────────────────────
// Événements (F20.1)
// ─────────────────────────────────────────────────────────────────────────

model Event {
  id String @id @default(uuid(7)) @db.Uuid

  scope   EventScope @default(shop)
  /// `NULL` quand la portée est `jp` : l'événement appartient à la plateforme.
  owner   User?      @relation("proprietaire_evenement", fields: [ownerId], references: [id], onDelete: Restrict)
  ownerId String?    @map("owner_id") @db.Uuid

  name        String
  theme       String?
  slug        String  @unique
  visualUrl   String? @map("visual_url")
  accentColor String? @map("accent_color")
  hashtag     String?

  startsAt DateTime @map("starts_at") @db.Timestamptz(6)
  endsAt   DateTime @map("ends_at") @db.Timestamptz(6)

  status            EventStatus @default(draft)
  applicationsOpen  Boolean     @default(false) @map("applications_open")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  participations EventParticipation[]
  elements       EventElement[]
  commandes      SalesOrder[]
  rappels        EventReminder[]
  bilans         EventReport[]
  promotions     Promotion[]

  @@index([status, startsAt])
  @@map("event")
}

model EventParticipation {
  id String @id @default(uuid(7)) @db.Uuid

  event   Event  @relation(fields: [eventId], references: [id], onDelete: Restrict)
  eventId String @map("event_id") @db.Uuid

  participant   User   @relation("participant", fields: [participantId], references: [id], onDelete: Restrict)
  participantId String @map("participant_id") @db.Uuid

  role            ParticipationRole
  status          ParticipationStatus @default(candidate)
  /// Un refus sans motif est un défaut, pas une simplification.
  rejectionReason String?             @map("rejection_reason")

  decidedBy   User?   @relation("decideur_participation", fields: [decidedById], references: [id], onDelete: Restrict)
  decidedById String? @map("decided_by_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  elements EventElement[]

  @@unique([eventId, participantId])
  @@map("event_participation")
}

/// Ce qu'un participant expose dans un événement — un article, une promotion,
/// un contenu ou un direct.
///
/// **Polymorphe, et c'est assumé** : quatre types de cibles pour une même page.
/// L'intégrité référentielle est applicative. L'alternative — quatre tables de
/// liaison — donnerait l'intégrité en base mais quatre requêtes pour composer
/// la page, sur un réseau lent.
model EventElement {
  event   Event  @relation(fields: [eventId], references: [id], onDelete: Restrict)
  eventId String @map("event_id") @db.Uuid

  targetType String @map("target_type")
  targetId   String @map("target_id") @db.Uuid

  participation   EventParticipation? @relation(fields: [participationId], references: [id], onDelete: SetNull)
  participationId String?             @map("participation_id") @db.Uuid

  position Int @default(0)

  @@id([eventId, targetType, targetId])
  @@index([targetType, targetId])
  @@map("event_element")
}

/// « Prévenez-moi. » Le compteur porte le plafond de 3 notifications (R-W9) :
/// au-delà, le rappel devient du harcèlement et on perd la personne.
model EventReminder {
  event   Event  @relation(fields: [eventId], references: [id], onDelete: Restrict)
  eventId String @map("event_id") @db.Uuid

  user   User   @relation(fields: [userId], references: [id], onDelete: Restrict)
  userId String @map("user_id") @db.Uuid

  notificationsSent Int @default(0) @map("notifications_sent")

  @@id([eventId, userId])
  @@map("event_reminder")
}

/// `participantId` à `NULL` = le bilan global de l'événement.
model EventReport {
  id String @id @default(uuid(7)) @db.Uuid

  event   Event  @relation(fields: [eventId], references: [id], onDelete: Restrict)
  eventId String @map("event_id") @db.Uuid

  participantId String? @map("participant_id") @db.Uuid

  articlesSoldCount     Int @default(0) @map("articles_sold_count")
  revenueAriary         Int @default(0) @map("revenue_ariary")
  /// La période équivalente hors événement. Sans elle, un chiffre d'affaires
  /// ne dit pas si l'événement a servi à quelque chose.
  referenceRevenueAriary Int @default(0) @map("reference_revenue_ariary")
  newFollowers          Int @default(0) @map("new_followers")
  pageTraffic           Int @default(0) @map("page_traffic")

  computedAt DateTime @default(now()) @map("computed_at") @db.Timestamptz(6)

  @@unique([eventId, participantId])
  @@map("event_report")
}

// ─────────────────────────────────────────────────────────────────────────
// Fidélité — les paliers, et les promotions (F7.6, F7.22)
// ─────────────────────────────────────────────────────────────────────────

model LoyaltyTier {
  id String @id @default(uuid(7)) @db.Uuid

  shop       Shop @relation(fields: [shopId], references: [id], onDelete: Restrict)
  shopId String   @map("shop_id") @db.Uuid

  name      String
  rankOrder Int    @map("rank_order")

  amountThreshold Int @default(0) @map("amount_threshold")
  ordersThreshold Int @default(0) @map("orders_threshold")

  benefitText String? @map("benefit_text")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  promotionsReservees Promotion[]  @relation("palier_min")
  rangsClient         CustomerRank[]

  @@unique([shopId, rankOrder])
  @@map("loyalty_tier")
}

model Promotion {
  id String @id @default(uuid(7)) @db.Uuid

  shop       Shop @relation(fields: [shopId], references: [id], onDelete: Restrict)
  shopId String   @map("shop_id") @db.Uuid

  event   Event?  @relation(fields: [eventId], references: [id], onDelete: SetNull)
  eventId String? @map("event_id") @db.Uuid

  type  PromotionType
  /// `CHECK > 0`. Une remise de zéro n'est pas une remise.
  value Int

  scope      PromotionScope @default(shop)
  categoryId String?        @map("category_id") @db.Uuid

  audience  PromotionAudience @default(everyone)
  minTier   LoyaltyTier?      @relation("palier_min", fields: [minTierId], references: [id], onDelete: SetNull)
  minTierId String?           @map("min_tier_id") @db.Uuid

  code String? @unique

  usageCap   Int? @map("usage_cap")
  usageCount Int  @default(0) @map("usage_count")

  startsAt DateTime @map("starts_at") @db.Timestamptz(6)
  endsAt   DateTime @map("ends_at") @db.Timestamptz(6)

  status          PromotionStatus @default(draft)
  notifyFollowers Boolean         @default(false) @map("notify_followers")
  /// **Un verrou d'idempotence, pas une donnée d'affichage** (R-U3). Après un
  /// incident du planificateur, la promotion démarre en retard mais **ne
  /// renotifie jamais**.
  notifiedAt      DateTime?       @map("notified_at") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  articles       PromotionArticle[]
  beneficiaires  PromotionBeneficiary[]
  lignesRemisees OrderLine[]

  @@index([shopId, status, startsAt])
  @@map("promotion")
}

model PromotionArticle {
  promotion   Promotion @relation(fields: [promotionId], references: [id], onDelete: Restrict)
  promotionId String    @map("promotion_id") @db.Uuid

  articleId String @map("article_id") @db.Uuid

  @@id([promotionId, articleId])
  @@map("promotion_article")
}

// ─────────────────────────────────────────────────────────────────────────
// Réservation — la table la plus sensible du schéma (RB1)
// ─────────────────────────────────────────────────────────────────────────

/// Tenir un article pendant que l'acheteuse paie.
///
/// **Trois éléments la protègent** : le verrou `FOR UPDATE` sur `variante` dans
/// la transaction, les `CHECK` de `variante`, et l'index partiel qui rend
/// l'expiration bon marché — sans lui, la tâche d'expiration balaierait toute
/// la table toutes les minutes.
model Reservation {
  id String @id @default(uuid(7)) @db.Uuid

  variant   Variant @relation(fields: [variantId], references: [id], onDelete: Restrict)
  variantId String  @map("variant_id") @db.Uuid

  /// `NULL` pour une session invitée : on peut réserver avant d'avoir un
  /// compte, sinon la création de compte s'intercale au pire moment.
  user           User?   @relation(fields: [userId], references: [id], onDelete: Restrict)
  userId         String? @map("user_id") @db.Uuid
  guestSessionId String? @map("guest_session_id") @db.Uuid

  quantity Int @default(1)

  status ReservationStatus @default(active)
  origin SaleOrigin        @default(catalogue)

  direct   LiveStream? @relation(fields: [directId], references: [id], onDelete: SetNull)
  directId String? @map("live_stream_id") @db.Uuid

  /// Le rang dans la file d'attente (R-S7). Quand une réservation expire, c'est
  /// le suivant qui est prévenu — pas tout le monde en même temps.
  rank Int @default(0)

  expiresAt       DateTime  @map("expires_at") @db.Timestamptz(6)
  /// Suspension pendant un incident réseau (R-S5) : le temps ne court plus.
  suspendedSince  DateTime? @map("suspended_since") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([variantId, status])
  @@index([userId, status])
  @@map("reservation")
}

// ─────────────────────────────────────────────────────────────────────────
// Livraison — zones et tarifs (F3.3). JP n'opère rien (DP-04)
// ─────────────────────────────────────────────────────────────────────────

model DeliveryZone {
  id String @id @default(uuid(7)) @db.Uuid

  name          String
  neighborhoods Json
  transitDays   Int    @default(1) @map("transit_days")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  rates DeliveryRate[]

  @@map("delivery_zone")
}

/// **Le tarif est fixé par la boutique** (`DP-04`), pas par JP. Clé primaire
/// composite : un tarif par boutique et par zone, sans doublon possible.
model DeliveryRate {
  shop       Shop @relation(fields: [shopId], references: [id], onDelete: Restrict)
  shopId String   @map("shop_id") @db.Uuid

  zone   DeliveryZone @relation(fields: [zoneId], references: [id], onDelete: Restrict)
  zoneId String       @map("zone_id") @db.Uuid

  amount Int

  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@id([shopId, zoneId])
  @@map("delivery_rate")
}

// ─────────────────────────────────────────────────────────────────────────
// SalesOrder — l'engagement écrit, figé (F3.7)
// ─────────────────────────────────────────────────────────────────────────

/// **Tout y est figé.** Prix, taux de commission, part créatrice, code promo :
/// recopiés à la création, jamais relus depuis leur source. Un changement de
/// tarif ne réécrit pas une facture émise.
model SalesOrder {
  id     String @id @default(uuid(7)) @db.Uuid
  /// Lisible et prononçable : on le donne au téléphone.
  numero String @unique

  buyer   User   @relation("acheteur", fields: [buyerId], references: [id], onDelete: Restrict)
  buyerId String @map("buyer_id") @db.Uuid

  /// L'attribution d'affiliation (R-N1), figée elle aussi.
  attributedCreator   User?   @relation("createur_attribue", fields: [attributedCreatorId], references: [id], onDelete: Restrict)
  attributedCreatorId String? @map("attributed_creator_id") @db.Uuid

  evenement   Event? @relation(fields: [eventId], references: [id], onDelete: SetNull)
  eventId String?    @map("event_id") @db.Uuid

  direct   LiveStream? @relation(fields: [directId], references: [id], onDelete: SetNull)
  directId String? @map("live_stream_id") @db.Uuid

  /// La commande cadeau (RB8). **Une référence, pas une clé étrangère** : le
  /// donateur ne doit jamais pouvoir remonter à l'adresse de livraison.
  donorRef String? @map("donor_ref")

  status OrderStatus @default(draft)
  /// **Une file de commandes unique** (R-H2) : deux files signifieraient deux
  /// logistiques, et la boutique en oublierait une.
  origin SaleOrigin  @default(catalogue)

  /// Figé (R-Y3) : changer l'univers changerait les règles de litige et la
  /// commission après coup.
  universeKey String @map("universe_key")

  deliveryMode DeliveryMode @default(home) @map("delivery_mode")
  adresse      Address?     @relation(fields: [addressId], references: [id], onDelete: Restrict)
  addressId    String?      @map("address_id") @db.Uuid

  /// Figé à la commande (R-U9) : le code, pas la promotion. Si elle est
  /// modifiée demain, la commande garde ce qui a été promis aujourd'hui.
  promoCode String? @map("promo_code")

  /// **Entiers en Ariary** (D6).
  subtotal          Int @map("subtotal")
  shippingFee       Int @default(0) @map("shipping_fee")
  discount          Int @default(0)
  shippingDiscount  Int @default(0) @map("shipping_discount")
  walletCreditUsed  Int @default(0) @map("wallet_credit_used")
  total             Int

  buyerNote String? @map("buyer_note")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  lignes              OrderLine[]
  paiements           Payment[]
  facture             Invoice?
  expedition          Shipment?
  filRemise           HandoverThread?
  promotionsUtilisees PromotionBeneficiary[]
  signalements        OrderDispute[]
  avis                Review?
  contenusUnboxing    Content[]
  venteConfirmee      ConfirmedSaleLog?
  engagements         PreorderCommitment[]
  piecesDressing      WardrobeItem[]
  panierCadeau        GiftCart?

  @@index([buyerId, createdAt])
  @@index([origin, createdAt])
  @@index([status, createdAt])
  @@map("sales_order")
}

model OrderLine {
  id String @id @default(uuid(7)) @db.Uuid

  order   SalesOrder @relation(fields: [orderId], references: [id], onDelete: Restrict)
  orderId String     @map("order_id") @db.Uuid

  variant   Variant @relation(fields: [variantId], references: [id], onDelete: Restrict)
  variantId String  @map("variant_id") @db.Uuid

  shop       Shop @relation(fields: [shopId], references: [id], onDelete: Restrict)
  shopId String   @map("shop_id") @db.Uuid

  quantity     Int
  /// **FIGÉ à la commande.**
  unitPrice    Int @map("unit_price")
  /// `CHECK <= unit_price * quantity`.
  lineDiscount Int @default(0) @map("line_discount")

  /// **SCALAIRE, et c'est la décision de modélisation la plus importante du
  /// domaine commercial** (D4, R-U7) : une ligne porte AU PLUS une promotion.
  /// Le cumul devient impossible par la forme de la table, pas par un contrôle
  /// que quelqu'un oubliera d'écrire.
  promotion   Promotion? @relation(fields: [promotionId], references: [id], onDelete: Restrict)
  promotionId String?    @map("promotion_id") @db.Uuid

  /// Figées à la commande (`DP-09`, R-G3, `DP-15`, R-B5).
  creatorShare       Int              @default(0) @map("creator_share")
  commissionPerMille Int              @default(0) @map("commission_per_mille")
  paymentTermsMode   PaymentTermsMode @default(commission) @map("payment_terms_mode")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([orderId])
  @@index([shopId, createdAt])
  @@map("order_line")
}

/// Le code nominatif à usage unique (R-U6).
model PromotionBeneficiary {
  promotion   Promotion @relation(fields: [promotionId], references: [id], onDelete: Restrict)
  promotionId String    @map("promotion_id") @db.Uuid

  user   User   @relation(fields: [userId], references: [id], onDelete: Restrict)
  userId String @map("user_id") @db.Uuid

  personalCode String    @unique @map("personal_code")
  usedAt       DateTime? @map("used_at") @db.Timestamptz(6)

  order   SalesOrder? @relation(fields: [orderId], references: [id], onDelete: SetNull)
  orderId String?     @map("order_id") @db.Uuid

  @@id([promotionId, userId])
  @@map("promotion_beneficiary")
}

// ─────────────────────────────────────────────────────────────────────────
// Payment et argent — JP ne détient aucun fonds (DP-07, DP-16)
// ─────────────────────────────────────────────────────────────────────────

/// Un crédit vers un bénéficiaire. **1 à 3 par commande** (`DP-16`) : la
/// boutique, la commission JP, la créatrice.
///
/// L'acheteuse ne voit rien de cet éclatement — un débit, une confirmation.
model Payment {
  id String @id @default(uuid(7)) @db.Uuid

  order   SalesOrder @relation(fields: [orderId], references: [id], onDelete: Restrict)
  orderId String     @map("order_id") @db.Uuid

  rank PaymentRank @default(pivot)

  beneficiaryType BeneficiaryType @map("beneficiary_type")
  beneficiaryId   String?         @map("beneficiary_id") @db.Uuid

  /// **Figé, jamais saisissable** (`DP-16`). Le numéro vient de la boutique
  /// vérifiée ; le laisser saisir à la volée serait la faille la plus simple à
  /// exploiter de tout le produit.
  destinationMsisdn String @map("destination_msisdn")

  method PaymentMethod
  /// `CHECK > 0`.
  amount Int
  status PaymentStatus @default(initiated)

  externalReference String? @map("external_reference")
  /// Porte RB10 : un rejeu renvoie le résultat initial sans nouveau
  /// prélèvement (R-M2).
  idempotencyKey    String  @unique @map("idempotency_key")
  failureReason     String? @map("failure_reason")

  retryCount   Int       @default(0) @map("retry_count")
  nextRetryAt  DateTime? @map("next_retry_at") @db.Timestamptz(6)

  /// La diaspora paie depuis l'étranger : on garde ce qu'elle a réellement vu.
  payerUserId           String?  @map("payer_user_id") @db.Uuid
  payerCountry          String?  @map("payer_country")
  amountSourceCurrency  Int?     @map("amount_source_currency")
  sourceCurrency        String?  @map("source_currency")
  indicativeRate        Decimal? @map("indicative_rate") @db.Decimal(12, 6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  ecritures LedgerEntry[]

  @@index([orderId, rank])
  @@map("payment")
}

/// **Le cœur de la conformité** (C4). AJOUT SEUL, garanti par `REVOKE` dans la
/// migration — Prisma ne sait pas l'exprimer.
///
/// JP ne détient aucun fonds (`DP-07`) : ce journal ne tient pas un solde, il
/// trace un mouvement qui a eu lieu ailleurs. C'est ce qu'on fournit quand le
/// recours est externe.
model LedgerEntry {
  id String @id @default(uuid(7)) @db.Uuid

  payment   Payment? @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  paymentId String?  @map("payment_id") @db.Uuid

  type      String
  reference String?
  amount    Int
  direction LedgerDirection
  account   LedgerAccount

  holderId String? @map("holder_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([holderId, account, createdAt])
  @@map("ledger_entry")
}

/// `emiseLe` est **inaltérable** (R-F1). La numérotation est continue : un trou
/// dans une série de factures est un problème comptable, pas un détail.
model Invoice {
  id String @id @default(uuid(7)) @db.Uuid

  order   SalesOrder @relation(fields: [orderId], references: [id], onDelete: Restrict)
  orderId String     @unique @map("order_id") @db.Uuid

  number   String   @unique
  pdfUrl   String?  @map("pdf_url")
  issuedAt DateTime @default(now()) @map("issued_at") @db.Timestamptz(6)

  @@map("invoice")
}

// ─────────────────────────────────────────────────────────────────────────
// Expédition — ce que la boutique déclare (DP-04, R-L9)
// ─────────────────────────────────────────────────────────────────────────

/// ⚠️ **`EXPEDIEE` est une déclaration que personne ne vérifie** (R-L9). Aucun
/// tiers neutre ne constate la remise : ni preuve, ni arbitre (`DP-05`), ni
/// argent retenu (`DP-07`). C'est un invariant que ce modèle **ne peut pas**
/// garantir, et qu'il ne faut donc pas supposer ailleurs.
model Shipment {
  id String @id @default(uuid(7)) @db.Uuid

  order   SalesOrder @relation(fields: [orderId], references: [id], onDelete: Restrict)
  orderId String     @unique @map("order_id") @db.Uuid

  shop       Shop @relation(fields: [shopId], references: [id], onDelete: Restrict)
  shopId String   @map("shop_id") @db.Uuid

  status          ShipmentStatus @default(preparing)
  /// `coursier`, `transporteur`, `main propre` — **non vérifié**.
  declaredMethod  String?        @map("declared_method")
  /// Figé à la création : savoir après coup si le numéro était vérifié change
  /// la lecture d'un litige.
  verifiedPhone   Boolean        @default(false) @map("verified_phone")

  attemptCount  Int     @default(0) @map("attempt_count")
  failureReason String? @map("failure_reason")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  events ShipmentEvent[]

  @@index([shopId, status])
  @@map("shipment")
}

/// **Porte l'auteur de chaque transition.** L'arbitrage a disparu (`DP-05`) —
/// la trace reste, et c'est elle qu'on fournit quand le recours est externe.
model ShipmentEvent {
  id String @id @default(uuid(7)) @db.Uuid

  shipment   Shipment @relation(fields: [shipmentId], references: [id], onDelete: Restrict)
  shipmentId String   @map("shipment_id") @db.Uuid

  status ShipmentStatus

  author   User?   @relation(fields: [authorId], references: [id], onDelete: Restrict)
  authorId String? @map("author_id") @db.Uuid

  occurredAt DateTime @default(now()) @map("occurred_at") @db.Timestamptz(6)
  comment    String?

  @@index([shipmentId, occurredAt])
  @@map("shipment_event")
}

/// La remise d'un cadeau se négocie **entre l'acheteuse ou la bénéficiaire et
/// la boutique — jamais le donateur** (RB8, `DP-10`).
///
/// Il fallait autrefois cacher activement l'adresse au donateur ; désormais il
/// ne la manipule jamais. La règle est devenue structurelle.
model HandoverThread {
  id String @id @default(uuid(7)) @db.Uuid

  order   SalesOrder @relation(fields: [orderId], references: [id], onDelete: Restrict)
  orderId String     @unique @map("order_id") @db.Uuid

  participants    Json
  agreedLocation  String?   @map("agreed_location")
  agreedTime      DateTime? @map("agreed_time") @db.Timestamptz(6)
  /// Débloque le paiement du cadeau (`DP-10`).
  agreedAt        DateTime? @map("agreed_at") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("handover_thread")
}

// ─────────────────────────────────────────────────────────────────────────
// Content — la boutique dont le catalogue est fait de vidéos (F14.5)
// ─────────────────────────────────────────────────────────────────────────

/// **Un contenu publié DOIT porter au moins un article** (R-K1, RB5). C'est la
/// règle d'or du produit : sans elle, le fil devient un réseau social de plus,
/// et plus une boutique.
///
/// Appliquée par transaction **et** par déclencheur de contrainte **différé** —
/// ce qui permet d'insérer le contenu puis ses articles dans le même bloc.
model Content {
  id String @id @default(uuid(7)) @db.Uuid

  author   User   @relation(fields: [authorId], references: [id], onDelete: Restrict)
  authorId String @map("author_id") @db.Uuid

  type          ContentType
  mediaUrl      String       @map("media_url")
  thumbnailUrl  String?      @map("thumbnail_url")
  durationS     Int?         @map("duration_s")

  status ContentStatus @default(draft)

  /// Obligatoire si `type = unboxing` (R-K2) : un déballage sans commande est
  /// une publicité déguisée.
  sourceOrder   SalesOrder? @relation(fields: [sourceOrderId], references: [id], onDelete: Restrict)
  sourceOrderId String?     @map("source_order_id") @db.Uuid

  commentsOpen CommentsOpen @default(everyone) @map("comments_open")

  publishedAt DateTime? @map("published_at") @db.Timestamptz(6)
  /// Une story : +24 h.
  expiresAt   DateTime? @map("expires_at") @db.Timestamptz(6)

  /// Détection de republication (R-X7).
  videoFingerprint String? @map("video_fingerprint")

  /// **L'étiquette de sponsoring est CALCULÉE, jamais saisie** (F18.8) — donc
  /// non retirable par l'autrice. Les identifiants restent scalaires tant que
  /// les tables de monétisation ne sont pas posées.
  partnershipId     String? @map("partnership_id") @db.Uuid
  campaignId        String? @map("campaign_id") @db.Uuid
  declaredSponsored Boolean @default(false) @map("declared_sponsored")

  /// Figé à la publication (RB6). Recalculer l'âge après coup changerait la
  /// légalité d'une publication passée.
  authorAdult Boolean @default(false) @map("author_adult")

  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  articles              ContentArticle[]
  statistique           ContentStatistic?
  interactions          Interaction[]
  hashtags              ContentHashtag[]
  avis                  Review[]
  republications        SuspectedRepost[] @relation("contenu_suspecte")
  republicationsOrigine SuspectedRepost[] @relation("contenu_origine")

  @@index([authorId, publishedAt])
  @@index([status, publishedAt])
  @@map("content")
}

model ContentArticle {
  content   Content @relation(fields: [contentId], references: [id], onDelete: Restrict)
  contentId String  @map("content_id") @db.Uuid

  article   Article @relation(fields: [articleId], references: [id], onDelete: Restrict)
  articleId String  @map("article_id") @db.Uuid

  /// Porte l'affiliation (R-N1) : c'est cette ligne qui dit quelle créatrice a
  /// amené la vente, et donc qui sera payée.
  creatorId String? @map("creator_id") @db.Uuid

  position Int @default(0)

  @@id([contentId, articleId])
  @@map("content_article")
}

/// `earnings` est **le chiffre le plus important** (R-K15) : c'est le seul qui
/// répond à « est-ce que publier m'a rapporté quelque chose ».
model ContentStatistic {
  content   Content @relation(fields: [contentId], references: [id], onDelete: Restrict)
  contentId String  @id @map("content_id") @db.Uuid

  views          Int @default(0)
  avgDurationS   Int @default(0) @map("avg_duration_s")
  articleClicks  Int @default(0) @map("article_clicks")
  takeItClicks   Int @default(0) @map("take_it_clicks")
  sales          Int @default(0)
  earnings       Int @default(0)

  computedAt DateTime @default(now()) @map("computed_at") @db.Timestamptz(6)

  @@map("content_statistic")
}

model Interaction {
  id String @id @default(uuid(7)) @db.Uuid

  content   Content @relation(fields: [contentId], references: [id], onDelete: Restrict)
  contentId String  @map("content_id") @db.Uuid

  user   User   @relation(fields: [userId], references: [id], onDelete: Restrict)
  userId String @map("user_id") @db.Uuid

  type   InteractionType
  text   String?
  status InteractionStatus @default(published)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([contentId, type, createdAt])
  @@index([userId, type])
  @@map("interaction")
}

model Hashtag {
  id   String @id @default(uuid(7)) @db.Uuid
  word String @unique

  contentCount Int @default(0) @map("content_count")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  contenus ContentHashtag[]

  @@map("hashtag")
}

model ContentHashtag {
  content   Content @relation(fields: [contentId], references: [id], onDelete: Restrict)
  contentId String  @map("content_id") @db.Uuid

  hashtag   Hashtag @relation(fields: [hashtagId], references: [id], onDelete: Restrict)
  hashtagId String  @map("hashtag_id") @db.Uuid

  @@id([contentId, hashtagId])
  @@map("content_hashtag")
}

// ─────────────────────────────────────────────────────────────────────────
// Confiance — la SEULE protection de l'acheteuse depuis DP-07
// ─────────────────────────────────────────────────────────────────────────

/// Le signalement de commande — **anciennement `litige`** (`DP-05`).
///
/// Personne n'instruit, personne ne tranche, personne ne s'attribue de dossier :
/// `decision_texte`, `decide_par_id` et `affecte_a_id` ont disparu avec
/// l'arbitrage. Ce qui reste est un compteur public.
///
/// **`compteDansLeScore` est TOUTE la sanction du produit** (R-T8). Il n'y a
/// plus ni séquestre, ni arbitre, ni argent retenu (`DP-07`) : un signalement
/// ouvert pèse sur la réputation, et c'est le seul levier.
model OrderDispute {
  id String @id @default(uuid(7)) @db.Uuid

  order   SalesOrder @relation(fields: [orderId], references: [id], onDelete: Restrict)
  orderId String     @map("order_id") @db.Uuid

  openedBy   User   @relation("ouvreur_signalement", fields: [openedById], references: [id], onDelete: Restrict)
  openedById String @map("opened_by_id") @db.Uuid

  /// **Filtré par univers** : « pas ma taille » n'a aucun sens pour un
  /// téléphone, « batterie morte » aucun pour une robe. D'où l'univers figé ici
  /// plutôt qu'un motif universel qui ne parlerait à personne.
  universeKey String             @map("universe_key")
  reason      DisputeReason
  status      OrderDisputeStatus @default(open)

  /// `CHECK (counts_in_score = (status <> 'resolved'))`. La résolution
  /// décrémente le compteur, et aucun code ne peut les désynchroniser.
  countsInScore Boolean @default(true) @map("counts_in_score")

  resolvedAt DateTime? @map("resolved_at") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  messages DisputeMessage[]

  @@index([orderId])
  @@index([status, createdAt])
  @@map("order_dispute")
}

model DisputeMessage {
  id String @id @default(uuid(7)) @db.Uuid

  dispute   OrderDispute @relation(fields: [disputeId], references: [id], onDelete: Restrict)
  disputeId String       @map("dispute_id") @db.Uuid

  author   User   @relation(fields: [authorId], references: [id], onDelete: Restrict)
  authorId String @map("author_id") @db.Uuid

  text        String
  attachments Json?  @map("attachments")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([disputeId, createdAt])
  @@map("dispute_message")
}

/// Un seul avis par commande. `morphologieAutrice` est **figée au moment de
/// l'avis** (F6.10) : sinon un changement de profil réécrirait le sens d'un
/// avis passé — « taille petit » ne veut rien dire sans savoir pour qui.
model Review {
  id String @id @default(uuid(7)) @db.Uuid

  order   SalesOrder @relation(fields: [orderId], references: [id], onDelete: Restrict)
  orderId String     @unique @map("order_id") @db.Uuid

  author   User   @relation(fields: [authorId], references: [id], onDelete: Restrict)
  authorId String @map("author_id") @db.Uuid

  shop       Shop @relation(fields: [shopId], references: [id], onDelete: Restrict)
  shopId String   @map("shop_id") @db.Uuid

  article   Article? @relation(fields: [articleId], references: [id], onDelete: Restrict)
  articleId String?  @map("article_id") @db.Uuid

  /// `CHECK 1..5`.
  note     Int
  text     String?
  photoUrl String? @map("photo_url")

  sizeFit         SizeFit? @map("size_fit")
  authorBodyShape Json?    @map("author_body_shape")

  /// L'avis né d'un déballage (R-T7).
  content   Content? @relation(fields: [contentId], references: [id], onDelete: SetNull)
  contentId String?  @map("content_id") @db.Uuid

  /// **Une seule fois** (F6.9) : le droit de réponse n'est pas un fil de
  /// discussion.
  replyText String?   @map("reply_text")
  repliedAt DateTime? @map("replied_at") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([shopId, createdAt])
  @@map("review")
}

/// Public, calculé sur des faits. `decomposition` porte la contribution de
/// chaque composante (R-T10) : un score qu'on ne peut pas expliquer à la
/// boutique concernée est un score qu'elle contestera.
model TrustScore {
  shop       Shop @relation(fields: [shopId], references: [id], onDelete: Restrict)
  shopId String   @id @map("shop_id") @db.Uuid

  score                  Decimal @default(0) @db.Decimal(4, 2)
  honoredSalesCount      Int     @default(0) @map("honored_sales_count")
  actualShippingDelayH   Int?    @map("actual_shipping_delay_h")
  cancellationRate       Decimal @default(0) @map("cancellation_rate") @db.Decimal(5, 4)
  disputeRate            Decimal @default(0) @map("dispute_rate") @db.Decimal(5, 4)
  breakdown              Json?

  computedAt DateTime @default(now()) @map("computed_at") @db.Timestamptz(6)

  @@map("trust_score")
}

// ─────────────────────────────────────────────────────────────────────────
// Modération — la protection des personnes (F19.1)
// ─────────────────────────────────────────────────────────────────────────

model Report {
  id String @id @default(uuid(7)) @db.Uuid

  targetType String @map("target_type")
  targetId   String @map("target_id") @db.Uuid

  reportedBy   User   @relation("signaleur", fields: [reportedById], references: [id], onDelete: Restrict)
  reportedById String @map("reported_by_id") @db.Uuid

  reason String
  level  ReportLevel  @default(ordinary)
  status ReportStatus @default(new)

  assignedTo   User?   @relation("affecte_signalement", fields: [assignedToId], references: [id], onDelete: Restrict)
  assignedToId String? @map("assigned_to_id") @db.Uuid

  handledBy   User?   @relation("traiteur_signalement", fields: [handledById], references: [id], onDelete: Restrict)
  handledById String? @map("handled_by_id") @db.Uuid
  decision    String?

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  /// L'urgence en tête de file (R-X4). L'ordre des colonnes de l'index n'est
  /// pas décoratif : c'est lui qui met les menaces devant.
  @@index([level, status, createdAt])
  @@index([targetType, targetId])
  @@map("report")
}

/// `resultatContestation` est **instruit par une autre personne** que celle qui
/// a sanctionné. Une contestation examinée par son propre auteur n'est pas une
/// contestation.
model Sanction {
  id String @id @default(uuid(7)) @db.Uuid

  user   User   @relation("sanctionne", fields: [userId], references: [id], onDelete: Restrict)
  userId String @map("user_id") @db.Uuid

  type        SanctionType
  reasonText  String       @map("reason_text")
  /// En jours. `NULL` = définitive.
  duration    Int?

  appliedBy   User   @relation("applicateur_sanction", fields: [appliedById], references: [id], onDelete: Restrict)
  appliedById String @map("applied_by_id") @db.Uuid

  contested            Boolean @default(false)
  contestationOutcome  String? @map("contestation_outcome")
  investigatedById     String? @map("investigated_by_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([userId, createdAt])
  @@map("sanction")
}

/// Bloquer quelqu'un. `IDX(bloque_id)` sert le sens inverse : « qui m'a
/// bloqué » doit être aussi rapide que « qui j'ai bloqué », sinon le filtrage
/// du fil coûte un balayage complet.
model UserBlock {
  blocker   User   @relation("bloqueur", fields: [blockerId], references: [id], onDelete: Restrict)
  blockerId String @map("blocker_id") @db.Uuid

  blocked   User   @relation("bloque", fields: [blockedId], references: [id], onDelete: Restrict)
  blockedId String @map("blocked_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@id([blockerId, blockedId])
  @@index([blockedId])
  @@map("user_block")
}

/// Les mots qu'une personne ne veut plus voir dans ses commentaires. Personnel
/// et non global : la liste noire de l'une n'est pas celle de l'autre.
model BlockedWord {
  user   User   @relation(fields: [userId], references: [id], onDelete: Restrict)
  userId String @map("user_id") @db.Uuid

  word String

  @@id([userId, word])
  @@map("blocked_word")
}

model SuspectedRepost {
  id String @id @default(uuid(7)) @db.Uuid

  content   Content @relation("contenu_suspecte", fields: [contentId], references: [id], onDelete: Restrict)
  contentId String  @map("content_id") @db.Uuid

  originalContent   Content @relation("contenu_origine", fields: [originalContentId], references: [id], onDelete: Restrict)
  originalContentId String  @map("original_content_id") @db.Uuid

  similarity Decimal      @db.Decimal(5, 4)
  status     RepostStatus @default(to_review)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([status, similarity])
  @@map("suspected_repost")
}

// ─────────────────────────────────────────────────────────────────────────
// Créatrices — vendre sans capital (F15.4, F15.8)
// ─────────────────────────────────────────────────────────────────────────

/// Une sélection thématique composée par une créatrice à partir d'articles
/// qu'elle ne possède pas.
model Selection {
  id String @id @default(uuid(7)) @db.Uuid

  creator   CreatorProfile @relation(fields: [creatorId], references: [id], onDelete: Restrict)
  creatorId String         @map("creator_id") @db.Uuid

  themeName String @map("theme_name")
  position  Int    @default(0)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  articles SelectionArticle[]

  @@index([creatorId, position])
  @@map("selection")
}

model SelectionArticle {
  selection   Selection @relation(fields: [selectionId], references: [id], onDelete: Restrict)
  selectionId String    @map("selection_id") @db.Uuid

  article   Article @relation(fields: [articleId], references: [id], onDelete: Restrict)
  articleId String  @map("article_id") @db.Uuid

  position Int @default(0)

  @@id([selectionId, articleId])
  @@map("selection_article")
}

/// La fenêtre d'attribution (R-N2). `expireLe` est ce qui décide si une vente
/// revient à la créatrice : sans date, l'attribution serait éternelle et la
/// boutique paierait une commission pour un clic d'il y a six mois.
model AffiliateClick {
  id String @id @default(uuid(7)) @db.Uuid

  creator   CreatorProfile @relation(fields: [creatorId], references: [id], onDelete: Restrict)
  creatorId String         @map("creator_id") @db.Uuid

  article   Article @relation(fields: [articleId], references: [id], onDelete: Restrict)
  articleId String  @map("article_id") @db.Uuid

  user   User?   @relation(fields: [userId], references: [id], onDelete: Restrict)
  userId String? @map("user_id") @db.Uuid

  expiresAt DateTime @map("expires_at") @db.Timestamptz(6)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([userId, articleId, expiresAt])
  @@map("affiliate_click")
}

/// La précommande porte RB3 : on ne garde pas indéfiniment l'argent de gens qui
/// attendent. `dateExpeditionMax` est la promesse ; la dépasser rembourse.
model Preorder {
  id String @id @default(uuid(7)) @db.Uuid

  article   Article @relation(fields: [articleId], references: [id], onDelete: Restrict)
  articleId String  @unique @map("article_id") @db.Uuid

  organizer   CreatorProfile @relation(fields: [organizerId], references: [id], onDelete: Restrict)
  organizerId String         @map("organizer_id") @db.Uuid

  /// `CHECK > 0` — une précommande sans seuil est une vente ordinaire.
  threshold    Int
  deadline     DateTime @map("deadline") @db.Timestamptz(6)
  currentCount Int      @default(0) @map("current_count")

  status PreorderStatus @default(open)

  /// Paramétré (R-N9) : la part libérée avant livraison, pour que la créatrice
  /// puisse produire.
  releasedAdvance  Int      @default(0) @map("released_advance")
  maxShippingDate  DateTime @map("max_shipping_date") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  engagements PreorderCommitment[]

  @@map("preorder")
}

model PreorderCommitment {
  id String @id @default(uuid(7)) @db.Uuid

  preorder   Preorder @relation(fields: [preorderId], references: [id], onDelete: Restrict)
  preorderId String   @map("preorder_id") @db.Uuid

  order   SalesOrder @relation(fields: [orderId], references: [id], onDelete: Restrict)
  orderId String     @unique @map("order_id") @db.Uuid

  status CommitmentStatus @default(committed)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([preorderId, status])
  @@map("preorder_commitment")
}

// ─────────────────────────────────────────────────────────────────────────
// Fidélité, cagnotte et dressing (F7.18, F7.6)
// ─────────────────────────────────────────────────────────────────────────

/// **Doit exister dès la phase 1**, même si la fidélisation n'est activée qu'en
/// phase 2 (R-R11). Sans elle, il faudra reconstituer l'historique à la main —
/// ou effacer la fidélité des premières clientes, qui sont précisément les plus
/// fidèles.
///
/// `UNIQUE(commande_id)` rend le rattrapage **idempotent** : on peut rejouer le
/// journal sur tout l'historique sans compter deux fois.
model ConfirmedSaleLog {
  id String @id @default(uuid(7)) @db.Uuid

  shop       Shop @relation(fields: [shopId], references: [id], onDelete: Restrict)
  shopId String   @map("shop_id") @db.Uuid

  user   User   @relation(fields: [userId], references: [id], onDelete: Restrict)
  userId String @map("user_id") @db.Uuid

  order   SalesOrder @relation(fields: [orderId], references: [id], onDelete: Restrict)
  orderId String     @unique @map("order_id") @db.Uuid

  confirmedAmount Int      @map("confirmed_amount")
  confirmedAt     DateTime @default(now()) @map("confirmed_at") @db.Timestamptz(6)

  @@index([shopId, userId])
  @@map("confirmed_sale_log")
}

model CustomerRank {
  id String @id @default(uuid(7)) @db.Uuid

  shop       Shop @relation(fields: [shopId], references: [id], onDelete: Restrict)
  shopId String   @map("shop_id") @db.Uuid

  user   User   @relation(fields: [userId], references: [id], onDelete: Restrict)
  userId String @map("user_id") @db.Uuid

  tier   LoyaltyTier? @relation(fields: [tierId], references: [id], onDelete: SetNull)
  tierId String?      @map("tier_id") @db.Uuid

  score        Int @default(0)
  totalAmount  Int @default(0) @map("total_amount")
  orderCount   Int @default(0) @map("order_count")

  lastOrderAt         DateTime? @map("last_order_at") @db.Timestamptz(6)
  lostDisputesCount   Int       @default(0) @map("lost_disputes_count")
  cancellationsCount  Int       @default(0) @map("cancellations_count")

  computedAt DateTime @default(now()) @map("computed_at") @db.Timestamptz(6)

  @@unique([shopId, userId])
  @@index([shopId, score])
  @@index([shopId, lastOrderAt])
  @@map("customer_rank")
}

/// **Jamais visible du client.** C'est une note interne de boutique ; la rendre
/// visible transformerait un outil de suivi en insulte publique.
model CustomerNote {
  shop       Shop @relation(fields: [shopId], references: [id], onDelete: Restrict)
  shopId String   @map("shop_id") @db.Uuid

  user   User   @relation(fields: [userId], references: [id], onDelete: Restrict)
  userId String @map("user_id") @db.Uuid

  text String

  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@id([shopId, userId])
  @@map("customer_note")
}

/// `solde` est **dérivé** des mouvements. Il est stocké pour l'affichage, et un
/// test le recalcule par relecture du journal : un solde qu'on ne sait pas
/// reconstituer est un solde qu'on ne peut pas défendre.
model Wallet {
  user   User   @relation(fields: [userId], references: [id], onDelete: Restrict)
  userId String @id @map("user_id") @db.Uuid

  solde Int @default(0)

  majLe DateTime @default(now()) @updatedAt @map("maj_le") @db.Timestamptz(6)

  @@map("wallet")
}

model WalletMovement {
  id String @id @default(uuid(7)) @db.Uuid

  user   User   @relation(fields: [userId], references: [id], onDelete: Restrict)
  userId String @map("user_id") @db.Uuid

  type      WalletMovementType
  montant   Int
  /// Unique **partiellement** pour `credit_unboxing` : on ne crédite pas deux
  /// fois le même déballage, même si la tâche est rejouée.
  reference String?

  creeLe DateTime @default(now()) @map("cree_le") @db.Timestamptz(6)

  @@index([userId, creeLe])
  @@map("wallet_movement")
}

/// La garde-robe. `articleId` **rend la pièce achetable dans un look** : c'est
/// ce qui relie le dressing au catalogue au lieu d'en faire un album photo.
model WardrobeItem {
  id String @id @default(uuid(7)) @db.Uuid

  user   User   @relation(fields: [userId], references: [id], onDelete: Restrict)
  userId String @map("user_id") @db.Uuid

  origine WardrobeItemOrigin @default(manual)

  commande   SalesOrder? @relation(fields: [commandeId], references: [id], onDelete: Restrict)
  commandeId String?   @map("sales_order_id") @db.Uuid

  article   Article? @relation(fields: [articleId], references: [id], onDelete: Restrict)
  articleId String?  @map("article_id") @db.Uuid

  photoUrl  String? @map("photo_url")
  categorie String?

  creeLe DateTime @default(now()) @map("cree_le") @db.Timestamptz(6)

  looks LookPiece[]

  @@index([userId, categorie])
  @@map("wardrobe_item")
}

model Look {
  id String @id @default(uuid(7)) @db.Uuid

  user   User   @relation(fields: [userId], references: [id], onDelete: Restrict)
  userId String @map("user_id") @db.Uuid

  nom       String
  contenuId String? @map("content_id") @db.Uuid

  creeLe DateTime @default(now()) @map("cree_le") @db.Timestamptz(6)

  pieces LookPiece[]

  @@index([userId])
  @@map("look")
}

model LookPiece {
  look   Look   @relation(fields: [lookId], references: [id], onDelete: Restrict)
  lookId String @map("look_id") @db.Uuid

  piece   WardrobeItem @relation(fields: [pieceId], references: [id], onDelete: Restrict)
  pieceId String        @map("piece_id") @db.Uuid

  /// La position dans la composition visuelle.
  position Json?

  @@id([lookId, pieceId])
  @@map("look_piece")
}

// ─────────────────────────────────────────────────────────────────────────
// Cadeau — le canal diaspora (F16.1)
// ─────────────────────────────────────────────────────────────────────────

/// Un panier composé par l'une, payé par un autre. **Le donateur ne voit jamais
/// l'adresse** (RB8) : elle se négocie dans `fil_remise`, dont il ne fait pas
/// partie.
model GiftCart {
  id String @id @default(uuid(7)) @db.Uuid

  compositrice   User   @relation("compositrice", fields: [compositriceId], references: [id], onDelete: Restrict)
  compositriceId String @map("compositrice_id") @db.Uuid

  commande   SalesOrder? @relation(fields: [commandeId], references: [id], onDelete: Restrict)
  commandeId String?   @unique @map("sales_order_id") @db.Uuid

  lienPartage String             @unique @map("lien_partage")
  statut      GiftCartStatus @default(composed)
  message     String?

  expireLe DateTime @map("expire_le") @db.Timestamptz(6)
  creeLe   DateTime @default(now()) @map("cree_le") @db.Timestamptz(6)

  @@index([statut, expireLe])
  @@map("gift_cart")
}

// ─────────────────────────────────────────────────────────────────────────
// Monétisation — le modèle économique (F10.3, DP-08)
// ─────────────────────────────────────────────────────────────────────────

/// L'abonnement d'une boutique. Les quotas sont **dans la ligne**, pas dans le
/// code : c'est ce qui permet d'ajuster un palier pendant le pilote sans
/// déploiement, et de faire une exception nominative sans forker le code.
model ShopSubscription {
  id String @id @default(uuid(7)) @db.Uuid

  shop       Shop @relation(fields: [shopId], references: [id], onDelete: Restrict)
  shopId String   @map("shop_id") @db.Uuid

  tier   SubscriptionTier       @default(free)
  status ShopSubscriptionStatus @default(active)

  /// Portent R-B4. `NULL` = illimité.
  salesQuota      Int? @map("sales_quota")
  liveStreamQuota Int? @map("live_stream_quota")

  /// **Entier en Ariary** (D6). Zéro pour le palier gratuit.
  amount Int @default(0)

  startsAt    DateTime  @default(now()) @map("starts_at") @db.Timestamptz(6)
  dueAt       DateTime  @map("due_at") @db.Timestamptz(6)
  cancelledAt DateTime? @map("cancelled_at") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([shopId, status])
  @@index([status, dueAt])
  @@map("shop_subscription")
}

/// JP Club, côté acheteuse : livraison offerte au-dessus d'un seuil.
model ClubMembership {
  user   User   @relation(fields: [userId], references: [id], onDelete: Restrict)
  userId String @id @map("user_id") @db.Uuid

  amount                Int
  freeShippingThreshold Int      @map("free_shipping_threshold")
  startsAt              DateTime @default(now()) @map("starts_at") @db.Timestamptz(6)
  dueAt                 DateTime @map("due_at") @db.Timestamptz(6)
  autoRenew             Boolean  @default(false) @map("auto_renew")

  @@index([dueAt])
  @@map("club_membership")
}

/// Emplacements payés. **La mention « Sponsorisé » est obligatoire** — c'est
/// une règle de loyauté, pas une préférence d'affichage.
model Featured {
  id String @id @default(uuid(7)) @db.Uuid

  shop       Shop @relation(fields: [shopId], references: [id], onDelete: Restrict)
  shopId String   @map("shop_id") @db.Uuid

  type       FeaturedType
  targetType String       @map("target_type")
  targetId   String       @map("target_id") @db.Uuid

  amount   Int
  startsAt DateTime @map("starts_at") @db.Timestamptz(6)
  endsAt   DateTime @map("ends_at") @db.Timestamptz(6)

  impressions Int @default(0)
  clicks      Int @default(0)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([type, startsAt, endsAt])
  @@map("featured")
}

/// Liens courts et attribution — **le canal d'acquisition principal.** Un
/// partage WhatsApp qu'on ne sait pas attribuer est un budget qu'on ne sait pas
/// juger.
model ShareLink {
  id   String @id @default(uuid(7)) @db.Uuid
  code String @unique

  creator   User?   @relation(fields: [creatorId], references: [id], onDelete: Restrict)
  creatorId String? @map("creator_id") @db.Uuid

  targetType String  @map("target_type")
  targetId   String  @map("target_id") @db.Uuid
  channel    String?

  clicks  Int @default(0)
  signups Int @default(0)
  orders  Int @default(0)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([targetType, targetId])
  @@map("share_link")
}

/// Conversion **indicative**. `constateLe` existe pour qu'aucun taux périmé ne
/// soit affiché sans mention : un taux sans date est une promesse implicite.
model ExchangeRate {
  id String @id @default(uuid(7)) @db.Uuid

  devise     String
  versAriary Decimal @map("vers_ariary") @db.Decimal(14, 6)

  constateLe DateTime @default(now()) @map("constate_le") @db.Timestamptz(6)

  @@index([devise, constateLe])
  @@map("exchange_rate")
}

// ─────────────────────────────────────────────────────────────────────────
// Exploitation — notifications, réconciliation, mesures
// ─────────────────────────────────────────────────────────────────────────

model Notification {
  id String @id @default(uuid(7)) @db.Uuid

  recipient   User   @relation(fields: [recipientId], references: [id], onDelete: Restrict)
  recipientId String @map("recipient_id") @db.Uuid

  type    String
  channel NotificationChannel
  status  NotificationStatus @default(pending)

  title String
  body  String
  data  Json?

  senderId String? @map("sender_id") @db.Uuid

  sentAt    DateTime? @map("sent_at") @db.Timestamptz(6)
  readAt    DateTime? @map("read_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([recipientId, createdAt])
  @@index([status, createdAt])
  @@map("notification")
}

/// **Les plafonds** (R-U4, R-W9). La clé primaire porte le jour : le compteur
/// se remet à zéro par le simple fait de changer de date, sans tâche de purge
/// et sans fenêtre glissante à recalculer.
model NotificationCounter {
  user   User   @relation(fields: [userId], references: [id], onDelete: Restrict)
  userId String @map("user_id") @db.Uuid

  senderId String   @map("sender_id") @db.Uuid
  type     String
  day      DateTime @db.Date

  count Int @default(0)

  @@id([userId, senderId, type, day])
  @@map("notification_counter")
}

/// Réglages par type. **Les notifications critiques ne sont pas
/// désactivables** — une commande payée, un litige ouvert : couper ces
/// messages-là nuirait à la personne qui les coupe.
model NotificationPreference {
  user   User   @relation(fields: [userId], references: [id], onDelete: Restrict)
  userId String @map("user_id") @db.Uuid

  type    String
  channel NotificationChannel

  enabled Boolean @default(true)

  @@id([userId, type, channel])
  @@map("notification_preference")
}

/// Les SMS **et leur coût** : c'est une ligne de dépense à suivre, pas un
/// détail technique. Un produit qui notifie trop se ruine sans le voir.
model NotificationSms {
  id String @id @default(uuid(7)) @db.Uuid

  notificationId String? @map("notification_id") @db.Uuid
  msisdn         String
  operator       String?

  status     NotificationStatus @default(pending)
  costAriary Int                @default(0) @map("cost_ariary")
  reference  String?

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([createdAt])
  @@map("notification_sms")
}

/// Rapprochement **encaissements opérateurs ↔ commandes** (R-O3).
model Reconciliation {
  id String @id @default(uuid(7)) @db.Uuid

  operateur String
  periodeLe DateTime @map("periode_le") @db.Date

  nbLignes         Int @default(0) @map("nb_lignes")
  montantOperateur Int @default(0) @map("montant_operateur")
  montantJp        Int @default(0) @map("montant_jp")

  closeLe DateTime? @map("close_le") @db.Timestamptz(6)
  creeLe  DateTime  @default(now()) @map("cree_le") @db.Timestamptz(6)

  ecarts Discrepancy[]

  @@unique([operateur, periodeLe])
  @@map("reconciliation")
}

/// Un écart se résout **par une écriture inverse**, jamais par une correction
/// de l'écriture d'origine : `ecriture_financiere` est en ajout seul.
model Discrepancy {
  id String @id @default(uuid(7)) @db.Uuid

  reconciliation   Reconciliation @relation(fields: [reconciliationId], references: [id], onDelete: Restrict)
  reconciliationId String         @map("reconciliation_id") @db.Uuid

  referenceExterne String? @map("reference_externe")
  paiementId       String? @map("paiement_id") @db.Uuid

  montantEcart Int         @map("montant_ecart")
  statut       DiscrepancyStatus @default(open)
  commentaire  String?

  ecritureCorrectiveId String?   @map("ecriture_corrective_id") @db.Uuid
  resoluLe             DateTime? @map("resolu_le") @db.Timestamptz(6)

  creeLe DateTime @default(now()) @map("cree_le") @db.Timestamptz(6)

  @@index([statut, creeLe])
  @@map("discrepancy")
}

/// Événements d'usage bruts. **Rétention 90 jours**, puis agrégés : garder le
/// détail indéfiniment coûte cher et ne sert plus au bout d'un trimestre.
model UsageEvent {
  id String @id @default(uuid(7)) @db.Uuid

  nom        String
  userId     String? @map("user_id") @db.Uuid
  sessionId  String? @map("session_id") @db.Uuid
  proprietes Json?

  horodatage DateTime @default(now()) @db.Timestamptz(6)

  @@index([nom, horodatage])
  @@index([horodatage])
  @@map("usage_event")
}

/// **Les quatre mesures fondatrices** (F11.7), précalculées. Une page de
/// pilotage qui recalcule tout à chaque ouverture n'est pas consultée.
model DailyAggregate {
  jour DateTime @id @db.Date

  visiteurs       Int @default(0)
  inscriptions    Int @default(0)
  commandesPayees Int @default(0) @map("commandes_payees")
  caAriary        Int @default(0) @map("ca_ariary")

  calculeLe DateTime @default(now()) @map("calcule_le") @db.Timestamptz(6)

  @@map("daily_aggregate")
}

/// Statistiques de boutique par jour **et par origine** : sans l'origine, on ne
/// sait pas si c'est le direct ou le catalogue qui vend, donc où investir.
model ShopAggregate {
  shop       Shop @relation(fields: [shopId], references: [id], onDelete: Restrict)
  shopId String   @map("shop_id") @db.Uuid

  jour    DateTime     @db.Date
  origine SaleOrigin

  vues            Int @default(0)
  reservations    Int @default(0)
  commandesPayees Int @default(0) @map("commandes_payees")
  caAriary        Int @default(0) @map("ca_ariary")

  calculeLe DateTime @default(now()) @map("calcule_le") @db.Timestamptz(6)

  @@id([shopId, jour, origine])
  @@map("shop_aggregate")
}

/// ♻️ **Rétablie** (`DP-15`). Le taux en pour mille, **historisé**.
///
/// Jamais d'`UPDATE` : une nouvelle version à chaque changement. C'est ce qui
/// permet à une commande de garder son taux (R-G3) — le barème dit ce qui
/// s'appliquait à une date, il ne dit pas ce qui s'applique aujourd'hui.
model CommissionSchedule {
  id String @id @default(uuid(7)) @db.Uuid

  universeKey String           @map("universe_key")
  tier        SubscriptionTier @default(free)

  /// En pour mille. 80 = 8 % (D6).
  ratePerMille Int @map("rate_per_mille")

  /// La version en vigueur est celle dont `endsAt` est `NULL`.
  startsAt DateTime  @default(now()) @map("starts_at") @db.Timestamptz(6)
  endsAt   DateTime? @map("ends_at") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([universeKey, tier, startsAt])
  @@map("commission_schedule")
}
