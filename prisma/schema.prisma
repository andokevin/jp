generator client {
  provider = "prisma-client"
  output   = "../apps/api/src/genere/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────────────────────────────────────
// Énumérés
// ─────────────────────────────────────────────────────────────────────────

/// Anglais, français et malgache — la liste doit rester identique à `LANGUES`
/// de `@jp/i18n`, qui en est la source. Le français est le défaut : c'est la
/// langue écrite courante à Madagascar, et celle qui produit les libellés les
/// plus longs — donc celle qui contraint les maquettes.
enum Language {
  en
  fr
  // Le malgache. Retiré par `20260819182525_langues` à l'époque où `@jp/i18n`
  // n'en déclarait que deux ; réintroduit ici parce que le paquet en déclare
  // trois et que le parcours d'authentification est livré en malgache. Sans
  // cette valeur, l'inscription d'une malgachophone échoue à l'`INSERT` —
  // exactement la population visée.
  mg

  @@map("language")
}

/// Facultatif. `NULL` signifie « non renseigné », ce qui n'est PAS `autre` :
/// `autre` est un choix exprimé, `NULL` est l'absence de choix. Confondre les
/// deux ferait compter comme « autre » tous ceux qui ont sauté la question.
enum Gender {
  female
  male
  other

  @@map("gender")
}

/// Le verrou de la mise en vente (`DP-07`). Une boutique non vérifiée existe,
/// mais ne publie rien : l'argent partant directement à la boutique, vérifier
/// APRÈS la vente n'aurait plus aucun sens.
enum StatutPanier {
  actif
  valide
  abandonne

  @@map("statut_panier")
}

/// Ce que la boutique publie AVANT le direct : un extrait des articles, une
/// publicité, ou une annonce (« il y aura une surprise »). Trois intentions
/// différentes, un même objet vidéo — d'où un énuméré plutôt que trois tables.
enum TypeExtrait {
  extrait
  publicite
  annonce

  @@map("type_extrait")
}

enum ExternalProvider {
  facebook
  google

  @@map("external_provider")
}

/// Le cycle d'une demande instruite par un humain du back-office.
enum EtatDemande {
  en_attente
  en_cours
  acceptee
  refusee

  @@map("etat_demande")
}

enum EmailChangeStep {
  old_verified
  completed

  @@map("email_change_step")
}

/// Qui fait quoi dans une boutique à plusieurs mains.
enum TeamRole {
  owner
  manager
  fulfiller

  @@map("team_role")
}

/// **Un seul moteur de réservation pour tous les canaux** (R-H1). `origine`
/// change la valeur d'`expire_le` à la création (R-H3), et rien d'autre. Un
/// second chemin de réservation serait un défaut d'architecture.
/// **Le modèle économique** (`DP-08`). Le palier gratuit doit rester
/// fonctionnel (R-B3) : une boutique qui ne peut rien vendre sans payer ne
/// s'inscrit pas, et le pilote n'apprend rien.
/// ⚠️ Montants non arrêtés (`PO-6`).
enum PalierAbonnement {
  gratuit
  essentiel
  pro
  premium

  @@map("palier_abonnement")
}

enum StatutAbonnementBoutique {
